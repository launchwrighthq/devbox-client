#!/bin/bash
# devbox-steps: run the steps of one gate by their graph, in the workspace, or
# on this machine for `devbox verify --local`.
# docs/specs/2026-11-14-client-owns-the-gate-design.md section 6.3 holds the
# design. docs/specs/2026-11-14-learned-selection-design.md section 5.6 holds
# the plan format, the trace files and this program's output, section 5.3 the
# trace of a step command and section 7 the worker count.
#
# Environment:
#   DEVBOX_STEPS_PLAN    the plan file (learned-selection spec, section 5.6),
#                        required
#   DEVBOX_STEPS_LOGS    the directory of the step logs, <name>.log, required;
#                        the traces of a run go under its trace/<name>/
#   DEVBOX_LEDGER        the ledger of the resumable-gates spec, section 3.3;
#                        unset, no ledger line is written
#   DEVBOX_RESUME        1 skips a step whose last ledger record is `pass`, and
#                        gives a runner step only its files not yet passed
#   DEVBOX_LEDGER_TOOLS  the directory of vitest-ledger.mjs, ledger-core.mjs,
#                        devbox_ledger.py and devbox-trace-hook.mjs; required
#                        when DEVBOX_LEDGER is set and the plan holds a runner
#                        step
#   DEVBOX_TOKENS        the grant; unset on a laptop and in CI, where the
#                        cores of nproc stand for it; also the most runner
#                        steps that run at once
#   DEVBOX_WORKER_MEMORY the memory one test worker needs, 1536M by default
#   DEVBOX_STEP_MEMORY   the memory a step without a runner reserves, 2G by
#                        default (docs/specs/2026-11-16-step-memory-budget-design.md)
#   DEVBOX_CGROUP_ROOT   the cgroup v2 directory of this workspace, whose
#                        memory.max caps the workers and sets the memory
#                        budget of the steps, and under which a cgroup=nested
#                        step gets devbox/<name>; /sys/fs/cgroup by default
#   DEVBOX_PROC_CGROUP   the file a cgroup=nested step reads its own cgroup
#                        from; /proc/self/cgroup by default
#   DEVBOX_MEMINFO       the meminfo file read when no cgroup file holds a
#                        limit; /proc/meminfo by default
# The project directory is the current directory.
#
# Exit status: 0 when no step failed, 1 when one did, 2 for a refused plan or
# environment before any step starts, or a ledger or a log that cannot be
# written once steps run, 143 after SIGTERM and 130 after SIGINT.
#
# stdout: one line when a step starts, ends, carries or resumes, one line the
# first time the grant holds runner steps back, one line the first time the
# memory budget holds a step back, one
# `devbox-steps: untraced <name> <reason>` line for a step whose trace cannot
# run, the batch lines of a streamed step whose files run in batches, one
# `devbox-steps: <name> left its cgroup <dir>` line for a cgroup=nested step
# whose cgroup could not be removed, then a
# summary table, the full log of each failed step after
# `== <name>: <log path>`, the `devbox-steps: trace <name> <seq> <chunk>` lines
# of each traced step, and last one `devbox-steps: result <name>
# <pass|fail|resumed|carried> <seconds> <code>` line per step, in plan order.
set -euo pipefail

if [ "${BASH_VERSINFO[0]}" -lt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 3 ]; }; then
  echo "devbox-steps: needs bash 4.3 or later for wait -n, and this is bash $BASH_VERSION" >&2
  exit 2
fi

die() { echo "devbox-steps: $*" >&2; exit 2; }
plan_die() { echo "devbox-steps: plan line $1: $2" >&2; exit 2; }

[ -n "${DEVBOX_STEPS_PLAN-}" ] || die "DEVBOX_STEPS_PLAN names no plan file"
[ -f "$DEVBOX_STEPS_PLAN" ] || die "the plan file $DEVBOX_STEPS_PLAN does not exist"
[ -n "${DEVBOX_STEPS_LOGS-}" ] || die "DEVBOX_STEPS_LOGS names no log directory"
mkdir -p "$DEVBOX_STEPS_LOGS" || die "cannot create the log directory $DEVBOX_STEPS_LOGS"
LEDGER="${DEVBOX_LEDGER-}"
RESUME="${DEVBOX_RESUME-0}"
VITEST_DIR=node_modules/.devbox-ledger

# ── the plan ─────────────────────────────────────────────────────────────────

NAMES=()
declare -A MODE=() RUNNER=() AFTER=() CMD=() LINE=() FILES=() TESTS=() DIR=() TRACE=() MEM=() NESTED=()

n=0
while IFS= read -r line || [ -n "$line" ]; do
  n=$((n + 1))
  # read -a with a tab IFS folds two tabs into one, so an empty field would
  # shift the next one into its place: the tab count is checked first.
  tabs="${line//[!$'\t']/}"
  fields=()
  IFS=$'\t' read -r -a fields <<<"$line"
  case "${fields[0]-}" in
    step)
      if [ "${#tabs}" -ne 8 ] || [ "${#fields[@]}" -ne 9 ]; then
        plan_die "$n" "a step line has 9 non-empty fields separated by one tab"
      fi
      name="${fields[1]}"
      [[ "$name" =~ ^[a-z0-9][a-z0-9:_-]*$ ]] || plan_die "$n" "the step name $(printf '%q' "$name") is not [a-z0-9][a-z0-9:_-]*"
      [ -z "${MODE[$name]+x}" ] || plan_die "$n" "the step $name is planned twice"
      case "${fields[2]}" in run | carry | narrow | select) ;; *) plan_die "$n" "the plan of $name is $(printf '%q' "${fields[2]}"), not run, carry, narrow or select" ;; esac
      case "${fields[4]}" in vitest | pytest | -) ;; *) plan_die "$n" "the runner of $name is $(printf '%q' "${fields[4]}"), not vitest, pytest or -" ;; esac
      case "${fields[2]}" in narrow | select) [ "${fields[4]}" != - ] || plan_die "$n" "the ${fields[2]} step $name names no runner" ;; esac
      # The decode runs in this shell, so a command that is not base64 stops
      # the plan here rather than running as an empty string. base64's own
      # message names no plan line, and plan_die does.
      cmd="$(printf '%s' "${fields[6]}" | base64 -d 2>/dev/null)" || plan_die "$n" "the command of $name is not base64"
      [ -n "$cmd" ] || plan_die "$n" "the command of $name is empty"
      dir="${fields[7]}"
      if [ "$dir" != - ]; then
        # The folder joins the project directory as a prefix of every file the
        # runner passes, so an absolute path or a .. would run the step, and
        # map its files, outside the synced tree.
        [ "${dir%/}" != "$dir" ] || plan_die "$n" "the dir of $name, $(printf '%q' "$dir"), does not end in /"
        case "/$dir" in
          //* | *//* | */./* | */../*) plan_die "$n" "the dir of $name, $(printf '%q' "$dir"), is not a relative folder without . or .." ;;
        esac
        [ -d "$dir" ] || plan_die "$n" "the dir of $name, $(printf '%q' "$dir"), is not a folder of $PWD"
      fi
      case "${fields[8]}" in 0 | 1) ;; *) plan_die "$n" "the trace of $name is $(printf '%q' "${fields[8]}"), not 0 or 1" ;; esac
      NAMES+=("$name")
      MODE[$name]="${fields[2]}"
      RUNNER[$name]="${fields[4]}"
      AFTER[$name]=""
      [ "${fields[5]}" = - ] || AFTER[$name]="${fields[5]//,/ }"
      CMD[$name]="$cmd"
      LINE[$name]="$n"
      FILES[$name]=""
      TESTS[$name]=""
      DIR[$name]=""
      [ "$dir" = - ] || DIR[$name]="$dir"
      TRACE[$name]="${fields[8]}"
      ;;
    file | test)
      kind="${fields[0]}"
      if [ "${#tabs}" -ne 2 ] || [ "${#fields[@]}" -ne 3 ]; then
        plan_die "$n" "a $kind line has 3 non-empty fields separated by one tab"
      fi
      name="${fields[1]}" path="${fields[2]}"
      [ -n "${MODE[$name]+x}" ] || plan_die "$n" "a $kind line names $(printf '%q' "$name"), which no step line above it plans"
      if [ "$kind" = file ]; then
        case "${MODE[$name]}" in narrow | select) ;; *) plan_die "$n" "a file line names $name, whose plan is ${MODE[$name]}, not narrow or select" ;; esac
      else
        [ "${RUNNER[$name]}" != - ] || plan_die "$n" "a test line names $name, which names no runner"
      fi
      # A runner reads a word that starts with - as one of its options, so the
      # file would become a flag of the test run instead of its filter.
      [ "${path#-}" = "$path" ] || plan_die "$n" "the file $(printf '%q' "$path") starts with -, which $name's runner would read as an option"
      # A dir= step's runner gets each file relative to its folder, and a file
      # outside that folder has no such name.
      if [ -n "${DIR[$name]}" ] && [ "${path#"${DIR[$name]}"}" = "$path" ]; then
        plan_die "$n" "the file $(printf '%q' "$path") is outside ${DIR[$name]}, the dir of $name"
      fi
      if [ "$kind" = file ]; then FILES[$name]+="$path"$'\n'; else TESTS[$name]+="$path"$'\n'; fi
      ;;
    memory)
      # The memory= of .devbox/steps as bytes (step-memory-budget spec, D4):
      # one worker of a runner step, or the reservation of a step without one.
      if [ "${#tabs}" -ne 2 ] || [ "${#fields[@]}" -ne 3 ]; then
        plan_die "$n" "a memory line has 3 non-empty fields separated by one tab"
      fi
      name="${fields[1]}"
      [ -n "${MODE[$name]+x}" ] || plan_die "$n" "a memory line names $(printf '%q' "$name"), which no step line above it plans"
      [ -z "${MEM[$name]+x}" ] || plan_die "$n" "the memory of $name is given twice"
      [[ "${fields[2]}" =~ ^[1-9][0-9]{0,17}$ ]] || plan_die "$n" "the memory of $name is $(printf '%q' "${fields[2]}"), not a byte count"
      MEM[$name]="${fields[2]}"
      ;;
    cgroup)
      # The cgroup= of .devbox/steps. `nested` is its one value.
      if [ "${#tabs}" -ne 2 ] || [ "${#fields[@]}" -ne 3 ]; then
        plan_die "$n" "a cgroup line has 3 non-empty fields separated by one tab"
      fi
      name="${fields[1]}"
      [ -n "${MODE[$name]+x}" ] || plan_die "$n" "a cgroup line names $(printf '%q' "$name"), which no step line above it plans"
      [ -z "${NESTED[$name]+x}" ] || plan_die "$n" "the cgroup of $name is given twice"
      [ "${fields[2]}" = nested ] || plan_die "$n" "the cgroup of $name is $(printf '%q' "${fields[2]}"), not nested"
      NESTED[$name]=1
      ;;
    *) plan_die "$n" "a line starts with step, file, test, memory or cgroup, and this one starts with $(printf '%q' "${fields[0]-}")" ;;
  esac
done <"$DEVBOX_STEPS_PLAN"
[ "${#NAMES[@]}" -gt 0 ] || die "the plan $DEVBOX_STEPS_PLAN holds no step"

for name in "${NAMES[@]}"; do
  case "${MODE[$name]}" in
    narrow | select)
      # A narrow or a select step with no file would run the whole suite
      # under a plan that says it ran a part.
      [ -n "${FILES[$name]}" ] || plan_die "${LINE[$name]}" "the ${MODE[$name]} step $name has no file line"
      ;;
  esac
  for dep in ${AFTER[$name]}; do
    [ "$dep" != "$name" ] || plan_die "${LINE[$name]}" "the step $name runs after itself"
    [ -n "${MODE[$dep]+x}" ] || plan_die "${LINE[$name]}" "the step $name runs after $(printf '%q' "$dep"), which the plan does not hold"
  done
done

# A cycle in the after edges leaves steps that never start, and the loop below
# would wait on nothing: the graph is walked once here, before anything runs.
declare -A SEEN=()
progress=1
while [ "$progress" = 1 ]; do
  progress=0
  for name in "${NAMES[@]}"; do
    [ -z "${SEEN[$name]+x}" ] || continue
    ready=1
    for dep in ${AFTER[$name]}; do [ -n "${SEEN[$dep]+x}" ] || ready=0; done
    [ "$ready" = 0 ] || { SEEN[$name]=1; progress=1; }
  done
done
for name in "${NAMES[@]}"; do
  [ -n "${SEEN[$name]+x}" ] || plan_die "${LINE[$name]}" "the step $name is part of a cycle of after edges"
done

# ── the ledger ───────────────────────────────────────────────────────────────

# One printf of the whole line, in append mode, so that the lines this program
# and the plug-ins of parallel steps write interleave whole and never as
# fragments of two records. devbox-ledger writes the same `step` lines.
ledger_step() {
  [ -n "$LEDGER" ] || return 0
  local line
  printf -v line 'step\t%s\t%s' "$1" "$2"
  [ "$#" -lt 3 ] || line+=$'\t'"$3"
  printf '%s\n' "$line" >>"$LEDGER" || fatal "cannot append to the ledger $LEDGER"
}

# The LAST record of a step decides, as devbox-ledger and the plug-ins decide
# for their units: a `start` after a `pass` means a later run began the step
# and did not finish it.
declare -A LEDGER_PASSED=() LEDGER_FAILED=()
if [ -n "$LEDGER" ] && [ "$RESUME" = 1 ] && [ -f "$LEDGER" ]; then
  while IFS=$'\t' read -r state name; do
    case "$state" in
      pass) LEDGER_PASSED[$name]=1 ;;
      fail) LEDGER_FAILED[$name]=1 ;;
    esac
  done < <(awk -F '\t' '$1 == "step" { last[$2] = $3 } END { for (s in last) print last[s] "\t" s }' "$LEDGER")
fi

[ -z "$LEDGER" ] || { : >>"$LEDGER"; } 2>/dev/null || die "cannot append to the ledger $LEDGER"

# The files of each runner whose LAST ledger record is `pass`, as
# passedFiles() of ledger-core.mjs and devbox_ledger.py read them: a `start`
# after a `pass` means a later run began the file and did not finish it. And
# the files this gate owes again: those whose last record is `fail`, or
# `start`, a file the stop left open.
declare -A PASSED_FILES=() OWED_FILES=()
if [ -n "$LEDGER" ] && [ "$RESUME" = 1 ] && [ -f "$LEDGER" ]; then
  for r in vitest pytest; do
    PASSED_FILES[$r]="$(RUNNER_NAME="$r" awk -F '\t' '
      $1 == "file" && $2 == ENVIRON["RUNNER_NAME"] && NF >= 4 { last[$3] = $4 }
      END { for (f in last) if (last[f] == "pass") print f }' "$LEDGER")" || die "cannot read the ledger $LEDGER"
    OWED_FILES[$r]="$(RUNNER_NAME="$r" awk -F '\t' '
      $1 == "file" && $2 == ENVIRON["RUNNER_NAME"] && NF >= 4 { last[$3] = $4 }
      END { for (f in last) if (last[f] == "fail" || last[f] == "start") print f }' "$LEDGER")" \
      || die "cannot read the ledger $LEDGER"
  done
fi

# The files each runner step is given, repository-relative, one per line
# (section 5.6, D7). A narrow or a select step runs its file lines. A run step
# on a resume runs its test lines less the files that passed, so a project's
# own `exclude` cannot hide the client's choice: a vitest 2 release ignored an
# `--exclude` from the command line in a project that set its own, and ran
# every passed file again. A step that is given no list runs its whole suite.
#
# A resume owes what this gate's own ledger left (gate-fixes-4.0.1 spec, D1).
# MEASURED: a stopped gate's vitest step failed two files, and the plan of its
# resume narrowed the step to the failed files of another branch's newer
# record. Every file on that list had passed in this gate, so the step resumed
# as passed, and the gate read green while its own two failed files never ran
# again. So on a resume a narrow step, whose list stands on an earlier gate's
# result, runs its test lines; a select step, whose other files its map
# proves, keeps its list; and each adds every file of its own lines that this
# gate failed or left open. A step whose ledger says it failed never resumes
# as passed.
RESUMING=0
[ "$RESUME" != 1 ] || [ -z "$LEDGER" ] || RESUMING=1
declare -A RUNLIST=() HASLIST=() RESUMED_ALL=()
for name in "${NAMES[@]}"; do
  [ "${RUNNER[$name]}" != - ] || continue
  [ "${MODE[$name]}" != carry ] || continue
  [ -z "${LEDGER_PASSED[$name]+x}" ] || continue
  base=""
  case "${MODE[$name]}" in
    select) base="${FILES[$name]}" ;;
    narrow) if [ "$RESUMING" = 1 ]; then base="${TESTS[$name]}"; else base="${FILES[$name]}"; fi ;;
    run) [ "$RESUMING" = 0 ] || base="${TESTS[$name]}" ;;
  esac
  [ -n "$base" ] || continue
  if [ -n "${OWED_FILES[${RUNNER[$name]}]-}" ]; then
    # The owed files join in the order of the step's own lines, so one ledger
    # gives one command line.
    base="$(awk '
      phase == "base" { if ($0 != "") { have[$0] = 1; print }; next }
      phase == "owed" { if ($0 != "") owed[$0] = 1; next }
      $0 != "" && ($0 in owed) && !($0 in have) { have[$0] = 1; print }' \
      phase=base <(printf '%s' "$base") phase=owed <(printf '%s\n' "${OWED_FILES[${RUNNER[$name]}]}") \
      phase=own <(printf '%s%s' "${TESTS[$name]}" "${FILES[$name]}"))"$'\n' || die "cannot add the owed files of $name"
  fi
  list="$base"
  if [ -n "${PASSED_FILES[${RUNNER[$name]}]-}" ]; then
    list="$(awk 'NR == FNR { passed[$0] = 1; next } !($0 in passed)' \
      <(printf '%s\n' "${PASSED_FILES[${RUNNER[$name]}]}") <(printf '%s' "$base"))" || die "cannot subtract the passed files of $name"
    [ -z "$list" ] || list+=$'\n'
  fi
  # A step that failed while every file it runs passed failed outside those
  # files, so it runs them all again.
  [ -n "$list" ] || [ -z "${LEDGER_FAILED[$name]+x}" ] || list="$base"
  HASLIST[$name]=1
  RUNLIST[$name]="$list"
  # Every file this step would run passed in an earlier run of this gate. An
  # empty list would reach the runner as no file filter at all, and run the
  # whole suite.
  [ -n "$list" ] || RESUMED_ALL[$name]=1
done

# The trace of each step with `trace 1` (section 5.3 and 5.6). A step that
# cannot be traced runs as it ran before traces, untraced, and one line names
# the reason: the plan then keeps the step's earlier inputs or every synced
# file, so a trace that cannot run never carries a step.
declare -A TRACED=() UNTRACED=()

# -y prints the path of each file descriptor, AT_FDCWD's included, so a path
# relative to a directory descriptor or to the cwd resolves without a second
# pass. getdents64 is how a directory is listed, fchdir and clone carry the
# cwd from a process to its children, and `?` lets a syscall this architecture
# does not have pass.
STRACE_SET='%file,getdents64,?getdents,fchdir,clone,?clone3,?fork,?vfork'
STRACE_OPTS=()
STRACE_OK="" STRACE_WHY=""
strace_probe() {
  local err
  [ -z "$STRACE_OK" ] || return 0
  if ! command -v strace >/dev/null 2>&1; then
    STRACE_OK=0 STRACE_WHY="strace is not installed"
    return 0
  fi
  # --seccomp-bpf stops the tracee only at the traced syscalls. Without it
  # every syscall stops, and a type check ran more than twice as long
  # under strace as without it (MEASURED in section 14,
  # P3). An strace or a kernel without seccomp filters refuses the option, and
  # the plain form is the next best.
  for bpf in --seccomp-bpf ""; do
    STRACE_OPTS=(-f -qq -y ${bpf:+"$bpf"} -e "trace=$STRACE_SET")
    if err="$(strace "${STRACE_OPTS[@]}" -o /dev/null true 2>&1)"; then
      STRACE_OK=1
      return 0
    fi
  done
  # A container whose seccomp profile or capabilities forbid ptrace makes
  # strace exit 1 before it runs the command, so the step itself would fail.
  STRACE_OK=0 STRACE_WHY="strace cannot attach: $(printf '%s' "$err" | tail -1)"
}
need_vitest=0 need_pytest=0
for name in "${NAMES[@]}"; do
  [ "${MODE[$name]}" != carry ] || continue
  [ -z "${LEDGER_PASSED[$name]+x}" ] || continue
  [ -z "${RESUMED_ALL[$name]+x}" ] || continue
  if [ "${TRACE[$name]}" = 1 ]; then
    case "${RUNNER[$name]}" in
      -)
        strace_probe
        if [ "$STRACE_OK" = 1 ]; then TRACED[$name]=1; else UNTRACED[$name]="$STRACE_WHY"; fi
        ;;
      vitest | pytest)
        why=""
        if [ -z "${DEVBOX_LEDGER_TOOLS-}" ]; then
          why="DEVBOX_LEDGER_TOOLS names no directory"
        else
          tools="devbox_ledger.py"
          [ "${RUNNER[$name]}" = pytest ] || tools="vitest-ledger.mjs ledger-core.mjs devbox-trace-hook.mjs"
          for f in $tools; do
            [ -f "$DEVBOX_LEDGER_TOOLS/$f" ] || { why="DEVBOX_LEDGER_TOOLS holds no $f"; break; }
          done
        fi
        if [ -z "$why" ]; then TRACED[$name]=1; else UNTRACED[$name]="$why"; fi
        ;;
    esac
  fi
  if [ -n "$LEDGER" ] || [ -n "${TRACED[$name]+x}" ]; then
    case "${RUNNER[$name]}" in vitest) need_vitest=1 ;; pytest) need_pytest=1 ;; esac
  fi
done

if [ "$need_vitest" = 1 ] || [ "$need_pytest" = 1 ]; then
  [ -n "${DEVBOX_LEDGER_TOOLS-}" ] || die "DEVBOX_LEDGER is set and a runner step runs, but DEVBOX_LEDGER_TOOLS names no directory"
fi
if [ "$need_pytest" = 1 ]; then
  [ -f "$DEVBOX_LEDGER_TOOLS/devbox_ledger.py" ] || die "DEVBOX_LEDGER_TOOLS holds no devbox_ledger.py, so a pytest step would write no file line"
fi
if [ "$need_vitest" = 1 ]; then
  # vitest 3 refuses a reporter path outside the project folder, so the
  # reporter is copied into it (resumable-gates spec, section 4.2). It imports
  # ./ledger-core.mjs, so both files land side by side. The copy happens once,
  # before any step, so two vitest steps never read a half-written file. A
  # dir= step's vitest root is its folder, so its copy goes under that folder.
  for f in vitest-ledger.mjs ledger-core.mjs; do
    [ -f "$DEVBOX_LEDGER_TOOLS/$f" ] || die "DEVBOX_LEDGER_TOOLS holds no $f, so a vitest step would write no file line"
  done
  declare -A COPIED=()
  for name in "${NAMES[@]}"; do
    [ "${RUNNER[$name]}" = vitest ] || continue
    dest="${DIR[$name]}$VITEST_DIR"
    [ -z "${COPIED[$dest]+x}" ] || continue
    COPIED[$dest]=1
    mkdir -p "$dest" || die "cannot create $PWD/$dest for the vitest reporter"
    cp "$DEVBOX_LEDGER_TOOLS/vitest-ledger.mjs" "$DEVBOX_LEDGER_TOOLS/ledger-core.mjs" "$dest/" \
      || die "cannot copy the vitest reporter into $PWD/$dest"
  done
fi

# ── the steps ────────────────────────────────────────────────────────────────

STATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/devbox-steps.XXXXXX")" || die "mktemp -d failed"
trap 'rm -rf "$STATE_DIR"' EXIT

declare -A STATUS=() PID=() SECS=() CODE=() OUTCOME=()
for name in "${NAMES[@]}"; do STATUS[$name]=pending; done

log_of() { printf '%s/%s.log' "$DEVBOX_STEPS_LOGS" "$1"; }
stamp() { printf '[%d s]' "$SECONDS"; }

trace_dir_of() { printf '%s/trace/%s' "$DEVBOX_STEPS_LOGS" "$1"; }

# ── workers (section 7) ──────────────────────────────────────────────────────
#
# A container shows every core of its host, so a runner that sizes its pool
# from the cores it sees starts one worker per host core on a grant of a few
# tokens: consumers pinned vitest to the granted cores with taskset because
# tests that pass on a laptop timed out at 5 s on a devbox. The worker count is
# the step's share of the grant, capped by the workspace's memory and by the
# number of files the step runs.

# The bytes of a size such as 1536M, 2G or 1048576, or a refusal.
size_bytes() {
  local num="${1%[KkMmGg]}" unit
  unit="${1#"$num"}"
  [[ "$num" =~ ^[0-9]+$ ]] || return 1
  case "$unit" in
    "") printf '%s\n' "$num" ;;
    [Kk]) printf '%s\n' "$((num * 1024))" ;;
    [Mm]) printf '%s\n' "$((num * 1048576))" ;;
    [Gg]) printf '%s\n' "$((num * 1073741824))" ;;
  esac
}

if [ -n "${DEVBOX_TOKENS-}" ]; then
  [[ "$DEVBOX_TOKENS" =~ ^[1-9][0-9]*$ ]] || die "DEVBOX_TOKENS is $(printf '%q' "$DEVBOX_TOKENS"), not a token count"
  TOKENS="$DEVBOX_TOKENS"
else
  TOKENS="$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN)" || die "neither nproc nor getconf names this machine's cores, and DEVBOX_TOKENS is unset"
fi
if ! WORKER_MEMORY="$(size_bytes "${DEVBOX_WORKER_MEMORY:-1536M}")" || [ "$WORKER_MEMORY" -eq 0 ]; then
  die "DEVBOX_WORKER_MEMORY is $(printf '%q' "${DEVBOX_WORKER_MEMORY-}"), not a size such as 1536M"
fi
# The workspace's own limit, then the machine's memory. `max` in memory.max
# means no limit, and the soft limit memory.high is the next best figure.
MEMORY_MAX=""
for f in memory.max memory.high; do
  v=""
  # An absent file is a host without cgroup v2 or without that controller, the
  # case the meminfo fallback below covers.
  [ ! -r "${DEVBOX_CGROUP_ROOT:-/sys/fs/cgroup}/$f" ] || read -r v <"${DEVBOX_CGROUP_ROOT:-/sys/fs/cgroup}/$f" || v=""
  if [[ "$v" =~ ^[0-9]+$ ]]; then MEMORY_MAX="$v"; break; fi
done
MEMINFO="${DEVBOX_MEMINFO:-/proc/meminfo}"
if [ -z "$MEMORY_MAX" ] && [ -r "$MEMINFO" ]; then
  v="$(awk '$1 == "MemTotal:" { print $2 * 1024; exit }' "$MEMINFO")" || v=""
  [[ "$v" =~ ^[0-9]+$ ]] && MEMORY_MAX="$v"
fi
if ! STEP_MEMORY="$(size_bytes "${DEVBOX_STEP_MEMORY:-2G}")" || [ "$STEP_MEMORY" -eq 0 ]; then
  die "DEVBOX_STEP_MEMORY is $(printf '%q' "${DEVBOX_STEP_MEMORY-}"), not a size such as 2G"
fi
# The memory budget of the steps that run at once, the workspace limit less
# 4 GiB for the shell, the services and the page cache (step-memory-budget
# spec, D1). Empty on a machine whose memory cannot be read, which then holds
# no step by memory.
BUDGET=""
if [ -n "$MEMORY_MAX" ]; then
  BUDGET=$((MEMORY_MAX - 4 * 1073741824))
  [ "$BUDGET" -ge 0 ] || BUDGET=0
fi

# The number of files each runner step runs: its list, or its test lines.
declare -A FILE_COUNT=()
for name in "${NAMES[@]}"; do
  files=""
  if [ -n "${HASLIST[$name]+x}" ]; then files="${RUNLIST[$name]}"; else files="${TESTS[$name]}"; fi
  FILE_COUNT[$name]=0
  [ -z "$files" ] || FILE_COUNT[$name]="$(printf '%s' "$files" | awk 'END { print NR }')"
done

# The memory one worker of runner step $1 needs: its memory=, else
# DEVBOX_WORKER_MEMORY.
worker_memory() { printf '%s\n' "${MEM[$1]:-$WORKER_MEMORY}"; }

# What step $1 reserves of the budget while it runs with $2 workers (D2): its
# workers times their memory, or for a step without a runner its memory=, else
# DEVBOX_STEP_MEMORY.
step_reservation() {
  if [ "${RUNNER[$1]}" = - ]; then
    printf '%s\n' "${MEM[$1]:-$STEP_MEMORY}"
  else
    printf '%s\n' "$(($2 * $(worker_memory "$1")))"
  fi
}

# Bytes as GiB with one decimal, for the progress lines. LC_ALL=C, because
# under a locale with a decimal comma awk printed 12,0G.
gib() { LC_ALL=C awk -v b="$1" 'BEGIN { printf "%.1fG", b / 1073741824 }'; }

# step_workers <name> <runner steps that run at the same time>: the fair
# share of a runner step. The grant and the memory budget are both split over
# the runner steps that run at once, so a step that starts beside another
# runner step never counts the other one's memory as its own.
step_workers() {
  local name="$1" runners="$2" n cap
  [ "$runners" -gt 0 ] || runners=1
  n=$((TOKENS / runners))
  if [ -n "$BUDGET" ]; then
    cap=$((BUDGET / runners / $(worker_memory "$name")))
    [ "$cap" -ge 1 ] || cap=1
    [ "$n" -le "$cap" ] || n="$cap"
  fi
  [ "${FILE_COUNT[$name]}" = 0 ] || [ "$n" -le "${FILE_COUNT[$name]}" ] || n="${FILE_COUNT[$name]}"
  [ "$n" -ge 1 ] || n=1
  printf '%s\n' "$n"
}

# Whether the command already sets the runner's worker count, which it keeps.
own_workers() {
  local word
  local -a words=()
  read -r -a words <<<"$2"
  for word in "${words[@]}"; do
    case "$1:$word" in
      vitest:--maxWorkers | vitest:--maxWorkers=* | vitest:--pool-options* | vitest:--poolOptions*) return 0 ;;
      pytest:-n | pytest:-n[0-9]* | pytest:-nauto | pytest:-nlogical | pytest:--numprocesses | pytest:--numprocesses=*) return 0 ;;
    esac
  done
  return 1
}

# The major version of the vitest a step in folder $1 resolves, from the
# nearest node_modules/vitest/package.json up to the project root, or nothing.
vitest_major() {
  local d="$1" v
  while :; do
    if [ -r "$d/node_modules/vitest/package.json" ]; then
      v="$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([0-9][0-9]*\)\..*/\1/p' "$d/node_modules/vitest/package.json" | head -n1)"
      printf '%s' "$v"
      return 0
    fi
    [ "$d" = . ] || [ "$d" = ./ ] && return 0
    d="$(dirname -- "$d")"
  done
}

# Whether pytest-xdist loads in the step's own pytest: the command up to its
# pytest word, run with -VV, which lists every plug-in that pytest registers.
# A step whose pytest cannot load xdist would fail on `-n` as an unknown
# option. Prints the words it ran.
pytest_xdist() {
  local word prefix="" out
  local -a words=()
  read -r -a words <<<"$1"
  for word in "${words[@]}"; do
    prefix+="${prefix:+ }$word"
    case "${word##*/}" in
      pytest | py.test)
        printf '%s -VV\n' "$prefix"
        # The exit status is not the answer: pytest -VV exits 0 with or without
        # plug-ins, and the list it prints is.
        out="$(bash -c "$prefix -VV" </dev/null 2>&1)" || true
        [[ "$out" == *xdist* ]]
        return
        ;;
    esac
  done
  printf '%s\n' "no pytest word in the command"
  return 1
}

# ── the trace of a step command (section 5.3) ────────────────────────────────

# The `-` lines of section 5.6 from one strace log, unsorted. The awk
# variables: start, the directory the command started in; root, the project
# directory; proot, the same directory with its symlinks resolved, which is
# what -y prints.
# shellcheck disable=SC2016  # awk code: the $ fields are awk's, never the shell's
STRACE_AWK='
function norm(p,    n, a, i, k, out) {
  n = split(p, a, "/"); k = 0
  for (i = 1; i <= n; i++) {
    if (a[i] == "" || a[i] == ".") continue
    if (a[i] == "..") { if (k > 0) k--; continue }
    seg[++k] = a[i]
  }
  out = ""
  for (i = 1; i <= k; i++) out = out "/" seg[i]
  return out == "" ? "/" : out
}
function resolve(base, p) { return substr(p, 1, 1) == "/" ? norm(p) : norm(base "/" p) }
function hexval(c) { return index("0123456789abcdef", tolower(c)) - 1 }
# The C string that opens at the first double quote of s, unescaped; STR_OK
# says whether s held one.
function cstring(s,    q, rest, e, out, i, n, c, d, j) {
  STR_OK = 0
  q = index(s, "\""); if (q == 0) return ""
  rest = substr(s, q + 1)
  e = index(rest, "\""); if (e == 0) return ""
  if (index(substr(rest, 1, e - 1), "\\") == 0) { STR_OK = 1; return substr(rest, 1, e - 1) }
  out = ""; n = length(rest)
  for (i = 1; i <= n; i++) {
    c = substr(rest, i, 1)
    if (c == "\"") { STR_OK = 1; return out }
    if (c != "\\") { out = out c; continue }
    c = substr(rest, ++i, 1)
    if (c == "n") out = out "\n"
    else if (c == "t") out = out "\t"
    else if (c == "r") out = out "\r"
    else if (c == "v") out = out "\v"
    else if (c == "f") out = out "\f"
    else if (c == "x") { d = hexval(substr(rest, i + 1, 1)) * 16 + hexval(substr(rest, i + 2, 1)); i += 2; out = out sprintf("%c", d) }
    else if (c ~ /[0-7]/) {
      d = c + 0
      for (j = 0; j < 2 && substr(rest, i + 1, 1) ~ /[0-7]/; j++) d = d * 8 + substr(rest, ++i, 1)
      out = out sprintf("%c", d)
    } else out = out c
  }
  return ""
}
# The path -y printed for the descriptor that opens s, as in 3</a/b>, or "".
function fdpath(s,    e) {
  if (s !~ /^[0-9]+</ && s !~ /^AT_FDCWD</) return ""
  s = substr(s, index(s, "<") + 1)
  e = index(s, ">, "); if (e == 0) e = index(s, ">)"); if (e == 0) return ""
  s = substr(s, 1, e - 1)
  return substr(s, 1, 1) == "/" ? norm(s) : ""
}
function emit(kind, a,    rel) {
  if (a == root || a == proot) rel = ""
  else if (substr(a, 1, length(root) + 1) == root "/") rel = substr(a, length(root) + 2)
  else if (substr(a, 1, length(proot) + 1) == proot "/") rel = substr(a, length(proot) + 2)
  else return
  # The repository database is not synced and changes with every commit. A
  # workspace holds it as the `.git` file of a worktree and `.git-common/`, and
  # a test that ran `git rev-parse` once recorded reads of `.git-common/refs/`
  # and `.git-common/worktrees/`, so a commit selected it (4.0.1 D3b).
  if (rel ~ /^\.git(-common)?(\/|$)/) return
  if (rel ~ /(^|\/)(node_modules|\.venv)(\/|$)/) { if (!setup) print "setup\t-"; setup = 1; return }
  if (rel ~ /[\t\n]/) { if (!badpath) print "partial\t-\ta path holds a tab or a newline"; badpath = 1; return }
  if (kind == "list") print "list\t-\t" (rel == "" ? "." : rel) "/"
  else if (rel != "") print "read\t-\t" rel
}
BEGIN { start = norm(start); root = norm(root); proot = norm(proot); lastclone = "" }
{
  if (!match($0, /^[0-9]+ +/)) next
  pid = substr($0, 1, RLENGTH); sub(/ +$/, "", pid)
  text = substr($0, RLENGTH + 1)
  # A child can print before the clone that made it returns in its parent:
  # it starts in the cwd of the newest clone still open.
  if (!(pid in cwd)) cwd[pid] = lastclone != "" ? lastclone : start
  if (substr(text, 1, 5) == "<... ") {
    r = index(text, " resumed>")
    if (r == 0 || !(pid in pend)) next
    text = pend[pid] substr(text, r + 9)
    delete pend[pid]
  } else if ((u = index(text, " <unfinished ...>")) > 0) {
    pend[pid] = substr(text, 1, u - 1)
    if (pend[pid] ~ /^(clone|clone3|fork|vfork)\(/) lastclone = cwd[pid]
    next
  }
  p = index(text, "(")
  if (p < 2) next
  call = substr(text, 1, p - 1)
  args = substr(text, p + 1)
  ret = ""; rest = text; off = 0
  while ((i = index(rest, " = ")) > 0) { off += i + 2; rest = substr(rest, i + 3) }
  if (off > 0) ret = substr(text, off + 1)
  if (call ~ /^(clone|clone3|fork|vfork)$/) {
    if (ret + 0 > 0) cwd[ret + 0] = cwd[pid]
    lastclone = ""
    next
  }
  if (call ~ /^getdents(64)?$/) { d = fdpath(args); if (d != "") emit("list", d); next }
  if (call == "fchdir") { d = fdpath(args); if (d != "" && ret + 0 == 0) cwd[pid] = d; next }
  base = cwd[pid]
  if (call ~ /^(openat|openat2|newfstatat|fstatat64|statx|faccessat|faccessat2|readlinkat|execveat)$/) {
    if (args ~ /^AT_FDCWD/) { d = fdpath(args); if (d != "") { cwd[pid] = d; base = d } }
    else { base = fdpath(args); if (base == "") next }
  } else if (call !~ /^(open|stat|lstat|stat64|lstat64|access|readlink|execve|chdir)$/) next
  path = cstring(args)
  if (!STR_OK || path == "") next
  if (call == "chdir") { if (ret + 0 == 0) cwd[pid] = resolve(base, path); next }
  # A file opened only to be written is an output of the step, not an input.
  if (call ~ /^open/ && index(args, "O_WRONLY")) next
  emit("read", resolve(base, path))
}'

# strace_trace <strace log> <start dir> <trace file>: the trace file of a
# step command. A read of a path that is a folder now is a stat, and its
# listing, when there was one, is its own `list` line.
strace_trace() {
  local log="$1" start="$2" out="$3" line kind path lines
  lines="$(LC_ALL=C awk -v start="$start" -v root="$PWD" -v proot="$(pwd -P)" "$STRACE_AWK" "$log" | LC_ALL=C sort -u)" || return 1
  {
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      IFS=$'\t' read -r kind _ path <<<"$line"
      if [ "$kind" = read ] && [ -d "$path" ]; then continue; fi
      printf '%s\n' "$line"
    done <<<"$lines"
    # A log whose last line has no newline was cut short.
    [ -z "$(tail -c 1 "$log")" ] || printf 'partial\t-\ttrace cut short\n'
  } >"$out"
}

# setuid_run <strace log>: the first program the traced command ran that is
# setuid or setgid. A tracer that is not root drops that bit, so `sudo` under
# strace answers "effective uid is not 0" and the step fails.
setuid_run() {
  local prog
  while IFS= read -r prog; do
    if [ -u "$prog" ] || [ -g "$prog" ]; then printf '%s\n' "$prog"; return 0; fi
  done < <(LC_ALL=C awk 'match($0, /execve\("\/[^"]*"/) { print substr($0, RSTART + 8, RLENGTH - 9) }' "$1" | LC_ALL=C sort -u)
  return 1
}

# ── cgroup=nested ────────────────────────────────────────────────────────────
#
# A test may read its own cgroup from /proc/self/cgroup and need a path of
# depth 2 or more, as it has on a laptop under systemd. MEASURED in a
# workspace under sysbox: every gate process sits in `0::/init.scope`, depth 1,
# and dev cannot create a cgroup, because /sys/fs/cgroup belongs to the
# container's root. `sudo -n` works for dev, and container root can. On a
# laptop under systemd and on a CI runner the path is deeper already, and the
# step stays where it is.
#
# The step's own shell joins devbox/<name> before it execs the command, so
# every process the command starts inherits it. The name is the step's alone,
# not the run's: one gate runs in a workspace at a time, so two steps never
# share one, and a gate stopped by a signal leaves one empty cgroup per step
# that the next gate reuses, never one more per run.
#
# The cgroup sits below the container's own, so the container's memory limit
# stays in force over it. A step that leaves a process behind keeps the cgroup
# alive, and that process still counts against the container's limit.
NESTED_ROOT="${DEVBOX_CGROUP_ROOT:-/sys/fs/cgroup}"
PROC_CGROUP="${DEVBOX_PROC_CGROUP:-/proc/self/cgroup}"
# The directory the step of this job joins, set by cgroup_prepare. Empty when
# the step needs no move.
CGROUP_DIR=""

# own_cgroup: the cgroup v2 path of this shell, from the `0::` line of
# /proc/self/cgroup, or a status of 1 when no such line exists.
own_cgroup() {
  local line
  while IFS= read -r line; do
    case "$line" in 0::/*) printf '%s\n' "${line#0::}"; return 0 ;; esac
  done <"$PROC_CGROUP"
  return 1
}

# cgroup_depth <path>: how many parts the path has. / is 0, /init.scope is 1.
cgroup_depth() {
  local part n=0
  local -a parts
  IFS=/ read -ra parts <<<"$1"
  for part in ${parts[@]+"${parts[@]}"}; do [ -z "$part" ] || n=$((n + 1)); done
  printf '%s\n' "$n"
}

# cgroup_prepare <name> <log>: set CGROUP_DIR to the cgroup step <name> must
# join, created, or to nothing when its shell sits at depth 2 or more. A step
# that cannot get one does not run, and the log says why: a test that asserts
# its depth would fail on a reason the log never named, and a test that skips
# on a shallow path would pass having tested nothing.
cgroup_prepare() {
  local name="$1" log="$2" path depth
  CGROUP_DIR=""
  if ! path="$(own_cgroup 2>>"$log")"; then
    printf 'devbox-steps: %s has cgroup=nested, and %s holds no cgroup v2 line (0::/...), so %s did not run\n' "$name" "$PROC_CGROUP" "$name" >>"$log"
    return 1
  fi
  depth="$(cgroup_depth "$path")"
  if [ "$depth" -ge 2 ]; then
    printf 'devbox-steps: %s runs in cgroup %s, depth %s, so cgroup=nested moves it nowhere\n' "$name" "$path" "$depth" >>"$log"
    return 0
  fi
  # shellcheck disable=SC2024 # the log is the step's, which this user writes; only mkdir needs root
  if ! sudo -n mkdir -p "$NESTED_ROOT/devbox/$name" >>"$log" 2>&1; then
    printf 'devbox-steps: %s has cgroup=nested and runs in cgroup %s, depth %s, and sudo -n mkdir -p %s failed, so %s did not run; cgroup=nested needs passwordless sudo and a cgroup v2 hierarchy at %s\n' \
      "$name" "$path" "$depth" "$NESTED_ROOT/devbox/$name" "$name" "$NESTED_ROOT" >>"$log"
    return 1
  fi
  printf 'devbox-steps: %s runs in cgroup %s, depth %s, so it moves to %s\n' "$name" "$path" "$depth" "$NESTED_ROOT/devbox/$name" >>"$log"
  CGROUP_DIR="$NESTED_ROOT/devbox/$name"
}

# cgroup_join <name>: move this shell into CGROUP_DIR, then read
# /proc/self/cgroup again. A write the kernel took and a path that did not
# change would run the step at the old depth, so the path is checked, not the
# write. The messages go to stderr, which run_command sends to the step log.
cgroup_join() {
  local name="$1" pid="$BASHPID" path
  [ -n "$CGROUP_DIR" ] || return 0
  # The pid is read into a variable first. A redirection of an external
  # command expands in the child bash forks for it, so `<<<"$BASHPID"` there
  # wrote the child's pid. MEASURED in tests/test-steps-cgroup.sh: the pid
  # moved was not the step command's, so the command ran at the old depth.
  if ! sudo -n tee "$CGROUP_DIR/cgroup.procs" >/dev/null <<<"$pid"; then
    echo "devbox-steps: could not write pid $pid to $CGROUP_DIR/cgroup.procs with sudo -n, so $name did not run" >&2
    return 1
  fi
  path="$(own_cgroup)" || path=""
  case "$path" in
    */devbox/"$name") [ "$(cgroup_depth "$path")" -lt 2 ] || return 0 ;;
  esac
  echo "devbox-steps: pid $pid was written to $CGROUP_DIR/cgroup.procs, and $PROC_CGROUP still names $(printf '%q' "$path"), so $name did not run" >&2
  return 1
}

# cgroup_remove <name> <log>: remove CGROUP_DIR once the step ended. A
# failure is reported and does not fail the step: the step's own result is
# already decided, and the cgroup still holds the process the step left
# behind, which is where it belongs. The next gate reuses it.
cgroup_remove() {
  local name="$1" log="$2"
  [ -n "$CGROUP_DIR" ] || return 0
  # shellcheck disable=SC2024 # the log is the step's, which this user writes; only rmdir needs root
  sudo -n rmdir "$CGROUP_DIR" >>"$log" 2>&1 && return 0
  printf 'devbox-steps: could not remove the cgroup %s: a process the step started may still run in it\n' "$CGROUP_DIR" >>"$log"
  echo "devbox-steps: $name left its cgroup $CGROUP_DIR"
}

# ── a step ───────────────────────────────────────────────────────────────────

# The command of one step with the runner's plug-in and its worker option
# appended, before its files, which split_batches appends. $2 is the step's
# worker count. The notes go to stderr, which run_step writes to the step log.
compose() {
  local name="$1" workers="$2" cmd="${CMD[$1]}" dir="${DIR[$1]}" plugin=0 probe
  [ -z "$LEDGER" ] && [ -z "${TRACED[$name]+x}" ] || plugin=1
  case "${RUNNER[$name]}" in
    vitest)
      [ "$plugin" = 0 ] || cmd+=" --reporter=default --reporter=./$VITEST_DIR/vitest-ledger.mjs"
      if own_workers vitest "$cmd"; then
        echo "devbox-steps: the command sets its own vitest workers, and keeps them" >&2
      else
        cmd+=" --maxWorkers=$workers"
        # vitest 2 takes its minimum worker count from the cores, and a lower
        # --maxWorkers alone stopped the run with "RangeError: options.minThreads
        # and options.maxThreads must not conflict" on a many-core machine. vitest
        # 4 removed --minWorkers, so the option goes to 2 and 3 alone.
        case "$(vitest_major "./$dir")" in
          2 | 3) [[ " $cmd " == *" --minWorkers"* ]] || cmd+=" --minWorkers=1" ;;
        esac
      fi
      ;;
    pytest)
      [ "$plugin" = 0 ] || cmd+=" -p devbox_ledger"
      if own_workers pytest "$cmd"; then
        echo "devbox-steps: the command sets its own pytest workers, and keeps them" >&2
      elif probe="$(cd "./$dir" && pytest_xdist "${CMD[$name]}")"; then
        echo "devbox-steps: pytest-xdist loads in \`$probe\`, so the step runs with -n $workers" >&2
        cmd+=" -n $workers"
      else
        echo "devbox-steps: pytest-xdist does not load in \`$probe\`, so the step runs with no -n" >&2
      fi
      ;;
  esac
  printf '%s\n' "$cmd"
}

# The most bytes one composed command line may hold before its files run in
# batches. MEASURED: a vitest step of a few thousand files composed a command
# over 131072 bytes, and its `npx vitest run` exited 249 after 4 seconds and printed
# nothing, so the step failed with no message. npx starts the bin through
# `sh -c` with the command and every argument joined into one string, and
# Linux refuses a single argument string over 131072 bytes (MAX_ARG_STRLEN)
# with E2BIG. npm exec, npm run and a project's own `sh -c "$*"` join the same
# way, and the runner cannot know what a command does, so the budget holds for
# every runner step. 96 KiB leaves 32 KiB for what a wrapper adds: its bin
# path, and two quotes around each argument, which stays under 32 KiB for any
# list whose paths average 5 bytes or more. The runner's own `bash <script>`
# has no such cap, so a list under the budget runs as one command.
BATCH_BYTES=98304

# byte_sizes <word>...: the bytes of each word into SIZES. Under LC_ALL=C,
# because ${#word} counts characters in a UTF-8 locale and a file name may
# hold multi-byte ones.
byte_sizes() {
  local LC_ALL=C word
  SIZES=()
  for word in "$@"; do SIZES+=("${#word}"); done
}

# split_batches <name> <prefix> <script>: the commands of one step into
# BATCHES, each the prefix of compose with its files appended, the file count
# of each into BATCH_FILES, the bytes of the whole list as one command into
# LINE_BYTES, and each command into its script, <script> for the first and
# <script without .sh>.<n>.sh for batch n. One command when it fits
# BATCH_BYTES, byte for byte the command of a single run; else as many
# batches as it takes, each under the budget, in the order of the list. A file
# whose name alone passes the budget runs in a batch of its own, as it is,
# because no split makes it shorter.
split_batches() {
  local name="$1" prefix="$2" script="$3" dir="${DIR[$1]}" f q cmd i bytes count
  local -a files=() quoted=()
  BATCHES=() BATCH_FILES=() LINE_BYTES=0
  [ -z "${RUNLIST[$name]-}" ] || mapfile -t files <<<"${RUNLIST[$name]%$'\n'}"
  # The plan names files from the project directory, and a dir= step's runner
  # runs in its folder, so each file loses that folder's prefix. Every
  # appended word goes through printf %q, because the command runs under bash
  # and a file name may hold a space or a quote.
  cmd="$prefix"
  for f in ${files[@]+"${files[@]}"}; do
    printf -v q ' %q' "${f#"$dir"}"
    quoted+=("$q")
    cmd+="$q"
  done
  byte_sizes "$prefix" ${quoted[@]+"${quoted[@]}"}
  for bytes in "${SIZES[@]}"; do LINE_BYTES=$((LINE_BYTES + bytes)); done
  if [ "$LINE_BYTES" -le "$BATCH_BYTES" ]; then
    BATCHES=("$cmd")
    BATCH_FILES=("${#files[@]}")
  else
    cmd="$prefix" bytes="${SIZES[0]}" count=0
    for i in "${!quoted[@]}"; do
      if [ "$count" -gt 0 ] && [ $((bytes + SIZES[i + 1])) -gt "$BATCH_BYTES" ]; then
        BATCHES+=("$cmd")
        BATCH_FILES+=("$count")
        cmd="$prefix" bytes="${SIZES[0]}" count=0
      fi
      cmd+="${quoted[i]}"
      bytes=$((bytes + SIZES[i + 1]))
      count=$((count + 1))
    done
    BATCHES+=("$cmd")
    BATCH_FILES+=("$count")
  fi
  for i in "${!BATCHES[@]}"; do
    printf '%s\n' "${BATCHES[i]}" >"$(batch_script "$script" "$i")" || return 1
  done
}

# batch_script <script> <index>: the script of batch <index>, counted from 0.
batch_script() {
  if [ "$2" = 0 ]; then printf '%s' "$1"; else printf '%s.%d.sh' "${1%.sh}" "$(($2 + 1))"; fi
}

# step_note <name> <log> <text>: one `devbox-steps:` line into the step log,
# and onto stdout too when the step streams, whose log is not printed again.
step_note() {
  if [ "$1" = "$STREAM" ]; then
    printf 'devbox-steps: %s\n' "$3" | tee -a "$2"
  else
    printf 'devbox-steps: %s\n' "$3" >>"$2"
  fi
}

# run_batches <name> <script> <log>: the batches of split_batches in order,
# each logged and run as run_command runs one command. Every batch runs, also
# after one fails, so the ledger and the log hold every failure of the step.
# The status is the first failed batch's code, the run whose failure the log
# shows first; 0 only when every batch passed.
run_batches() {
  local name="$1" script="$2" log="$3" n="${#BATCHES[@]}" i rc=0 b
  if [ "$n" = 1 ]; then
    printf 'devbox-steps: %s\n' "${BATCHES[0]}" >>"$log"
    run_command "$name" "$script" "$log" || rc=$?
    return "$rc"
  fi
  local total=0
  for b in "${BATCH_FILES[@]}"; do total=$((total + b)); done
  step_note "$name" "$log" "$name lists $total files, a command of $LINE_BYTES bytes, over the $BATCH_BYTES this runner allows below the 131072 one argument may hold when a wrapper such as npx joins the command into one, so it runs in $n batches"
  for ((i = 0; i < n; i++)); do
    step_note "$name" "$log" "$name batch $((i + 1)) of $n, ${BATCH_FILES[i]} files"
    printf 'devbox-steps: %s\n' "${BATCHES[i]}" >>"$log"
    b=0
    run_command "$name" "$(batch_script "$script" "$i")" "$log" || b=$?
    if [ "$b" != 0 ]; then
      step_note "$name" "$log" "$name batch $((i + 1)) of $n failed with code $b"
      [ "$rc" != 0 ] || rc="$b"
    fi
  done
  return "$rc"
}

# run_command <name> <script> <log>: the command of one step in its folder,
# its output into its log, and streamed when it is the one step that runs.
# Prints nothing; the status is the command's.
run_command() {
  local name="$1" script="$2" log="$3" rc=0
  shift 3
  if [ "$name" = "$STREAM" ]; then
    # The status is the command's, also when tee cannot write the log. A
    # strace log of a long step filled the 10% tmpfs of $XDG_RUNTIME_DIR on a
    # CI runner, and tee's ENOSPC failed a step whose command passed. GNU tee
    # keeps streaming to stdout after a file write fails.
    (cgroup_join "$name" || exit 2; cd "./${DIR[$name]}" && exec "$@" bash "$script") </dev/null 2>&1 \
      | { tee -a "$log" || echo "devbox-steps: could not write all of the log $log" >&2; } || rc=$?
  else
    (cgroup_join "$name" || exit 2; cd "./${DIR[$name]}" && exec "$@" bash "$script") </dev/null >>"$log" 2>&1 || rc=$?
  fi
  return "$rc"
}

# The body of one background job. Its result reaches the main loop through a
# file written by rename, because `wait -n` before bash 5.1 does not say which
# job ended. $2 is the step's worker count.
run_step() {
  local name="$1" workers="$2" log started="$SECONDS" rc=0 cmd prefix script tdir prog
  log="$(log_of "$name")"
  script="$STATE_DIR/$name.sh"
  tdir="$(trace_dir_of "$name")"
  export DEVBOX_WORKERS="$workers"
  # A command of a few thousand file arguments is longer than the 128 KiB one
  # argument may hold, so it runs from a file rather than bash -c, and a list
  # past BATCH_BYTES runs in batches, for a wrapper that joins its arguments.
  if [ -n "${NESTED[$name]+x}" ] && ! cgroup_prepare "$name" "$log"; then
    rc=2
  elif ! prefix="$(compose "$name" "$workers" 2>>"$log")" || ! split_batches "$name" "$prefix" "$script"; then
    rc=2
    printf 'devbox-steps: could not compose the command of %s, so it did not run\n' "$name" >>"$log"
  elif [ -n "${TRACED[$name]+x}" ] && ! { rm -rf "$tdir" && mkdir -p "$tdir"; }; then
    rc=2
    printf 'devbox-steps: cannot create the trace folder %s, so %s did not run\n' "$tdir" "$name" >>"$log"
  elif [ -n "${TRACED[$name]+x}" ] && [ "${RUNNER[$name]}" = - ]; then
    # A step without a runner is given no file, so it is always one command.
    cmd="${BATCHES[0]}"
    printf 'devbox-steps: %s\n' "$cmd" >>"$log"
    run_command "$name" "$script" "$log" strace "${STRACE_OPTS[@]}" -o "$tdir/strace.log" || rc=$?
    if [ "$rc" != 0 ] && prog="$(setuid_run "$tdir/strace.log")"; then
      # The trace made the step fail, so the step runs again untraced, as it
      # ran before traces.
      echo "devbox-steps: untraced $name it runs $prog, which strace stops from gaining its privilege"
      printf 'devbox-steps: %s failed with code %s under strace and runs %s, so it runs again untraced\n' "$name" "$rc" "$prog" >>"$log"
      rm -rf "$tdir"
      rc=0
      run_command "$name" "$script" "$log" || rc=$?
    elif [ ! -f "$tdir/strace.log" ]; then
      printf 'partial\t-\ttrace cut short\n' >"$tdir/strace-$BASHPID.trace"
    elif ! strace_trace "$tdir/strace.log" "$PWD/${DIR[$name]}" "$tdir/strace-$BASHPID.trace"; then
      # A trace file half written would reach the client as a whole one.
      rm -f "$tdir/strace-$BASHPID.trace"
      printf 'devbox-steps: could not read the strace log of %s, so it has no trace this run\n' "$name" >>"$log"
    fi
    rm -f "$tdir/strace.log"
  else
    if [ "${RUNNER[$name]}" = pytest ] && { [ -n "$LEDGER" ] || [ -n "${TRACED[$name]+x}" ]; }; then
      export PYTHONPATH="$DEVBOX_LEDGER_TOOLS${PYTHONPATH:+:$PYTHONPATH}"
    fi
    if [ -n "${TRACED[$name]+x}" ]; then
      export DEVBOX_TRACE_DIR="$tdir" DEVBOX_TRACE_ROOT="$PWD"
      # Node splits NODE_OPTIONS on spaces outside double quotes.
      [ "${RUNNER[$name]}" != vitest ] \
        || export NODE_OPTIONS="--import=\"$DEVBOX_LEDGER_TOOLS/devbox-trace-hook.mjs\"${NODE_OPTIONS:+ $NODE_OPTIONS}"
    fi
    run_batches "$name" "$script" "$log" || rc=$?
  fi
  cgroup_remove "$name" "$log"
  printf '%s %s\n' "$rc" "$((SECONDS - started))" >"$STATE_DIR/$name.tmp"
  mv -f "$STATE_DIR/$name.tmp" "$STATE_DIR/$name.done"
}

# start_step <name> <workers> <reservation in bytes>
start_step() {
  local name="$1" workers="$2"
  : >"$(log_of "$name")" || fatal "cannot write the log $(log_of "$name")"
  ledger_step "$name" start
  RESERVED[$name]="$3"
  # Before the fork, so a streamed step's first line never comes before its
  # header. The reservation is named only where a budget holds steps.
  if [ -n "$BUDGET" ]; then
    echo "$(stamp) $name started, reserving $(gib "$3")"
  else
    echo "$(stamp) $name started"
  fi
  if [ -n "${UNTRACED[$name]+x}" ]; then
    echo "devbox-steps: untraced $name ${UNTRACED[$name]}"
    echo "devbox-steps: $name runs untraced: ${UNTRACED[$name]}" >>"$(log_of "$name")"
  fi
  [ "$name" != "$STREAM" ] || echo "== $name: $(log_of "$name")"
  # Monitor mode for the fork alone gives the job its own process group, so a
  # signal to this program reaches every process of a step through that group.
  # Left on, it would print a job notice on stderr for every step that ends.
  set -m
  run_step "$name" "$workers" &
  PID[$name]=$!
  set +m
  STATUS[$name]=running
}

running_names() {
  local name out=""
  for name in "${NAMES[@]}"; do
    [ "${STATUS[$name]}" != running ] || out+="${out:+ }$name"
  done
  printf '%s' "${out:-nothing}"
}

# Signal every running step's process group, give it 10 s to end, then kill
# what remains.
stop_running() {
  local name alive i
  for name in "${NAMES[@]}"; do
    [ "${STATUS[$name]}" = running ] || continue
    # The group may have ended between the scan and the signal.
    kill -TERM -- "-${PID[$name]}" 2>/dev/null || true
  done
  for i in $(seq 1 20); do
    alive=0
    for name in "${NAMES[@]}"; do
      [ "${STATUS[$name]}" = running ] || continue
      # A group that is gone is the answer, not an error.
      ! kill -0 -- "-${PID[$name]}" 2>/dev/null || alive=1
    done
    [ "$alive" = 1 ] || break
    [ "$i" = 20 ] || sleep 0.5
  done
  for name in "${NAMES[@]}"; do
    [ "${STATUS[$name]}" = running ] || continue
    # The same race as above: a group that ended in the last half second.
    kill -KILL -- "-${PID[$name]}" 2>/dev/null || true
  done
}

# shellcheck disable=SC2317  # reached through the TERM and INT traps, never by name
on_signal() {
  local code="$1" sig="$2" running
  trap - TERM INT
  running="$(running_names)"
  stop_running
  echo "devbox-steps: stopped by SIG$sig; stopped the process groups of: $running" >&2
  exit "$code"
}
trap 'on_signal 143 TERM' TERM
trap 'on_signal 130 INT' INT

fatal() {
  echo "devbox-steps: $*" >&2
  trap - TERM INT
  stop_running
  exit 2
}

# Carried and resumed steps end before the first fork, so a step after one of
# them starts at once.
for name in "${NAMES[@]}"; do
  if [ "${MODE[$name]}" = carry ]; then
    STATUS[$name]=ended OUTCOME[$name]=carried SECS[$name]=0 CODE[$name]=0
    echo "$(stamp) $name carried"
  elif [ -n "${LEDGER_PASSED[$name]+x}" ]; then
    STATUS[$name]=ended OUTCOME[$name]=resumed SECS[$name]=0 CODE[$name]=0
    echo "$(stamp) $name resumed: it passed in an earlier run of this gate"
  elif [ -n "${RESUMED_ALL[$name]+x}" ]; then
    STATUS[$name]=ended OUTCOME[$name]=resumed SECS[$name]=0 CODE[$name]=0
    echo "$(stamp) $name resumed: every file it runs passed in an earlier run of this gate"
  fi
done

# A plan in which one step runs streams that step's output as it comes, after
# its `== <name>: <log>` header, and the log is not printed again at the end.
# A gate of one command used to stream its output to the terminal: behind
# the log file alone it printed nothing for its whole length,
# and an agent that watches a silent terminal reads a hang. Two or more steps
# that run in parallel keep their logs apart, because interleaved lines of two
# test runs cannot be read.
STREAM=""
running=0
for name in "${NAMES[@]}"; do
  [ "${STATUS[$name]}" = pending ] || continue
  running=$((running + 1))
  STREAM="$name"
done
[ "$running" = 1 ] || STREAM=""

finish_step() {
  local name="$1" rc secs
  read -r rc secs <"$STATE_DIR/$name.done"
  CODE[$name]="$rc" SECS[$name]="$secs"
  if [ "$rc" = 0 ]; then
    OUTCOME[$name]=pass
    ledger_step "$name" pass "$secs"
    echo "$(stamp) $name passed ($secs s); running: $(running_names)"
  else
    OUTCOME[$name]=fail
    ledger_step "$name" fail "$secs"
    echo "$(stamp) $name failed ($secs s, code $rc); running: $(running_names)"
  fi
}

# At most TOKENS runner steps run at once, one per token of the grant: each
# gets at least one worker, so more runner steps than tokens are more test
# processes than the grant. MEASURED: every runner step of a monorepo started
# together and ran several times as many test processes as the grant had
# tokens, and the host's load failed most of them on timeouts. A step without
# a runner is not held: it runs no worker pool. A held step starts in a later
# pass, after a runner step ends, so whenever a step is held the loop below
# waits on a running one.
#
# Memory is the second hold (step-memory-budget spec, D3). MEASURED: a gate
# whose grant matched the host's cores started one runner step per token
# beside the steps without a runner, in one workspace, and about a quarter of
# its steps timed out on memory reclaim while most of the host's cores stood
# idle: each step had sized its workers from the whole workspace. Now a step
# starts only while its reservation fits what the running steps leave of the
# budget. A runner step that does not fit shrinks its workers to fit first. A
# step that cannot fit waits for a running one to end, and when none runs the
# next ready step starts whatever its size, so no reservation can stall the
# gate.
#
# The runner steps of a pass start before the steps without a runner, each
# with its fair share of step_workers, and the steps without a runner take
# what is left. MEASURED: a gate of three runner steps and about a dozen steps
# without a runner started six short steps first, in plan order, which
# reserved three quarters of the budget, and its vitest step started with the
# 2 workers that were left. The short steps all ended within six minutes. The
# vitest step kept its 2 workers for over an hour on a grant several times as
# large, and a pytest step of the same project ran with 2 workers for 42
# minutes, while most of the host's cores stood idle. vitest and pytest-xdist
# fix their worker count when they start and never add one. A short step that
# waits starts as soon as a running step frees its memory.
declare -A RESERVED=()
HELD_SAID=0
MEM_SAID=0
while :; do
  # The steps that start in one pass share the grant with the runner steps
  # already running, so two suites that start together get half each, not
  # all of it for the first and half for the second.
  starting=()
  ready_names=()
  runners=0
  held=0
  for name in "${NAMES[@]}"; do
    if [ "${STATUS[$name]}" = running ]; then
      [ "${RUNNER[$name]}" = - ] || runners=$((runners + 1))
      continue
    fi
    [ "${STATUS[$name]}" = pending ] || continue
    ready=1
    for dep in ${AFTER[$name]}; do [ "${STATUS[$dep]}" = ended ] || ready=0; done
    [ "$ready" = 0 ] || ready_names+=("$name")
  done
  # The runner steps first, then the steps without a runner, each kind in
  # plan order.
  for name in ${ready_names[@]+"${ready_names[@]}"}; do
    [ "${RUNNER[$name]}" != - ] || continue
    if [ "$runners" -ge "$TOKENS" ]; then
      held=$((held + 1))
      continue
    fi
    runners=$((runners + 1))
    starting+=("$name")
  done
  for name in ${ready_names[@]+"${ready_names[@]}"}; do
    [ "${RUNNER[$name]}" != - ] || starting+=("$name")
  done
  reserved=0
  active=0
  for name in "${NAMES[@]}"; do
    [ "${STATUS[$name]}" = running ] || continue
    reserved=$((reserved + RESERVED[$name]))
    active=$((active + 1))
  done
  mem_held=0
  mem_first=""
  for name in ${starting[@]+"${starting[@]}"}; do
    workers="$(step_workers "$name" "$runners")"
    need="$(step_reservation "$name" "$workers")"
    if [ -n "$BUDGET" ] && [ "$need" -gt $((BUDGET - reserved)) ]; then
      fit=0
      [ "${RUNNER[$name]}" = - ] || [ "$BUDGET" -le "$reserved" ] || fit=$(((BUDGET - reserved) / $(worker_memory "$name")))
      if [ "$fit" -ge 1 ]; then
        workers="$fit"
        need="$(step_reservation "$name" "$workers")"
      elif [ "$active" -gt 0 ]; then
        mem_held=$((mem_held + 1))
        [ -n "$mem_first" ] || mem_first="$name needs $(gib "$need")"
        continue
      fi
    fi
    start_step "$name" "$workers" "$need"
    reserved=$((reserved + need))
    active=$((active + 1))
  done
  if [ "$held" -gt 0 ] && [ "$HELD_SAID" = 0 ]; then
    HELD_SAID=1
    echo "$(stamp) $held runner steps wait: at most $TOKENS run at once, one per token of the grant"
  fi
  if [ "$mem_held" -gt 0 ] && [ "$MEM_SAID" = 0 ]; then
    MEM_SAID=1
    free=$((BUDGET - reserved))
    [ "$free" -ge 0 ] || free=0
    echo "$(stamp) $mem_held steps wait for memory: $(gib "$free") of $(gib "$BUDGET") free, $mem_first"
  fi
  [ "$(running_names)" != nothing ] || break
  # The status is read from each step's result file below; wait -n only blocks
  # until one job ends, and returns 127 when that job was already reaped.
  wait -n || true
  # Every step that ended is marked first, so the progress line of each names
  # only the steps still running.
  ended=()
  for name in "${NAMES[@]}"; do
    [ "${STATUS[$name]}" = running ] || continue
    # A job that is gone is the answer of kill -0, not an error.
    if [ ! -f "$STATE_DIR/$name.done" ] && ! kill -0 "${PID[$name]}" 2>/dev/null; then
      # The job died before it wrote its result, so a signal from outside this
      # program took it. Its exit status, read as data, is the only code left.
      # The file is read again because the job may write it and exit between
      # the first test and kill -0.
      [ -f "$STATE_DIR/$name.done" ] || {
        rc=0
        wait "${PID[$name]}" || rc=$?
        printf '%s 0\n' "$rc" >"$STATE_DIR/$name.done"
      }
    fi
    [ -f "$STATE_DIR/$name.done" ] || continue
    STATUS[$name]=ended
    ended+=("$name")
  done
  for name in "${ended[@]}"; do finish_step "$name"; done
done

# ── the summary ──────────────────────────────────────────────────────────────

width=4
for name in "${NAMES[@]}"; do [ "${#name}" -le "$width" ] || width="${#name}"; done
failed=()
echo "devbox-steps: summary"
for name in "${NAMES[@]}"; do
  printf '  %-*s  %-7s  %5s s  code %s\n' "$width" "$name" "${OUTCOME[$name]}" "${SECS[$name]}" "${CODE[$name]}"
  [ "${OUTCOME[$name]}" != fail ] || failed+=("$name")
done
for name in "${failed[@]}"; do
  [ "$name" != "$STREAM" ] || continue
  echo "== $name: $(log_of "$name")"
  cat "$(log_of "$name")"
done

# The tokens of section 5.7, resolved over every trace file of one step. The
# hook writes `partial <test file> <reason> <token>` when a test starts a
# Worker or a node child, and the hook in that Worker or child writes
# `covered <test file> <token>` in its own trace file when it loads. Most of
# the partial test files of one vitest suite were partial only because a test
# started a Worker, and one partial file makes its step lose its learned
# inputs. A confirmed token drops its partial line. An unconfirmed one, or a
# line whose fields or token break the form, stays as the plain
# `partial <test file> <reason>` of section 5.4, because a failure in this
# path must leave the file partial. Every covered line is dropped, so the
# client and the map read only the forms they read before tokens.
# shellcheck disable=SC2016  # awk code: the $ fields are awk's, never the shell's
TOKEN_AWK='
function token_ok(t) { return length(t) >= 8 && length(t) <= 64 && t !~ /[^A-Za-z0-9._-]/ }
$1 == "covered" { if (NF == 3 && token_ok($3)) covered[$2 FS $3] = 1; next }
$1 == "partial" && NF > 3 {
  if (NF == 4 && token_ok($4)) { file[++n] = $2; reason[n] = $3; token[n] = $4 }
  else print $1 FS $2 FS $3
  next
}
{ print }
END { for (i = 1; i <= n; i++) if (!((file[i] FS token[i]) in covered)) print "partial" FS file[i] FS reason[i] }'

# The trace of each traced step that ran, sorted, de-duplicated, gzipped and
# in base64 chunks (section 5.6). The host keeps nothing, so the trace reaches
# the client on the same stdout as the result lines. gzip's own length and
# checksum tell the client that a chunk is missing.
for name in "${NAMES[@]}"; do
  [ -n "${TRACED[$name]+x}" ] || continue
  case "${OUTCOME[$name]}" in pass | fail) ;; *) continue ;; esac
  tdir="$(trace_dir_of "$name")"
  # A step that ran again untraced removed its folder, and said so.
  [ -d "$tdir" ] || continue
  traces=()
  for f in "$tdir"/*.trace; do [ ! -f "$f" ] || traces+=("$f"); done
  if [ "${#traces[@]}" -eq 0 ]; then
    echo "devbox-steps: $name wrote no trace file under $tdir, so it has no trace this run" >&2
    continue
  fi
  if ! packed="$(cat -- "${traces[@]}" | LC_ALL=C awk -F '\t' "$TOKEN_AWK" | LC_ALL=C sort -u | gzip -cn | base64 | tr -d '\n')"; then
    echo "devbox-steps: could not pack the trace of $name, so it has no trace this run" >&2
    continue
  fi
  seq=0
  for ((i = 0; i < ${#packed}; i += 65536)); do
    seq=$((seq + 1))
    echo "devbox-steps: trace $name $seq ${packed:i:65536}"
  done
done

for name in "${NAMES[@]}"; do
  echo "devbox-steps: result $name ${OUTCOME[$name]} ${SECS[$name]} ${CODE[$name]}"
done
[ "${#failed[@]}" -eq 0 ] || exit 1
exit 0
