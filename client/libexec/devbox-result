#!/bin/bash
# `devbox result`: print this checkout's newest gate record
# (docs/specs/2026-11-14-client-owns-the-gate-design.md, sections 3 and 7).
#
# Every landing script grepped the gate output for a verdict line, or decoded a
# record line of its own, each with its own parser. The record is the
# client's now, and this is the one reader a script calls:
#
#   devbox result                         one line per step, then the verdict
#   devbox result --failed-files [<step>] the failed test files, one per line
#   devbox result --log <step>            the saved log section of one step
#   devbox result --failed-steps          the failed steps, one per line
#   devbox result --json                  the whole record as one JSON object
#
# A landing script parsed the `devbox: red (...)` text for the failed steps,
# and each copy broke on another wording. --failed-steps and --json are the
# machine-readable forms (learned-selection spec, D9 and section 9). The JSON
# is built with awk's printf, so the client needs no jq.
#
# Exit 0, 1 when there is no record (or no log of that step), 2 for a usage
# error or a directory outside a git checkout.
set -euo pipefail
# The shared library is the compatibility surface between the two halves, so it
# is resolved rather than assumed: beside the checkout or package two levels up,
# and /usr/local/lib/devbox on a provisioned server, where the server installer puts it.
_here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
DEVBOX_LIB=""
for _c in "$_here/../../lib/devbox-lib.sh" /usr/local/lib/devbox/devbox-lib.sh; do
  [ -r "$_c" ] && { DEVBOX_LIB="$_c"; break; }
done
[ -n "$DEVBOX_LIB" ] || { echo "devbox result: no devbox-lib.sh beside $_here or in /usr/local/lib/devbox" >&2; exit 1; }
# shellcheck source=/dev/null
source "$DEVBOX_LIB"
# shellcheck source=client/libexec/devbox-record
source "$_here/devbox-record"
# shellcheck disable=SC2034  # read by require_run_id in lib/devbox-lib.sh, a source shellcheck does not follow
DEVBOX_GUARD_WHO="devbox result"

usage() {
  echo "usage: devbox result [--failed-steps | --failed-files [<step>] | --log <step> | --json]" >&2
  exit 2
}

mode=summary step=""
case "${1-}" in
  "") [ "$#" -eq 0 ] || usage ;;
  --failed-files) [ "$#" -le 2 ] || usage; mode=failed step="${2-}" ;;
  --log) [ "$#" -eq 2 ] || usage; mode=log step="$2" ;;
  --failed-steps) [ "$#" -eq 1 ] || usage; mode=failed-steps ;;
  --json) [ "$#" -eq 1 ] || usage; mode=json ;;
  *) usage ;;
esac
# A step name of section 4.2. Anything else names no step of any record.
if [ -n "$step" ] && ! [[ "$step" =~ ^[a-z0-9][a-z0-9:_-]*$ ]]; then
  echo "devbox result: '$step' is not a step name" >&2
  usage
fi

git rev-parse --git-dir >/dev/null 2>&1 || { echo "devbox result: $PWD is not inside a git checkout" >&2; exit 2; }
# The record directory lies under the git common dir, which every worktree of
# the repository shares, so another worktree's gate may be the newest record.
# A landing script asks about the branch it lands, so the newest record of
# this branch answers first, and the newest of any branch only when this
# branch has none. A detached HEAD has no branch: symbolic-ref exits 1 and the
# record says `-` (section 7).
branch="$(devbox_record_branch)"
# A failed read says so: a bare exit 1 here once read as "no record" to every
# caller, after a gate that had written one.
if ! record="$(devbox_record_newest "$branch")"; then
  echo "devbox result: could not read the records in $(devbox_record_dir)" >&2
  exit 1
fi
if [ -z "$record" ]; then
  echo "devbox result: no record in $(devbox_record_dir); devbox verify writes one after each gate" >&2
  exit 1
fi
run="$(awk -F'\t' '$1 == "run" { print $2; exit }' "$record")"

case "$mode" in
  summary)
    devbox_record_summary "$record"
    ;;
  failed)
    devbox_record_failed_files "$run" "$step"
    ;;
  failed-steps)
    # A step that reads pass beside a failed test file of its own is failed,
    # as the verdict of devbox_record_summary reads it.
    awk -F'\t' '
      $1 == "step" { n++; name[n] = $2; out[$2] = $4 }
      $1 == "file" && $5 == "fail" { ff[$2] = 1 }
      END { for (i = 1; i <= n; i++) if (out[name[i]] == "fail" || (name[i] in ff)) print name[i] }' "$record"
    ;;
  json)
    # One object on one line, built with the js() and num() of devbox-record.
    # Each step lists its failed test files in record order.
    LC_ALL=C awk -F'\t' "$_DEVBOX_RECORD_AWK_JSON"'
      function hdr(k) { return (k in h) ? js(h[k]) : "null" }
      $1 == "run" || $1 == "client" || $1 == "branch" || $1 == "commit" || $1 == "target" || $1 == "scope" || $1 == "at" || $1 == "complete" { h[$1] = $2 }
      $1 == "step" {
        n++; name[n] = $2
        line[n] = "{\"name\":" js($2) ",\"key\":" js($3) ",\"outcome\":" js($4) ",\"seconds\":" num($5) ",\"code\":" num($6) ",\"mode\":" js($7)
      }
      $1 == "file" && $5 == "fail" {
        if ($2 in failed) failed[$2] = failed[$2] "," js($4)
        else failed[$2] = js($4)
      }
      END {
        printf "{\"run\":%s,\"at\":%s,\"client\":%s,\"branch\":%s,\"commit\":%s,\"target\":%s,\"scope\":%s,\"complete\":%s,\"steps\":[",
          hdr("run"), num(h["at"]), hdr("client"), hdr("branch"), hdr("commit"), hdr("target"), hdr("scope"), (h["complete"] == "1" ? "true" : "false")
        for (i = 1; i <= n; i++) printf "%s%s,\"failed_files\":[%s]}", (i > 1 ? "," : ""), line[i], failed[name[i]]
        printf "]}\n"
      }' "$record"
    ;;
  log)
    log="${record%.record}.log"
    [ -r "$log" ] || { echo "devbox result: run $run saved no log at $log" >&2; exit 1; }
    # A step's section starts at the runner's header `== <step>: <log>` and
    # ends at the next header. The runner prints the log of a failed step only,
    # after its summary (section 6.3), and streams the log of a gate's one
    # running step after its header, before the summary.
    #
    # The header names the step's log file, <logs>/<run-id>/<step>.log, so a
    # header of this run holds this run's id, which no command of a step
    # prints. MEASURED: a section ended at any line that began with `== `, and
    # a step whose own output printed a header of its own, such as
    # `== check: one`, lost all but 2 lines of its log. A log with no header of its run is read by the older rule.
    #
    # The runner's transport lines never print: `devbox-steps: trace`,
    # `result` and `untraced` are for the record and the map. MEASURED: the
    # log of the last failed step ended in the base64 chunks of every trace.
    # The summary line ends a streamed section: the table that follows it is
    # the runner's. A streamed step's own output may print a summary line of a
    # runner it starts, so the cut is the last summary line of the file, and
    # only when no summary comes before the first header.
    section="$(RESULT_STEP="$step" RESULT_RUN="$run" awk '
      function header(line,   tail, k, s, name) {
        if (substr(line, 1, 3) != "== " || substr(line, length(line) - 3) != ".log") return 0
        tail = "/" ENVIRON["RESULT_RUN"] "/"
        k = index(line, tail)
        if (k == 0) return 0
        s = k + length(tail)
        name = substr(line, s, length(line) - 3 - s)
        if (name == "" || index(name, "/") > 0 || index(line, "== " name ": ") != 1) return 0
        hname = name
        return 1
      }
      function transport(line) { return line ~ /^devbox-steps: (trace|result|untraced) / }
      NR == FNR {
        if (!first && header($0)) first = FNR
        if ($0 == "devbox-steps: summary") { if (!first) early = 1; last = FNR }
        next
      }
      FNR == 1 { cut = (first && !early) ? last : 0 }
      first {
        if (cut && FNR >= cut) exit
        if (header($0)) {
          if (on) exit
          if (hname == ENVIRON["RESULT_STEP"]) { on = 1; print }
          next
        }
        if (on && !transport($0)) print
        next
      }
      index($0, "== " ENVIRON["RESULT_STEP"] ": ") == 1 { on = 1; print; next }
      on && (/^== / || /^devbox-steps: result /) { exit }
      on && !transport($0) { print }' "$log" "$log")"
    [ -n "$section" ] || {
      echo "devbox result: the log of run $run holds no section for step $step; the gate prints the log of a failed step only" >&2
      exit 1
    }
    printf '%s\n' "$section"
    ;;
esac
