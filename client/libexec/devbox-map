#!/bin/bash
# The map of each step: the repository files each test file and the step
# itself read when they last ran (docs/specs/2026-11-14-learned-selection-design.md,
# sections 5.5 and 5.6). Sourced by devbox-plan and devbox-verify, after
# lib/devbox-lib.sh and devbox-record.
# shellcheck shell=bash
#
# A step without `inputs=` hashed every synced file, so a Markdown edit ran the
# whole suite, and no project could write the list its tests read: a docs-only
# change that a project wrapper answered in seconds ran the whole suite, many
# minutes. The map holds what each
# test file and step really read, from the traces the runner sends back, so the
# plan hashes those files alone and runs only the test files a change reaches.
#
# One file per step and context, <git common dir>/devbox/maps/<step>.<ctx>.map
# (docs/specs/2026-11-16-gate-overload-design.md, section 6), one field per
# tab, written by rename. <ctx> is devbox_map_ctx of what the map's passes
# depend on, which devbox-plan chooses: the map base and the map's setup key
# for a runner step, the trace base for a step with no runner. The map's setup
# key is the setup key with the devbox client's own entries left out of each
# lock file (_devbox_plan_map_setup_key), so a client bump keeps the map.
# MEASURED: one map per step held one context, and worktrees of one checkout
# pinned three client versions, so each gate's update reset the other
# contexts' run ids, select answered "another context" for each of them, and
# about 4 in 10 runs of one project's test steps in a day ran in full. The
# format:
#
#   map       1
#   context   <map base>  <map's setup key>
#   untraced  <reason>                     the last run sent no usable trace
#   path      <id>  <repository path>
#   dir       <id>  <repository path>/
#   file      <test file>  <run-id of its last pass or ->  partial|complete  <ids>
#   step      <run-id of the step's last full trace or ->  partial|complete  <ids>  <traced under>
#
# <ids> is a comma list of path and dir ids, `-` for none, and the word
# `setup` marks a read under a setup output (node_modules/, .venv/). The
# `step` line holds the reads of the step's own process, the `-` owner of the
# trace; a runner step's inputs are those, every test file's reads and the test
# files themselves. The context is the map base (DEVBOX_TRACE_FORMAT, the
# config, the step line and the forwarded values) and the map's setup key the
# run had: a file's last pass proves nothing about a run under another context.
# <traced under> is the trace base, the hash of DEVBOX_TRACE_FORMAT, the config
# and the step line that step's own trace was taken under, `-` for none: strace
# made a type check and a lint run several times as long (learned-selection
# spec, P3), so a step is traced again only when one of those changed (D4).
#
# A legacy <step>.map, one map per step, is never read, written, renamed or
# removed (D10): a worktree on an older client still reads and writes it, and
# its context hashed the client VERSION, which no context here does.
#
# A test file's run id names the record whose manifest, `<run-id>.files`,
# holds the hashes of the tree it passed on. A record that was pruned leaves
# its files with no trace, so they run.

# The path of one manifest line, as awk reads it: `<sha256>  <path>`, or
# `\<sha256>  <path>` for a name sha256sum escapes, or `link <path> -> <target>`.
# shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
_DEVBOX_MAP_AWK_PATH='
function path_of(l,   p, k) {
  if (substr(l, 1, 5) == "link ") { p = substr(l, 6); k = index(p, " -> "); return k ? substr(p, 1, k - 1) : p }
  if (substr(l, 1, 1) == "\\") return substr(l, 68)
  return substr(l, 67)
}
'

# The reader of one map line, with FS a tab. A line that breaks the format sets
# m_bad, and the caller treats the whole map as unreadable: a map read in part
# would carry a step on reads it lost.
# shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
_DEVBOX_MAP_AWK_READ='
function map_line() {
  if ($1 == "map" && NF == 2) { if ($2 != "1") m_bad = "format " $2; return }
  if ($1 == "context" && NF == 3) { m_base = $2; m_setup = $3; return }
  if ($1 == "untraced" && NF == 2) { m_untraced = $2; return }
  if (($1 == "path" || $1 == "dir") && NF == 3 && $2 ~ /^[0-9]+$/ && $3 != "") {
    if (($1 == "dir") != ($3 ~ /\/$/)) { m_bad = "line " FNR; return }
    m_path[$2] = $3; return
  }
  if ($1 == "file" && NF == 5 && $2 != "" && $3 != "" && ($4 == "partial" || $4 == "complete") && $5 ~ /^(-|[0-9a-z,]+)$/) {
    if (!($2 in m_frun)) m_file[++m_nf] = $2
    m_frun[$2] = $3; m_fpart[$2] = $4; m_fids[$2] = $5; return
  }
  if ($1 == "step" && NF == 5 && $2 != "" && ($3 == "partial" || $3 == "complete") && $4 ~ /^(-|[0-9a-z,]+)$/ && $5 != "") {
    m_hasstep = 1; m_srun = $2; m_spart = $3; m_sids = $4; m_straced = $5; return
  }
  m_bad = "line " FNR
}
function map_ids_ok(ids,   n, a, i) {
  if (ids == "-") return 1
  n = split(ids, a, ",")
  for (i = 1; i <= n; i++) if (a[i] != "setup" && !(a[i] in m_path)) return 0
  return 1
}
function map_check(   i) {
  if (m_bad != "") return
  for (i = 1; i <= m_nf; i++) if (!map_ids_ok(m_fids[m_file[i]])) { m_bad = "an id of " m_file[i]; return }
  if (m_hasstep && !map_ids_ok(m_sids)) m_bad = "an id of the step line"
}
# True for a path that is an input of a key. The git database of a workspace,
# the `.git` file of a worktree and `.git-common/`, changes with every commit.
# A map an earlier client wrote held reads of `.git-common/refs/` from a test
# that ran git, and a commit selected that test (4.0.1 D3b).
function map_input(p) { return p !~ /^\.git(-common)?(\/|$)/ }
'

# Print <git common dir>/devbox/maps. The common dir, as for the records: a
# record of any worktree may be the last pass a map line names.
devbox_map_dir() {
  local common
  common="$(git rev-parse --path-format=absolute --git-common-dir)" || return 1
  printf '%s/devbox/maps\n' "$common"
}

# The format of the traces and of what a map records of them. The map base
# and the trace base hash it in place of the client VERSION (gate-overload
# spec, D11). Both hashed the VERSION, so every release, a patch included,
# reset the passes of every map, and traced each step with no runner again
# under strace, which made a type check and a lint run several times as long.
# Raise it when the trace, the map format or the meaning of a recorded read
# changes, as the 4.0.1 change that dropped the reads of .git-common/ did.
# shellcheck disable=SC2034  # read by devbox-plan, which sources this file
DEVBOX_TRACE_FORMAT=1

# The maps of one step a write keeps (D9). The maps of one measured project
# held tens of megabytes in all, so 8 contexts bound its directory to eight times that.
DEVBOX_MAP_KEEP=8

# devbox_map_ctx <value>...
# Print the context id of a map: the first 16 hex digits of the sha256 of the
# values, each followed by a newline. devbox-plan passes the map base and the
# map's setup key of a runner step, and the trace base of a step with no runner.
devbox_map_ctx() {
  local sum
  sum="$(printf '%s\n' "$@" | sha256sum)" || return 1
  printf '%s\n' "${sum:0:16}"
}

# The sed programs that print a manifest file with every line that names the
# devbox client left out, by the package's name and never by a version.
# package.json: its dependency line `"@launchwrighthq/devbox-client": "..."`.
# pyproject.toml: a key line `devbox-client = ...`, such as a uv or Poetry
# source, and each quoted array item `"devbox-client @ ..."`, alone on its
# line or among other items, with `_` or `.` for the `-`, as the name rule
# of Python packages allows. The character after the name must end it, so a
# package whose name only starts with it stays.
_DEVBOX_MAP_UNPIN_PACKAGE='/^[[:space:]]*"@launchwrighthq\/devbox-client"[[:space:]]*:/d'
_DEVBOX_MAP_UNPIN_PYPROJECT=$'/^[[:space:]]*["\']?devbox[-_.]client["\']?[[:space:]]*=/d\ns/"devbox[-_.]client([][ @;=<>!~(][^"]*)?"[[:space:]]*,?[[:space:]]*//g\ns/\'devbox[-_.]client([][ @;=<>!~(][^\']*)?\'[[:space:]]*,?[[:space:]]*//g'

# devbox_map_unpinned <manifest>
# Print, for each package.json and pyproject.toml of the manifest, at any
# depth, whose content names the devbox client, its manifest line with the
# sha256 of the file read through _DEVBOX_MAP_UNPIN_*, from the checkout in
# $PWD, where the manifest's paths start. A file that names no client prints
# nothing: its manifest line is already that hash. devbox-plan computes these
# lines once per gate, devbox_map_select compares them in place of the
# manifest's own, and devbox-plan keeps them as <run-id>.unpinned beside the
# record a map line names, so both sides of a comparison take one rule.
# MEASURED: a project pins the devbox client in package.json, and every vitest
# test file reads package.json, so after a client bump selection picked every
# test file with the reason `read package.json`. pytest reads pyproject.toml
# in its own process, which counts for every test file. The record key, the
# setup key and the sync keep the real hash.
devbox_map_unpinned() {
  local lines line path prog sum
  # awk picks the two names first, so the loop of bash reads below sees a few
  # lines, never every synced file of the manifest.
  lines="$(awk "$_DEVBOX_MAP_AWK_PATH"'{ p = path_of($0); n = split(p, c, "/"); if (c[n] == "package.json" || c[n] == "pyproject.toml") print }' "$1")" \
    || { echo "devbox verify: could not read the file list $1" >&2; return 1; }
  while IFS= read -r line; do
    [[ "$line" =~ ^[0-9a-f]{64}\ \ (.+)$ ]] || continue
    path="${BASH_REMATCH[1]}"
    case "${path##*/}" in
      package.json) prog="$_DEVBOX_MAP_UNPIN_PACKAGE" ;;
      pyproject.toml) prog="$_DEVBOX_MAP_UNPIN_PYPROJECT" ;;
      *) continue ;;
    esac
    grep -qE -- 'devbox[-_.]client' "$path" || {
      [ "$?" = 1 ] && continue
      echo "devbox verify: could not read $path, a file of the selection" >&2
      return 1
    }
    sum="$(set -o pipefail; sed -E "$prog" "$path" | sha256sum)" \
      || { echo "devbox verify: could not read $path, a file of the selection" >&2; return 1; }
    printf '%s  %s\n' "${sum%% *}" "$path"
  done <<<"$lines"
}

# Set the variable named $1 to the map file of step $2 under the context id
# $3. Returns 2 for a step name or a context id that breaks its rule: both
# become a file name, and the prune of D9 tells the maps of one step from
# another's by that rule alone.
_devbox_map_file() {
  local _dir
  if ! [[ "$2" =~ ^[a-z0-9][a-z0-9:_-]*$ ]] || ! [[ "$3" =~ ^[0-9a-f]{16}$ ]]; then
    echo "devbox verify: refusing the map of step '$2' under context '$3': a step name or a context id that breaks its rule" >&2
    return 2
  fi
  _dir="$(devbox_map_dir)" || return 1
  printf -v "$1" '%s/%s.%s.map' "$_dir" "$2" "$3"
}

# Remove the oldest maps of step $1 by modification time until
# DEVBOX_MAP_KEEP remain, the map $2 that was just written among them (D9).
# Only a name of the form <step>.<16 hex digits>.map is a context map of the
# step: a step name holds no dot, so another step whose name starts with this
# one, the legacy <step>.map and a temporary file all fail that form.
_devbox_map_prune() {
  local step="$1" keep="$2" dir f i oldest
  local -a maps=()
  dir="${keep%/*}"
  for f in "$dir/$step".*.map; do
    [[ "${f#"$dir/$step".}" =~ ^[0-9a-f]{16}\.map$ ]] || continue
    [ "$f" = "$keep" ] || maps+=("$f")
  done
  while [ "${#maps[@]}" -ge "$DEVBOX_MAP_KEEP" ]; do
    oldest=0
    for i in "${!maps[@]}"; do
      if [ "${maps[$i]}" -ot "${maps[$oldest]}" ]; then oldest="$i"; fi
    done
    rm -f -- "${maps[$oldest]}" || {
      echo "devbox verify: could not remove the old map ${maps[$oldest]} of step $step" >&2
      return 1
    }
    unset 'maps[$oldest]'
    maps=("${maps[@]}")
  done
}

# _devbox_map_awk <step> <ctx> <program> [<awk argument>...]
# Run the awk program over the map of the step under that context id after
# the map reader. The program sees every line through map_line, then its own
# END. Returns 1 when no map exists, 2 when the map cannot be read or breaks
# the format.
_devbox_map_awk() {
  local program="$3" file
  _devbox_map_file file "$1" "$2" || return 2
  shift 3
  [ -e "$file" ] || return 1
  [ -r "$file" ] || return 2
  awk -F'\t' "$_DEVBOX_MAP_AWK_READ"'
    { map_line() }
    END { map_check(); if (m_bad != "") exit 2; report() }
    '"$program" "$@" "$file"
}

# Each reader below takes <step> <ctx> and reads the map of that step under
# that context id alone: a run never reads the map of another context.
#
# Print `none`, `bad` or `ok` for the map of step $1.
devbox_map_state() {
  local rc=0
  _devbox_map_awk "$1" "${2-}" 'function report() { }' || rc=$?
  case "$rc" in 0) echo ok ;; 1) echo none ;; *) echo bad ;; esac
}

# Print the learned inputs of step $1, one per line in byte order: the paths
# and directories (with their `/`) its own process read, every test file's
# reads, and the test files. A directory stands for the names of its own
# entries, never for the content of the files under it: the key of devbox-plan
# hashes its listing. Exits 1 with no usable trace, and the step's key then
# covers every synced file: no map, a map that cannot be read, no step line,
# which a step whose trace never arrived has, or a partial step line, which a
# trace cut short leaves (4.0.1 D2a).
#
# A partial test file keeps its reads in the union (4.0.1 D2). Its trace
# missed what a child process read, and section 5.4 of the learned-selection
# spec selects it whenever any file its step read changed, which is this key.
# One partial file once gave its step every synced file as its key, so after
# a docs-only edit two suites selected about 10 % and 3 % of their test files
# as partial, and none of them read the edited file.
devbox_map_step_inputs() {
  local out
  out="$(_devbox_map_awk "$1" "${2-}" '
    function add(ids,   n, a, i) {
      n = split(ids, a, ",")
      for (i = 1; i <= n; i++) if ((a[i] in m_path) && map_input(m_path[a[i]])) print m_path[a[i]]
    }
    function report(   i) {
      if (!m_hasstep || m_spart == "partial") exit 1
      add(m_sids)
      for (i = 1; i <= m_nf; i++) { print m_file[i]; add(m_fids[m_file[i]]) }
    }')" || return 1
  [ -z "$out" ] || printf '%s\n' "$out" | LC_ALL=C sort -u
}

# True when step $1 or any of its test files read under a setup output, so the
# setup key belongs in its key (D4a).
devbox_map_reads_setup() {
  _devbox_map_awk "$1" "${2-}" '
    function report(   i) {
      if (("," m_sids ",") ~ /,setup,/) exit 0
      for (i = 1; i <= m_nf; i++) if (("," m_fids[m_file[i]] ",") ~ /,setup,/) exit 0
      exit 1
    }'
}

# Print the test files of step $1's map, in map order.
devbox_map_test_files() {
  _devbox_map_awk "$1" "${2-}" 'function report(   i) { for (i = 1; i <= m_nf; i++) print m_file[i] }'
}

# Print `<map base> <setup key>` of step $1's map.
devbox_map_context() {
  _devbox_map_awk "$1" "${2-}" 'function report() { if (m_base != "") print m_base " " m_setup }'
}

# Print the reason step $1's last run sent no usable trace, or nothing.
devbox_map_untraced() {
  _devbox_map_awk "$1" "${2-}" 'function report() { if (m_untraced != "") print m_untraced }'
}

# Print what step $1's own trace was taken under, the <traced under> of its
# step line. Exits 1 when it has no valid trace: no map, no step line, a step
# line no full run wrote, or a partial one, which missed what a child process
# read and must be taken again.
devbox_map_step_traced() {
  _devbox_map_awk "$1" "${2-}" '
    function report() {
      if (!m_hasstep || m_srun == "-" || m_spart == "partial" || m_straced == "-") exit 1
      print m_straced
    }'
}

# Print the run id of step $1's last full trace, or nothing.
devbox_map_step_run() {
  _devbox_map_awk "$1" "${2-}" 'function report() { if (m_hasstep && m_srun != "-") print m_srun }'
}

# devbox_map_select <step> <manifest> <ctx> [<map base> <setup key> [<unpinned>]]
# Print `<path>\t<reason>` for each test file of the map that this run must run,
# by section 6: `changed` when the file itself differs from its last pass,
# `no trace` when it never passed or its pass's manifest is gone, `partial`
# when its trace missed a child process, `read <path>` when a file it read
# differs or a directory it listed holds other entries. A path the step's own
# process read counts for every file. A test file the manifest no longer holds
# is gone and prints nothing.
#
# The caller calls it only when the step's key changed, so for a partial file
# an input of its step changed. It reads the map of context id <ctx>. With
# <map base> and <setup key>, it returns 3 when that map's context line names
# another context, because then a pass under the old context proves nothing.
# <unpinned> is devbox_map_unpinned of <manifest>: each of its lines stands for
# the manifest's line of that path, and the <run-id>.unpinned beside a pass's
# manifest does the same for that pass. A pass with no such file compares the
# manifest's own line.
# Returns 1 with no map, 2 for a map that cannot be read.
devbox_map_select() {
  local step="$1" manifest="$2" base="${4-}" setup="${5-}" unpinned="${6-}" file rdir rc=0 run
  local -a args=() unargs=()
  _devbox_map_file file "$step" "${3-}" || return 2
  [ -e "$file" ] || return 1
  [ -r "$file" ] && [ -r "$manifest" ] || return 2
  rdir="$(devbox_record_dir)" || return 2
  while IFS= read -r run; do
    # A run id that breaks the rule names no record file, so its test files
    # read as `no trace` and run.
    [[ "$run" =~ ^[0-9a-f]{8,32}\.[0-9]{1,10}$ ]] || continue
    [ -r "$rdir/$run.files" ] || continue
    args+=("phase=old" "R=$run" "$rdir/$run.files")
    [ ! -r "$rdir/$run.unpinned" ] || unargs+=("phase=unold" "R=$run" "$rdir/$run.unpinned")
  done < <(awk -F'\t' '$1 == "file" { print $3 }' "$file" | LC_ALL=C sort -u)
  MAP_BASE="$base" MAP_SETUP="$setup" awk -F'\t' "$_DEVBOX_MAP_AWK_PATH$_DEVBOX_MAP_AWK_READ"'
    function entries(p, into, r,   n, c, i, d) {
      n = split(p, c, "/"); d = "./"
      for (i = 1; i <= n; i++) {
        if (!((r, d, c[i]) in into)) { into[r, d, c[i]] = 1; cnt[r, d]++; kids[r, d] = kids[r, d] SUBSEP c[i] }
        d = (d == "./" ? "" : d) c[i] "/"
      }
    }
    function dir_changed(r, d,   n, k, i) {
      if ((r, d) in memo) return memo[r, d]
      memo[r, d] = 0
      if (cnt["", d] + 0 != cnt[r, d] + 0) return memo[r, d] = 1
      n = split(kids["", d], k, SUBSEP)
      for (i = 2; i <= n; i++) if (!((r, d, k[i]) in ent)) return memo[r, d] = 1
      return 0
    }
    phase == "map" { map_line(); next }
    phase == "cur" { p = path_of($0); cur[p] = $0; entries(p, ent, ""); next }
    phase == "old" { p = path_of($0); old[R, p] = $0; has[R] = 1; entries(p, ent, R); next }
    phase == "uncur" { p = path_of($0); if (p in cur) cur[p] = $0; next }
    phase == "unold" { p = path_of($0); if ((R, p) in old) old[R, p] = $0; next }
    END {
      map_check()
      if (m_bad != "") exit 2
      if (ENVIRON["MAP_BASE"] != "") {
        if (m_base != ENVIRON["MAP_BASE"]) exit 3
        if (m_setup != ENVIRON["MAP_SETUP"]) {
          if (("," m_sids ",") ~ /,setup,/) exit 3
          for (i = 1; i <= m_nf; i++) if (("," m_fids[m_file[i]] ",") ~ /,setup,/) exit 3
        }
      }
      own = ""
      n = split(m_sids, a, ",")
      for (i = 1; i <= n; i++) if ((a[i] in m_path) && m_path[a[i]] !~ /\/$/ && map_input(m_path[a[i]])) own = own "," a[i]
      for (i = 1; i <= m_nf; i++) {
        t = m_file[i]
        if (!(t in cur)) continue
        r = m_frun[t]
        if (r == "-" || !(r in has)) { print t "\tno trace"; continue }
        if (old[r, t] != cur[t]) { print t "\tchanged"; continue }
        if (m_fpart[t] == "partial") { print t "\tpartial"; continue }
        first = ""
        n = split(m_fids[t] own, a, ",")
        for (j = 1; j <= n; j++) {
          if (!(a[j] in m_path)) continue
          p = m_path[a[j]]
          if (!map_input(p)) continue
          if (p ~ /\/$/) { if (!dir_changed(r, p)) continue }
          else if (old[r, p] == cur[p]) continue
          if (first == "" || p < first) first = p
        }
        if (first != "") print t "\tread " first
      }
    }' phase=map "$file" phase=cur "$manifest" "${args[@]}" phase=uncur <(printf '%s' "$unpinned") \
    ${unargs[@]+"${unargs[@]}"} || rc=$?
  return "$rc"
}

# devbox_map_update <step> <run-id> <trace file> <mode> <ctx> [<map base> <setup key> [<traced under>]]
# Merge one run's trace into step <step>'s map of context id <ctx>, by rename,
# then prune the step's maps to DEVBOX_MAP_KEEP (D9). <trace file> holds
# the trace lines of section 5.6: `read`, `list`, `setup` and `partial`, each
# with its owner, a test file or `-` for the step's own process. <mode> is the
# plan's action: `run` makes this run the step's last full trace and replaces
# its own reads; `select` or `narrow` ran a part of the test files and adds to
# them; `resume` is the part run of a resumed gate. The record and the
# manifest of <run-id> give each test file's outcome and tell which test files
# are gone.
#
# A test file that ran replaces its own line, with this run id when it passed
# and `-` when it failed. A test file that is gone loses its line. A test file
# that did not run keeps its line, with `-` when the context changed, since its
# pass was under another context. Under `resume`, a test file with no trace
# this run whose record line says it passed keeps its reads and takes this run
# id, and one whose record line says it failed or was open takes `-`: the
# record of a resumed gate holds both parts of it, and the trace only the part
# after the stop (gate-fixes-4.0.1 spec, D4). MEASURED: the files that passed
# before a stop had the pass run `-` after the resume, because the map's
# context had changed since their last trace, and the next plan named each of
# them `no trace` and ran it again. A trace with no read at all, the trace of a
# step `strace` could not follow, keeps the earlier inputs and marks the map
# `untraced`, with the reason its `partial` line gives (section 5.3). A `run`
# with reads of the step's own process records <traced under> on the step line.
devbox_map_update() {
  local step="$1" run="$2" trace="$3" mode="$4" ctx="${5-}" base="${6-}" setup="${7-}" traced="${8:--}"
  local file dir rdir rec=/dev/null man=/dev/null old=/dev/null
  (require_run_id "$run" "the map of step $step") || return 2
  case "$mode" in run|select|narrow|resume) ;; *)
    echo "devbox verify: refusing the map mode '$mode' for step $step: write run, select, narrow or resume" >&2; return 2 ;;
  esac
  [ -r "$trace" ] || { echo "devbox verify: could not read the trace $trace of step $step, so its map did not change" >&2; return 1; }
  _devbox_map_file file "$step" "$ctx" || return
  dir="${file%/*}"
  if [ -e "$file" ]; then
    if [ "$(devbox_map_state "$step" "$ctx")" = ok ]; then
      old="$file"
    else
      echo "devbox verify: the map of step $step could not be read ($file), so this run's trace starts it again" >&2
    fi
  fi
  if rdir="$(devbox_record_dir)"; then
    [ ! -r "$rdir/$run.record" ] || rec="$rdir/$run.record"
    [ ! -r "$rdir/$run.files" ] || man="$rdir/$run.files"
  fi
  mkdir -p -- "$dir" || { echo "devbox verify: could not create $dir, so the map of step $step did not change" >&2; return 1; }
  # shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
  if ! MAP_STEP="$step" MAP_RUN="$run" MAP_MODE="$mode" MAP_BASE="$base" MAP_SETUP="$setup" MAP_TRACED="$traced" \
    awk -F'\t' "$_DEVBOX_MAP_AWK_PATH$_DEVBOX_MAP_AWK_READ"'
    # A path of the trace, relative to the root: "" to drop it, "\001" for a
    # read under a setup output. A path that leaves the checkout, or names its
    # .git, is no input a sync sends.
    function norm(p, kind,   n, c, i) {
      while (substr(p, 1, 2) == "./") p = substr(p, 3)
      if (kind == "list") {
        if (p == "" || p == "." || p == "/") return "./"
        if (p !~ /\/$/) p = p "/"
      }
      if (p == "" || p == "." || substr(p, 1, 1) == "/") return ""
      n = split(p, c, "/")
      # .git-common is the workspace copy of the git common dir. MEASURED: a
      # test that runs git recorded reads of .git-common/refs/ and
      # .git-common/worktrees/, so a commit would have selected it
      # (gate-fixes-4.0.1 spec, D3b).
      if (c[1] == ".git" || c[1] == ".git-common") return ""
      for (i = 1; i <= n; i++) {
        if (c[i] == "..") return ""
        if (c[i] == "node_modules" || c[i] == ".venv") return "\001"
      }
      return p
    }
    function owner_of(o) {
      if (o == "-") return o
      while (substr(o, 1, 2) == "./") o = substr(o, 3)
      if (o == "" || substr(o, 1, 1) == "/" || o ~ /(^|\/)\.\.(\/|$)/) return ""
      return o
    }
    function trace_line(   o, p) {
      o = owner_of($2)
      if (o == "") return
      if (!(o in seen)) { seen[o] = 1; if (o != "-") owners[++no] = o }
      if ($1 == "partial") { opart[o] = 1; if (reason == "") reason = $3; return }
      if ($1 == "setup") { osetup[o] = 1; data = 1; return }
      if ($1 != "read" && $1 != "list") return
      p = norm($3, $1)
      if (p == "\001") { osetup[o] = 1; data = 1; return }
      if (p == "") return
      if (!((o, p) in oread)) { oread[o, p] = 1; olist[o] = olist[o] SUBSEP p }
      data = 1
    }
    function id_of(p) {
      if (!(p in nid)) { nid[p] = ++nids; npath[nids] = p }
      return nid[p]
    }
    # The new id list of a string of paths joined by SUBSEP, and a setup flag.
    function ids_new(list, s,   n, a, i, out) {
      out = ""
      n = split(list, a, SUBSEP)
      for (i = 2; i <= n; i++) out = out "," id_of(a[i])
      if (s) out = out ",setup"
      return out == "" ? "-" : substr(out, 2)
    }
    # The new id list of an old id list.
    function ids_old(ids,   n, a, i, out) {
      if (ids == "-") return "-"
      out = ""
      n = split(ids, a, ",")
      for (i = 1; i <= n; i++) out = out "," (a[i] == "setup" ? "setup" : id_of(m_path[a[i]]))
      return out == "" ? "-" : substr(out, 2)
    }
    # The id lists $1 and $2 joined, each id once.
    function ids_join(x, y,   n, a, i, s, out) {
      out = ""
      n = split((x == "-" ? "" : x) "," (y == "-" ? "" : y), a, ",")
      for (i = 1; i <= n; i++) if (a[i] != "" && !(a[i] in s)) { s[a[i]] = 1; out = out "," a[i] }
      return out == "" ? "-" : substr(out, 2)
    }
    phase == "map" { map_line(); next }
    phase == "trace" { trace_line(); next }
    phase == "rec" {
      if ($1 == "step" && $2 == ENVIRON["MAP_STEP"]) stepout = $4
      if ($1 == "file" && $2 == ENVIRON["MAP_STEP"]) fout[$4] = $5
      next
    }
    phase == "man" { have_man = 1; man[path_of($0)] = 1; next }
    END {
      map_check()
      if (m_bad != "") exit 2
      run = ENVIRON["MAP_RUN"]; mode = ENVIRON["MAP_MODE"]
      print "map\t1"
      base = m_base; setup = m_setup; changed = 0
      if (ENVIRON["MAP_BASE"] != "") {
        changed = (base != ENVIRON["MAP_BASE"] || setup != ENVIRON["MAP_SETUP"])
        base = ENVIRON["MAP_BASE"]; setup = ENVIRON["MAP_SETUP"]
      }
      if (base == "") { base = "-"; setup = "-" }
      if (setup == "") setup = "-"
      print "context\t" base "\t" setup
      if (!data) {
        if (reason == "") reason = "the runner sent no trace"
        gsub(/\t/, " ", reason)
        print "untraced\t" reason
        changed = 0
      }
      nf = 0
      if (data) {
        for (i = 1; i <= no; i++) {
          t = owners[i]
          o = fout[t]
          if (o == "pass") r = run
          else if (o == "fail" || o == "open") r = "-"
          else r = (stepout == "pass" || stepout == "resumed") ? run : "-"
          fl[++nf] = "file\t" t "\t" r "\t" (opart[t] ? "partial" : "complete") "\t" ids_new(olist[t], osetup[t])
          done[t] = 1
        }
      }
      for (i = 1; i <= m_nf; i++) {
        t = m_file[i]
        if (t in done) continue
        if (have_man && !(t in man)) continue
        r = changed ? "-" : m_frun[t]
        if (mode == "resume" && (t in fout)) r = (fout[t] == "pass") ? run : "-"
        fl[++nf] = "file\t" t "\t" r "\t" m_fpart[t] "\t" ids_old(m_fids[t])
      }
      if (!data) {
        if (m_hasstep) sl = "step\t" m_srun "\t" m_spart "\t" ids_old(m_sids) "\t" m_straced
      } else if (mode == "run") {
        sl = "step\t" run "\t" (opart["-"] ? "partial" : "complete") "\t" ids_new(olist["-"], osetup["-"]) "\t" ENVIRON["MAP_TRACED"]
      } else {
        sids = ids_join(m_hasstep ? ids_old(m_sids) : "-", ids_new(olist["-"], osetup["-"]))
        sl = "step\t" (m_hasstep ? m_srun : "-") "\t" ((m_spart == "partial" || opart["-"]) ? "partial" : "complete") "\t" sids "\t" (m_hasstep ? m_straced : "-")
      }
      for (i = 1; i <= nids; i++) print (npath[i] ~ /\/$/ ? "dir" : "path") "\t" i "\t" npath[i]
      for (i = 1; i <= nf; i++) print fl[i]
      if (sl != "") print sl
    }' phase=map "$old" phase=trace "$trace" phase=rec "$rec" phase=man "$man" >"$dir/.$step.map.$$" \
    || ! mv -f -- "$dir/.$step.map.$$" "$file"; then
    rm -f -- "$dir/.$step.map.$$"
    echo "devbox verify: could not write the map of step $step to $file, so the next plan of it uses the last map" >&2
    return 1
  fi
  # The map is written, and a map the prune could not remove costs disk alone:
  # the prune named it, and the result of this update stands.
  _devbox_map_prune "$step" "$file" || :
}
