#!/bin/bash
# Run this checkout's gate on a devbox and return its exit code.
#
# The agent-facing command does not change: `make verify` and `npm run verify`
# reach this as `devbox verify`, through a guard that takes the vendored client
# first (.venv/bin, node_modules/.bin, vendor/devbox/client/bin) and PATH second, and
# read 0 or non-zero exactly as before. A machine that has neither, every CI
# runner included, keeps running the gate locally.
#
# Output is streamed, never buffered. Both gates take minutes and print
# progress, and an agent watching a silent terminal assumes a hang.
set -euo pipefail

# ── DEVBOX_STRICT=1: for a caller that trusts the exit code ─────────────────
#
# A caller that reads this code as "the remote gate ran" was misled in three
# cases. A missing .devbox.env, DEVBOX_ENABLED=0 and a full
# queue with DEVBOX_QUEUE_FULL_ACTION=local ran the gate on the LAPTOP and
# returned its code. The file's DEVBOX_HOST replaced the host the caller named.
# And devbox's own codes shared one space with the gate's, so a gate that exits
# 7 read as an OOM kill. Strict mode refuses every local fallback with 64, lets
# the environment win over .devbox.env, and moves devbox's own codes to 64 to 79.
# Without it nothing changes, because other projects pin this client and read
# the plain codes. The fallbacks are a missing .devbox.env, a file that
# names no target, and rule 5 of the target choice (DEVBOX_QUEUE_FULL_ACTION=local).
#
# Read from the environment once, here, before anything can exit: .devbox.env
# cannot switch it, because the caller that needs it is not the developer.
STRICT=0
[ "${DEVBOX_STRICT:-}" = 1 ] && STRICT=1
# 1 from the moment the gate's own process runs: from then on the exit status is
# the gate's, and strict mode passes it through unmapped.
GATE_OWNS_EXIT=0
# 1 when devbox chose the exit code itself. Every deliberate `exit N` goes through
# devbox_die, which sets it, and so does every argument guard in the library
# (devbox_guard_exit). A step that dies under set -e leaves it 0, and that
# is the only way the trap can tell the two apart: rsync exits 1 to 6 on its
# own, and DEVBOX_SETUP exits with whatever the project's command returns. A
# reviewer probe read rsync's 3 as 67 (unreachable), its 5 as 69
# (handshake), and its 7 as 71 with a false ::devbox-infra::oom.
OWN_EXIT=0
# What kind of 3 or 8 this is, for the strict map alone. The plain codes keep
# one number for several causes, and strict mode splits two of them: a refused
# gate password or a changed host key (`auth`) is a repair for a person, while
# an unreachable target is a wait; and an 8 caused by the queue (`queue`) is
# named as that event.
EXIT_KIND=""
devbox_die() { OWN_EXIT=1; EXIT_KIND="${2:-}"; exit "$1"; }
# The one map from a plain code to its strict code. It prints the code to exit
# with, and names an oom, queue, watchdog, pool-ticket or pool-deadline event on stderr as
# ::devbox-infra::<name>, which a driver reads beside the code. A non-zero code
# that devbox did not choose is a step that died under set -e (a sync, the
# project's setup, an ssh): that is not the gate's result, so it is 65 with no
# infra line, whatever its number.
# Called only from the EXIT traps here and in devbox-runpod, so the linter reads
# its body as unreachable.
# shellcheck disable=SC2317
devbox_exit_code() {
  local code="$1"
  if [ "$STRICT" != 1 ] || [ "$GATE_OWNS_EXIT" = 1 ] || [ "$code" = 0 ]; then
    printf '%s' "$code"; return 0
  fi
  if [ "$OWN_EXIT" != 1 ]; then
    echo "devbox verify: a step before the gate stopped with status $code" >&2
    printf 65; return 0
  fi
  case "$code" in
    64) ;;
    1) code=65 ;;
    2) code=66 ;;
    # 3 is every target unreachable, or the gate password refused (or a host
    # key changed) on every target. A driver retries the first and must stop
    # for a person on the second, so the second has its own code.
    3) if [ "$EXIT_KIND" = auth ]; then code=75; else code=67; fi ;;
    4) code=68 ;;
    5) code=69 ;;
    6) code=70 ;;
    7) code=71; echo '::devbox-infra::oom' >&2 ;;
    # 8 is "no target can take this gate". The queue line comes only when the
    # queue is the cause: a ceiling that ran out, or a pool that can never
    # grant. A target that is down or degraded is not a queue event.
    8) code=72; [ "$EXIT_KIND" != queue ] || echo '::devbox-infra::queue' >&2 ;;
    9) code=73 ;;
    # The watchdog on the target stopped the gate. Like an OOM kill,
    # the gate did not run to its end, so this is devbox's report, never the
    # gate's result. 74 and 75 were taken, so it is 76.
    10) code=76; echo '::devbox-infra::watchdog' >&2 ;;
    # The pool lost this gate's queue ticket and could not put it back. The
    # gate never ran, so this is devbox's report too.
    11) code=77; echo '::devbox-infra::pool-ticket' >&2 ;;
    # The pool released the grant because the gate did not start within
    # DEVBOX_HOLD_PREP_SECONDS: the sync and the setup run under the grant, and
    # a stuck client must not keep tokens that other runs wait for. The gate
    # did not run, so the code must never read as a test result.
    12) code=78; echo '::devbox-infra::prep-limit' >&2 ;;
    75) code=74; echo '::devbox-infra::pool-deadline' >&2 ;;
    *) echo "devbox verify: a step before the gate stopped with status $code" >&2; code=65 ;;
  esac
  printf '%s' "$code"
}
# The map is applied in the EXIT trap, so it covers every devbox_die below and
# every set -e death with one call site. Without strict it returns, and bash keeps the
# original status. $1 is the cleanup armed further down, once there is one.
# The map runs BEFORE that cleanup. The lock's release once ran `exec 8>&-
# 2>/dev/null`, which sends this shell's stderr to /dev/null for good. MEASURED:
# with the map after the cleanup, the ::devbox-infra:: line of every
# run that reached the lock never reached the caller. No close below carries a
# redirection for that reason.
# shellcheck disable=SC2317
devbox_on_exit() {
  local rc=$? code
  code="$(devbox_exit_code "$rc")"
  # The run file of `devbox status` goes with the run. Guarded, because a run
  # that ends before devbox-transport is sourced has no such function.
  ! declare -F devbox_runfile_remove >/dev/null || devbox_runfile_remove
  [ -z "${1:-}" ] || "$1"
  [ "$STRICT" = 1 ] || return 0
  exit "$code"
}
trap devbox_on_exit EXIT

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
# The shared library is the compatibility surface between the two halves, so it
# is resolved rather than assumed: beside the checkout or package two levels up,
# and /usr/local/lib/devbox on a provisioned server, where the server installer puts it.
_here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
DEVBOX_LIB=""
for _c in "$_here/../../lib/devbox-lib.sh" /usr/local/lib/devbox/devbox-lib.sh; do
  [ -r "$_c" ] && { DEVBOX_LIB="$_c"; break; }
done
[ -n "$DEVBOX_LIB" ] || { echo "devbox verify: no devbox-lib.sh beside $_here or in /usr/local/lib/devbox" >&2; devbox_die 1; }
# shellcheck source=/dev/null
source "$DEVBOX_LIB"
# shellcheck source=client/libexec/devbox-config
source "$_here/devbox-config"
# Sourced here, and not beside devbox-targets below, because the run file of
# `devbox status` lives in its private dir, and a run forced to RunPod writes
# its `rent` phase before this script reaches the targets.
# shellcheck source=client/libexec/devbox-transport
source "$_here/devbox-transport"
# Here and not beside the sync below: the ledger key reads the sync's own file
# list before any target is joined, and the local fallback reads it too.
# shellcheck source=client/libexec/devbox-sync
source "$_here/devbox-sync"

# ── the arguments ────────────────────────────────────────────────────────────
#
# `devbox run -- <command>` arrives here as `--run <command>`. The command crosses
# as one line on stdin, quoted with %q, so no word of it is parsed by the laptop
# shell, the ssh login shell or devbox-pool before the workspace bash reads it.
#
# `--target <name>` forces one target: a deployed one from DEVBOX_TARGETS,
# `runpod` or `hetzner`. `devbox runpod up|status|down` arrives as
# `--runpod-action <action>`, which manages the rental and forces the runpod
# target, and `devbox hetzner up|status|down` arrives as `--hetzner-action
# <action>` in the same way. `--runpod` was an older
# spelling of that target, and it is refused by name rather than read as an
# unknown word, so a script that still passes it is told what replaced it.
#
# `--fresh` ignores and discards the ledger of an unfinished gate of this
# worktree, and runs the gate in full (resumable gates spec, section 5).
RUNPOD_ACTION=""
HETZNER_ACTION=""
RUN_MODE=0
RUN_SCRIPT=""
LOCAL_ONLY=0
FORCE_TARGET=""
FRESH=0
refuse_args() { echo "devbox verify: $*" >&2; devbox_die 2; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --run) RUN_MODE=1; shift ;;
    --runpod-action)
      RUNPOD_ACTION="${2:-status}"
      FORCE_TARGET=runpod
      shift; [ "$#" -eq 0 ] || shift ;;
    --hetzner-action)
      HETZNER_ACTION="${2:-status}"
      case "$HETZNER_ACTION" in up|status|down) ;; *) refuse_args "devbox hetzner: use up, status or down" ;; esac
      FORCE_TARGET=hetzner
      shift; [ "$#" -eq 0 ] || shift ;;
    --runpod)
      refuse_args "--runpod is no longer read. Run 'devbox verify --target runpod', or 'devbox runpod up|status|down' to manage the rental." ;;
    --local) LOCAL_ONLY=1; shift ;;
    --fresh) FRESH=1; shift ;;
    --target)
      [ -n "${2:-}" ] || refuse_args "--target needs a name: a target in DEVBOX_TARGETS, runpod or hetzner"
      FORCE_TARGET="$2"; shift 2 ;;
    --target=*)
      FORCE_TARGET="${1#--target=}"
      [ -n "$FORCE_TARGET" ] || refuse_args "--target needs a name: a target in DEVBOX_TARGETS, runpod or hetzner"
      shift ;;
    --) shift; break ;;
    *)
      [ "$RUN_MODE" = "1" ] && break
      refuse_args "unknown argument '$1'. usage: devbox verify [--local | --target <name>] [--fresh]" ;;
  esac
done
if [ "$RUN_MODE" = "1" ]; then
  [ "$#" -gt 0 ] || { echo "devbox run: name a command: devbox run [--target <name>] -- <command> [args]" >&2; devbox_die 2; }
  [ "$LOCAL_ONLY" = "0" ] || { echo "devbox run: a run never runs on this machine, so it takes no --local" >&2; devbox_die 2; }
  [ "$FRESH" = "0" ] || { echo "devbox run: a run keeps no ledger, so it takes no --fresh" >&2; devbox_die 2; }
  RUN_SCRIPT="$(printf '%q ' "$@")"
fi
[ "$LOCAL_ONLY" = "0" ] || [ -z "$FORCE_TARGET" ] || refuse_args "--local and --target name two places; pass one"
# `devbox runpod|hetzner up|status|down` manage a rental and run no gate, so
# they keep no run file for devbox status.
[ -z "$RUNPOD_ACTION$HETZNER_ACTION" ] || DEVBOX_RUNFILE_OFF=1
RUNFILE_MODE=verify
[ "$RUN_MODE" = "0" ] || RUNFILE_MODE=run

# A run has no local fallback: the laptop load it exists to remove is what a
# fallback would put back. Every path below that would run here refuses instead.
run_local() {
  if [ "$RUN_MODE" = "1" ]; then
    echo "devbox run: NOT running '$RUN_SCRIPT' on this machine: no target is configured for $ROOT (.devbox.env missing, or it sets neither DEVBOX_TARGETS nor DEVBOX_RENT)." >&2
    devbox_die 2
  fi
  # A gate on this laptop is not a run on a target, and its own output is in
  # the developer's terminal: the run file of a fallback goes now.
  devbox_runfile_remove
  OWN_EXIT=1
  devbox_config_load
  OWN_EXIT=0
  ledger_local
  GATE_OWNS_EXIT=1
  DEVBOX_LEDGER="$LOCAL_LEDGER" DEVBOX_RESUME=0 DEVBOX_LEDGER_TOOLS="$DEVBOX_LEDGER_TOOLS_DIR" \
    bash -c "$(devbox_hooks_script)"$'\n''devbox_environment && devbox_verify'
}
# A gate on this laptop gets the contract of a remote one (resumable gates
# spec, section 4.1): the tools from this client's own client/share/ledger/,
# and a fresh ledger in the private dir. A gate script that calls the tools
# would otherwise fail here on an unset DEVBOX_LEDGER_TOOLS, and only here.
# Nothing resumes on this laptop: no watchdog stops a local gate. The file is
# named after a hash of the checkout path, so two worktrees keep two ledgers.
LOCAL_LEDGER=""
ledger_local() {
  local dir root_sum key
  dir="$(devbox_ledger_dir)" || {
    echo "devbox verify: the private dir holds no ledgers directory this user owns, so the gate has no ledger to write and did not run" >&2
    devbox_die 1
  }
  root_sum="$(printf '%s' "$ROOT" | sha256sum)" || { echo "devbox verify: sha256sum failed, so the gate has no ledger name and did not run" >&2; devbox_die 1; }
  LOCAL_LEDGER="$dir/local-${root_sum:0:16}.ledger"
  ledger_key_of key "$dir/none.$$" || key=-
  ( umask 077; printf 'key\t%s\nresume\t0\n' "$key" >"$LOCAL_LEDGER" ) || {
    echo "devbox verify: could not write $LOCAL_LEDGER, so the gate did not run" >&2
    devbox_die 1
  }
}
# Set the variable named $1 to the ledger key (spec section 3.2), from the
# forwarded names after $2. $2 is a path that does not exist, the dry run's
# destination. Returns 1 with a line on stderr when a step of the key fails: a
# key that left out what it could not read would match a ledger written under
# other inputs.
ledger_key_of() {
  local _var="$1" _dest="$2" _sum
  shift 2
  _sum="$(devbox_ledger_key_input "$_here/../../VERSION" "$_dest" "$@" | sha256sum)" || {
    echo "devbox verify: could not compute the ledger key (the client version, the file list of the sync, .devbox/config.env or a forwarded value could not be read)" >&2
    return 1
  }
  printf -v "$_var" '%s' "${_sum%% *}"
}
# The one guard every FALLBACK passes before it calls run_local. `--local` is a
# person's choice and does not pass here. In strict mode a fallback exits 64 and
# nothing runs, because the caller would read a laptop result as a remote one.
local_fallback_guard() {
  [ "$STRICT" = 1 ] || return 0
  echo "devbox verify: DEVBOX_STRICT=1 refuses to run the gate on this machine: $1. Nothing ran." >&2
  devbox_die 64
}

[ "$LOCAL_ONLY" = "1" ] && { run_local; exit $?; }

# ── the developer's .devbox.env ──────────────────────────────────────────────
#
# devbox_env_find holds the lookup and its incident: a linked worktree borrows
# the main checkout's file, because a worktree holds no gitignored file.
#
# The file is DATA, read by devbox_env_load, and never sourced. An older client
# sourced it, so a gate password that held `$`, a quote or a backtick broke the
# run, or ran as code on this laptop. The loader also unsets every key before it
# reads the file: a value exported by some earlier shell must not stand in for a
# line the file is missing, and an exported RUNPOD_KEY once did.
DEVBOX_ENV="$(devbox_env_find "$ROOT")" || DEVBOX_ENV=""
if [ -z "$DEVBOX_ENV" ]; then
  if [ -n "$FORCE_TARGET" ]; then
    echo "devbox verify: --target $FORCE_TARGET needs a .devbox.env in $ROOT or beside its git common dir; nothing ran" >&2
    devbox_die 2
  fi
  local_fallback_guard "no .devbox.env in $ROOT"
  [ "$RUN_MODE" = "1" ] || echo "devbox verify: no .devbox.env in $ROOT, running the gate locally" >&2
  run_local; exit $?
fi
# In strict mode the environment wins over .devbox.env, for each DEVBOX_* key
# of the file's list and each DEVBOX_TARGET_<NAME>. devbox_env_load reads the
# pairs after the file and checks them like its lines. A key only the file sets
# still comes from the file. RUNPOD_KEY and HCLOUD_TOKEN are not DEVBOX_* names,
# so they come only from the file, in both modes.
DEVBOX_ENV_KEEP=()
if [ "$STRICT" = 1 ]; then
  devbox_env_keep_from_environment
fi
devbox_env_load "$DEVBOX_ENV" || devbox_die 2
if [ -z "$FORCE_TARGET" ] && [ "${#DEVBOX_DEPLOYED[@]}" -eq 0 ] && [ "${#DEVBOX_RENTED[@]}" -eq 0 ]; then
  local_fallback_guard "$DEVBOX_ENV sets neither DEVBOX_TARGETS nor DEVBOX_RENT"
  [ "$RUN_MODE" = "1" ] || echo "devbox verify: $DEVBOX_ENV sets neither DEVBOX_TARGETS nor DEVBOX_RENT, running the gate locally" >&2
  run_local; exit $?
fi
case "$FORCE_TARGET" in
  "") ;;
  runpod)
    [ -n "${RUNPOD_KEY:-}" ] || { echo "devbox runpod: RUNPOD_KEY is missing from $DEVBOX_ENV; nothing ran" >&2; devbox_die 2; } ;;
  hetzner)
    [ -n "${HCLOUD_TOKEN:-}" ] || { echo "devbox hetzner: HCLOUD_TOKEN is missing from $DEVBOX_ENV; nothing ran" >&2; devbox_die 2; } ;;
  *)
    case " ${DEVBOX_DEPLOYED[*]} " in *" $FORCE_TARGET "*) ;; *)
      echo "devbox verify: --target $FORCE_TARGET: $DEVBOX_ENV lists no such target. Its DEVBOX_TARGETS are: ${DEVBOX_DEPLOYED[*]:-none}; runpod and hetzner are the rented ones; nothing ran" >&2
      devbox_die 2 ;;
    esac ;;
esac
if [ "$FORCE_TARGET" = runpod ] || [ "$FORCE_TARGET" = hetzner ] || [ "${#DEVBOX_RENTED[@]}" -gt 0 ]; then
  # A rental key is read only from this file, and it reaches no child: the
  # loader set it without export, and readonly keeps a later line from
  # replacing it.
  [ -z "${RUNPOD_KEY:-}" ] || readonly RUNPOD_KEY
  [ -z "${HCLOUD_TOKEN:-}" ] || readonly HCLOUD_TOKEN
fi
# devbox_config_load refuses a bad config.env with `return 2`, which ends this
# script through set -e. The flag makes that 2 devbox's own config code.
OWN_EXIT=1
devbox_config_load
OWN_EXIT=0

# ── one rule per value that crosses to the host ─────────────────────────────
#
# require_safe_name, require_env_name, is_uint, require_uint and
# require_safe_token live in lib/devbox-lib.sh since protocol 6, beside the
# incidents that shaped each rule, because devbox-gate and gate-root apply the
# same rules on the host. This name starts every refusal they print here. Since
# protocol 6 each refusal also sets OWN_EXIT, so strict mode maps its 2 to 66.
DEVBOX_GUARD_WHO="devbox verify"

if [ "$RUNPOD_ACTION" = down ] || [ "$RUNPOD_ACTION" = status ]; then
  # shellcheck source=/dev/null
  source "$_here/devbox-runpod"
  devbox_die "$?"
fi
# The rented Hetzner server is a target this run reaches with the gate
# transport, so devbox-hetzner defines functions and runs nothing when sourced.
# `status` and `down` need only the API.
if [ "$FORCE_TARGET" = hetzner ] || [[ " ${DEVBOX_RENTED[*]-} " == *" hetzner "* ]]; then
  # shellcheck source=client/libexec/devbox-hetzner
  source "$_here/devbox-hetzner"
fi
if [ "$HETZNER_ACTION" = down ] || [ "$HETZNER_ACTION" = status ]; then
  hetzner_rc=0
  hetzner_action "$HETZNER_ACTION" || hetzner_rc=$?
  devbox_die "$hetzner_rc"
fi

require_safe_name "DEVBOX_PROJECT" "${DEVBOX_PROJECT:-}" "$DEVBOX_CONFIG"
# DEVBOX_WANT_TOKENS and DEVBOX_MIN_TOKENS come from that same committed file,
# and the last ssh in this script sends both to the `run` verb, which hands them
# to `devbox-pool run` as root on the shared devbox. Before the gate account that
# was one command string a root shell parsed. Read with a default, because
# `set -u` kills an unguarded read: a profile that omits one died on the echo
# below with "unbound variable" instead of naming the file to fix. devbox-gate,
# gate-root and devbox-pool apply this same rule on their own side, and those
# checks do not make this one redundant: a refusal here names the file to fix
# before anything has crossed.
require_uint "DEVBOX_WANT_TOKENS" "${DEVBOX_WANT_TOKENS:-}" "$DEVBOX_CONFIG"
require_uint "DEVBOX_MIN_TOKENS" "${DEVBOX_MIN_TOKENS:-}" "$DEVBOX_CONFIG"
# The gate's wall-clock limit. The watchdog on a deployed target stops
# a gate that runs past it. MEASURED: pytest runs spun at 100% of one core in
# an endless loop until a person noticed, and no rule bounded a gate's wall
# clock. Checked here, by the rule devbox-gate and gate-root apply again, so a
# refusal names the file to fix before anything has crossed.
# The default is 7200. At 3600, large gates on a busy host ran at their CPU
# limit for most of the hour, so a slow gate that still did work came close to
# the stop. The stall rule still stops a gate that does no work, whatever this
# limit says.
GATE_MAX_SECONDS="${DEVBOX_GATE_MAX_SECONDS:-7200}"
require_gate_max_seconds "$GATE_MAX_SECONDS" "$DEVBOX_CONFIG"
# A run is one test file or one scenario, so it asks for the floor and leaves
# the rest of the shared pool to the gates queued behind it.
GRANT_WANT="$DEVBOX_WANT_TOKENS"
[ "$RUN_MODE" = "1" ] && GRANT_WANT="$DEVBOX_MIN_TOKENS"

# ── Git LFS pointers, before anything reaches the host ──────────────────────
#
# The sync below is rsync of the WORKING TREE, so a checkout that never ran
# `git lfs pull` ships each LFS file as its 130-byte pointer text. The gate on
# the host then reads that text as the file, whatever the file claims to be.
# A checkout that never ran `git lfs pull` ships pointer text, and the gate
# reads that text as content. So this is refused here, while nothing on the
# host has been created.
#
# Only a path a `.gitattributes` routes through `filter=lfs` is read, and only
# its first 42 bytes: a pointer text outside such a path is ordinary content.
lfs_pointers() {
  local path _attr value head42
  git grep -q 'filter=lfs' -- ':(glob).gitattributes' ':(glob)**/.gitattributes' || return 0
  git ls-files -z | git check-attr -z --stdin filter |
    while IFS= read -r -d '' path && IFS= read -r -d '' _attr && IFS= read -r -d '' value; do
      if [ "$value" != "lfs" ] || [ ! -f "$path" ] || [ -L "$path" ]; then continue; fi
      # NUL bytes are dropped before the substitution: a real binary has them in
      # its first 42 bytes, and bash warned "ignored null byte in input" once per
      # such file on every run. A pointer holds no NUL, so the test is unchanged.
      head42="$(head -c 42 -- "$path" | tr -d '\000')"
      if [ "$head42" = "version https://git-lfs.github.com/spec/v1" ]; then printf '%s\n' "$path"; fi
    done
}
# A failed read is refused too: an empty answer from a broken git would pass
# every pointer through as though the tree held none.
pointers="$(lfs_pointers)" || {
  echo "devbox verify: could not list the Git LFS paths in $ROOT (git ls-files or git check-attr failed), so this run cannot prove it ships no pointer file" >&2
  devbox_die 9
}
if [ -n "$pointers" ]; then
  {
    echo "devbox verify: refusing to sync ${DEVBOX_PROJECT}: these files are Git LFS pointers, not their content, and rsync would ship the pointer text to the target:"
    printf '%s\n' "$pointers" | head -n 20 | sed 's/^/  /'
    echo "  $(printf '%s\n' "$pointers" | wc -l) file(s) in all. Run 'git lfs pull' in $ROOT, then verify again."
    echo "  git-lfs missing? apt install git-lfs (Debian, Ubuntu) or brew install git-lfs (macOS), then 'git lfs install --local'."
  } >&2
  devbox_die 9
fi

# ── the developer's queue settings ───────────────────────────────────────────
#
# Both keys are validated even when the feature is off, because a typo in a
# gitignored file is otherwise a preference that silently does nothing.
QUEUE_WAIT="${DEVBOX_MAX_QUEUE_WAIT:-0}"
# It lands in `devbox-pool run --max-wait $N`, one string that runs as root on
# the shared devbox, and in a bash arithmetic context below. Same rule, and the
# same reason, as DEVBOX_WANT_TOKENS above.
require_uint "DEVBOX_MAX_QUEUE_WAIT" "$QUEUE_WAIT" "$DEVBOX_ENV"
QUEUE_ACTION="${DEVBOX_QUEUE_FULL_ACTION:-fail}"
case "$QUEUE_ACTION" in
  local|fail) ;;
  *) echo "devbox verify: refusing DEVBOX_QUEUE_FULL_ACTION '$QUEUE_ACTION' from $DEVBOX_ENV: write local, or fail, which is the default" >&2; devbox_die 2 ;;
esac
# A run waits for its tokens with no ceiling: the ceiling's only purpose is the
# local fallback, and a run has none.
[ "$RUN_MODE" = "1" ] && QUEUE_WAIT=0
# The head start of the target that ran this worktree last (spec section 3.2):
# its workspace is warm, so its run syncs the changed files and skips most of
# the setup, where another target uploads the whole checkout and runs the full
# setup. 0 turns it off. It lands in bash arithmetic below, so it is checked
# like the ceiling.
AFFINITY_GRACE="${DEVBOX_AFFINITY_GRACE:-60}"
require_uint "DEVBOX_AFFINITY_GRACE" "$AFFINITY_GRACE" "$DEVBOX_ENV"
# The lane wait on each target. It lands in the `lock` verb, a word the host
# checks again, and in bash arithmetic below, a context that evaluates
# whatever text it is given. An operator exporting it by hand is one typo away
# from either.
LOCK_WAIT="${DEVBOX_LOCK_WAIT:-3600}"
require_uint "DEVBOX_LOCK_WAIT" "$LOCK_WAIT" "the environment"

# ── what this project needs from the workspace image ─────────────────────────
#
# A project's first remote run reported green after a set of its tests errored
# on an image that lacked a required system tool, and the skip count changed
# with no warning. A gate that is quietly weaker
# than the local one is worse than no remote gate, so the image is proven before
# the sync rather than assumed.
#
# Space separated, which is the format the profile commits. The array is read
# first and checked second, so no token reaches a host before every token has
# passed: this list is committed, so any contributor edits it, and each token
# was once part of one command string that another machine's shell parsed as
# root. Each one now crosses as one word of the `check-requires` verb, which
# devbox-gate and gate-root check again.
#
# Unset means the project declares nothing, and then the probe asks nothing. A
# project that has not adopted the key must not start paying an ssh for it.
REQUIRES=()
if [ -n "${DEVBOX_REQUIRES:-}" ]; then
  read -r -a REQUIRES <<<"$DEVBOX_REQUIRES" || true
  for tok in ${REQUIRES[@]+"${REQUIRES[@]}"}; do
    require_safe_token "a DEVBOX_REQUIRES token" "$tok" "$DEVBOX_CONFIG"
  done
fi

# Run the gate HERE instead, but only when this machine can really run it.
#
# This is the one local path a BUSY MACHINE chooses on the developer's behalf.
# `verify --local` and a .devbox.env that names no target are paths a PERSON
# chose, and they are deliberately left alone. A fallback that ran here
# without checking would reproduce the incident this project exists to prevent,
# tests ERRORING under a green gate, reached through queue depth
# instead of through a missing image.
#
# It returns 1 when the fallback is REFUSED, and never returns at all when it
# is taken. A caller reading that 1 keeps waiting on a target, because a slow
# gate is a cost and a weak gate is a wrong answer.
#
# FALLBACK_FROM names what this run would have used instead: one target, or
# "the targets" when none could take the gate. FALLBACK_STAY is the line a
# refused fallback ends with, and it never promises a wait that will not happen:
# with no target to wait on, the run exits 8 after it.
FALLBACK_FROM="the targets"
FALLBACK_STAY="so the gate does not run here, and no target can take it either."
queue_fallback() {
  local why="$1" out="" rc=0 checked_requires=0
  # DEVBOX_REQUIRES cannot express this. Its three token forms are a path, a
  # name on PATH and a version pin, and none of them can say "a provisioned
  # Postgres role with its DSN exported". The remote path is the only one that
  # provisions that, further down this file where ensure-workspace runs, so a
  # fallback here used to call run_local with no $DEVBOX_DB_URL_VAR set at
  # all. MEASURED: a project skipped its database tests and still exited 0
  # that way. This machine cannot provision what the
  # workspace provisions, and there is no way to ask a laptop whether it
  # already has one configured by hand, so this is refused the same way an
  # unmet DEVBOX_REQUIRES token is refused below: never probe for one, just
  # stay remote and say what is missing. `devbox verify --local` is the
  # escape hatch for a developer who knows their own machine is fine.
  if [ "${DEVBOX_NEEDS_POSTGRES:-0}" = "1" ]; then
    {
      echo "devbox verify: NOT running $DEVBOX_PROJECT's gate on this machine."
      echo "  $why"
      # Defaulted to the KEY'S OWN NAME rather than read bare. A profile that
      # sets DEVBOX_NEEDS_POSTGRES=1 and no DEVBOX_DB_URL_VAR is one somebody
      # half-edited, and under `set -u` a bare read ends the run with a raw
      # "unbound variable" in the middle of the sentence explaining why the
      # gate stayed remote. The developer then loses the refusal that names
      # the file to fix, which is the same failure the DEVBOX_WANT_TOKENS read
      # above records against itself.
      echo "  DEVBOX_NEEDS_POSTGRES=1 in $DEVBOX_CONFIG: a gate here would run with \$${DEVBOX_DB_URL_VAR:-DEVBOX_DB_URL_VAR} unset, because only a target provisions the Postgres role and database behind it."
      echo "  MEASURED: a project skipped its database tests and still exited 0 that way."
      echo "  $FALLBACK_STAY"
      echo "  run 'devbox verify --local' if you know this machine already has one configured, or raise DEVBOX_MAX_QUEUE_WAIT in $DEVBOX_ENV."
    } >&2
    return 1
  fi
  if [ "${#REQUIRES[@]}" -gt 0 ]; then
    checked_requires=1
    # Reached through bash and its real path, not through the CLI on PATH: a
    # wheel install carries no exec bit, and a PATH lookup would find
    # whichever client another project vendored.
    out="$(bash "$_here/devbox-requires-local" "${REQUIRES[@]}" 2>&1)" || rc=$?
    if [ "$rc" -ne 0 ]; then
      {
        echo "devbox verify: NOT running $DEVBOX_PROJECT's gate on this machine."
        echo "  $why"
        printf '%s\n' "$out"
        echo "  a gate here would skip or ERROR the tests those requirements cover, and could still report green: that is what DEVBOX_REQUIRES exists to stop."
        echo "  $FALLBACK_STAY"
        echo "  install what is missing here, or raise DEVBOX_MAX_QUEUE_WAIT in $DEVBOX_ENV."
      } >&2
      return 1
    fi
  fi
  # Here and not at the top: a fallback refused above keeps waiting on a target,
  # which is what strict mode wants, so only the run_local below is refused.
  local_fallback_guard "$why, and DEVBOX_QUEUE_FULL_ACTION=local would run it here"
  {
    echo "devbox verify: running $DEVBOX_PROJECT's gate on THIS machine instead of $FALLBACK_FROM."
    echo "  $why"
    # States what was actually checked, never "covers the same code as the
    # remote one": that equivalence claim is exactly what DEVBOX_NEEDS_POSTGRES
    # disproves above, and an empty or all-whitespace DEVBOX_REQUIRES used to
    # reach this line having checked nothing at all while it was still
    # reported as "every token is satisfied here".
    if [ "$checked_requires" -eq 1 ]; then
      echo "  every DEVBOX_REQUIRES token is satisfied here: $DEVBOX_REQUIRES. DEVBOX_NEEDS_POSTGRES is not set, so nothing else about this machine was checked."
    else
      echo "  DEVBOX_REQUIRES names nothing to check here, and DEVBOX_NEEDS_POSTGRES is not set, so nothing about this machine was checked before running its gate."
    fi
  } >&2
  run_local
  exit $?
}

if [ "$FORCE_TARGET" = runpod ]; then
  devbox_runfile_phase rent runpod - "$ROOT" "$RUNFILE_MODE"
  # shellcheck source=/dev/null
  source "$_here/devbox-runpod"
  devbox_die "$?"
fi

MACHINE_ID="$(devbox_machine_id)"
MACHINE="$(devbox_machine_label)"
# Every lane of this worktree, lane 1 first (spec section 5). The `lock` verb
# takes them in this order on each target, so lane 2 is used only while lane 1
# is busy. Lane 1 keeps the slug of protocol 2, so every warm workspace stays
# warm, and it labels this worktree's history on every target: the pool records
# the duration of every lane under it.
LANE_TEXT="$(devbox_lane_slugs "$MACHINE" "$MACHINE_ID" "$DEVBOX_PROJECT" "$ROOT" "$DEVBOX_LANES")"
mapfile -t LANE_SLUGS <<<"$LANE_TEXT"
SLUG="${LANE_SLUGS[0]}"
HISTORY_SLUG="$SLUG"
# The run id, `<hash of the machine id>.<pid>`, in every ticket this run holds
# and in its run file, so `devbox status` shows one run that waits on three
# targets once. devbox_run_id_prefix says why it is a hash. require_run_id is
# the host's rule, applied before anything crosses.
RUN_ID="$(devbox_run_id_prefix "$MACHINE_ID")" || {
  echo "devbox verify: cannot hash this machine's id into a run id: sha256sum failed" >&2
  devbox_die 2
}
RUN_ID="$RUN_ID.$$"
require_run_id "$RUN_ID" "this machine's id"
DEVBOX_RUNFILE_RUN="$RUN_ID"

# Every call below goes to the gate account through devbox-transport, sourced
# at the top: one verb and its words, never a command string for a remote
# shell. devbox-targets probes every deployed target and chooses one.
# shellcheck source=client/libexec/devbox-targets
source "$_here/devbox-targets"
devbox_targets_check || devbox_die 2

# ── the handshake, this laptop's half ────────────────────────────────────────
#
# Asked of every deployed target, before anything is synced or created, as the
# first two words of its probe line. Client and server each read
# DEVBOX_PROTOCOL_VERSION from their OWN copy of the shared library, and the
# release major moves with it, so a host of another major answers with a
# different number here. The second field, the library's sha256, is a report:
# a laptop on one minor release and a host on another load different bytes of
# one protocol, and that is how releases are meant to roll out.
#
# A protocol mismatch refuses that target rather than warns, because the damage
# is silent and shared. devbox_slug names the container, the volume, the Postgres role and
# the database, and devbox_pg_ident truncates that slug from the left to fit
# Postgres's 63-byte limit, keeping the last seven characters because they are
# the only part that tells two worktrees apart. A client and a server that
# disagree about either algorithm put two checkouts on ONE Postgres role while
# their container names stay distinct, which is the collision devbox_pg_ident's
# own comment records as already having happened once. A warning would be read
# after both gates had written to the same database.
#
# The parse and the comparison are devbox_handshake_verdict's, in the shared
# library, called by devbox_select. Three hand-written copies of one protocol
# rule is what left devbox-gc's copy a field behind, so that it read a correct
# two-field answer as no version at all and exited 5 on every run.
#
# The function is guarded rather than called blind, because a library copy on
# THIS laptop that predates the handshake carries neither DEVBOX_PROTOCOL_VERSION
# nor this function. An unguarded read of that variable died with a raw "unbound
# variable" under `set -u`, and an unguarded call reports "command not found":
# either way the one case the handshake exists to explain was the one case it
# could not report. A stale library here is a client-side repair, which no
# `devbox server install` can make, so this names that fix.
if ! declare -F devbox_handshake_verdict >/dev/null 2>&1; then
  echo "devbox verify: $DEVBOX_LIB carries no devbox_handshake_verdict, so this client predates the handshake. Reinstall or update the devbox client on this machine." >&2
  devbox_die 5
fi

# ── the joins: a lane and a place in the queue of every eligible target ──────
#
# A run waits in the queue of every eligible target at once and runs on the
# first whose pool grants (spec section 3). MEASURED: tickets waited up to tens
# of minutes in the queue of a full target while a second target ran at about a
# third of its CPU, because the target was chosen once from a probe and the
# choice was final.
#
# One join per target, each a background job with its own target selected:
#   1. `lock <wait> <lane slugs>`: the host takes the first free lane of this
#      worktree and answers `LOCKED <slug>`, then holds that lane's flock until
#      the session's stdin ends. A dropped laptop drops the session, and the
#      lock with it, with no stale state to reap.
#   2. `run` in hold mode: the pool queues as it always did, and at its grant
#      prints `devbox-pool: held <granted> <want>` on stderr and waits for one
#      line on stdin. `go` starts the gate in the process that holds the grant;
#      `abort`, or the end of stdin, releases the grant at once.
# The first `held` line read wins. Every other join is aborted on the spot, so
# a duplicate grant costs one poll of tokens on the other host.
#
# This shell holds both stdins: one fifo each, opened read-write, so neither
# open blocks on the other end and a fifo keeps what is written to it until the
# job's ssh reads it. Every job closes every fd this shell opened for another
# join first, or that join's stdin would never reach its end.
JOIN_DIR=""
JOINED=()
JOIN_FDS=()
JOIN_T0=""
WINNER=""
declare -A JOIN_LOCK_FD=() JOIN_RUN_FD=() JOIN_PID=() JOIN_STATE=()

# The job of one join. $1 the target, $2 the max wait the pool is sent. It
# writes what happened into its directory: `lane` once it holds one, `end`
# when it stopped before a run, and `run.rc` when its run ended. `run.err` is
# a copy of the run's stderr, which also reaches the developer as it streams.
#
# Every `kill` here names a process that may have ended already, and that end
# is the one asked for, so its "no such process" is dropped with 2>/dev/null.
# `set +e`: each status here is read as data, and a job that died on one would
# leave its join neither ended nor running.
#
# Braces, not a subshell body, and only ever started with `&`, which forks the
# one process that runs it. A `( ... )` body forked twice, and the first
# process held every fd this shell had opened while it waited for the second:
# MEASURED, the gate's stdin never reached its end, and the run hung after
# `go`.
# shellcheck disable=SC2317  # started in the background by join_start
join_job() {
  set +e
  local name="$1" maxwait="$2" d="$JOIN_DIR/$1" f answer slug lpid rpid efd tpid n
  for f in "${JOIN_FDS[@]}"; do exec {f}>&-; done
  # The address was checked by devbox_targets_check, and its message went out
  # then; this second use only selects the target in this job.
  devbox_target_use "$name" >/dev/null 2>&1 || { echo "its address is not an address" >"$d/end"; exit 0; }
  join_fifo_reader "$d/lock.in"
  devbox_gate_spawn lock "$LOCK_WAIT" "${LANE_SLUGS[@]}" <&"$JOIN_READER" >"$d/lock.out" 2>"$d/lock.err" \
    || { echo "the lock could not be sent" >"$d/end"; exit 0; }
  exec {JOIN_READER}<&-
  lpid="$GATE_SPAWN_PID"
  answer=""
  while :; do
    answer="$(sed -n '/^LOCKED/{p;q;}' "$d/lock.out")"
    [ -z "$answer" ] || break
    if [ -e "$d/abort" ]; then kill -KILL "$lpid" 2>/dev/null; exit 0; fi
    if ! kill -0 "$lpid" 2>/dev/null; then
      # A LOCKED line written just before the exit is read once more.
      answer="$(sed -n '/^LOCKED/{p;q;}' "$d/lock.out")"
      [ -n "$answer" ] || { echo lock >"$d/end"; exit 0; }
      break
    fi
    sleep 0.2
  done
  slug="${answer#LOCKED}"
  slug="${slug# }"
  # The host answers with one of the slugs it was sent. Anything else is not a
  # lane of this worktree, and a run in it would take another workspace's tree.
  # A bare LOCKED is the answer of a lock with no lanes: it ends the join here,
  # where waiting for a lane name would hold the lane and this run forever.
  case " ${LANE_SLUGS[*]} " in *" ${slug:-?} "*) ;; *)
    echo "the lock answered '$answer', which names no lane of this worktree" >"$d/end"
    exit 0 ;;
  esac
  printf '%s\n' "$slug" >"$d/lane.tmp" && mv -f "$d/lane.tmp" "$d/lane"
  [ ! -e "$d/abort" ] || exit 0
  exec {efd}> >(tee "$d/run.err" >&2)
  tpid=$!
  join_fifo_reader "$d/run.in"
  devbox_gate_spawn run "$slug" "$DEVBOX_PROJECT" "$GRANT_WANT" "$DEVBOX_MIN_TOKENS" "$maxwait" \
    "$GATE_MAX_SECONDS" "$GATE_MODE" "$HISTORY_SLUG" "$RUN_ID" <&"$JOIN_READER" 2>&"$efd" \
    || { exec {efd}>&-; echo "the run could not be sent" >"$d/end"; exit 0; }
  exec {JOIN_READER}<&-
  rpid="$GATE_SPAWN_PID"
  printf '%s\n' "$rpid" >"$d/run.pid"
  exec {efd}>&-
  while kill -0 "$rpid" 2>/dev/null; do
    if [ -e "$d/abort" ]; then
      # A held grant ends on the abort line at once. A pool still in its queue
      # reads no stdin, so the session is dropped: SIGKILL, because ssh prints
      # a line on any signal it catches, and this run's terminal is not the
      # place for it.
      n=0
      while kill -0 "$rpid" 2>/dev/null && [ "$n" -lt 5 ]; do sleep 0.2; n=$((n + 1)); done
      kill -KILL "$rpid" 2>/dev/null
      break
    fi
    sleep 0.2
  done
  wait "$rpid"
  printf '%s\n' "$?" >"$d/run.rc.tmp"
  # The tee must have written its last line before run.rc says the run ended.
  # Bounded, because a killed ssh's child may still hold the pipe, and a job
  # that never ends holds this run's exit.
  n=0
  while kill -0 "$tpid" 2>/dev/null && [ "$n" -lt 25 ]; do sleep 0.2; n=$((n + 1)); done
  kill "$tpid" 2>/dev/null
  mv -f "$d/run.rc.tmp" "$d/run.rc"
}

# Open fifo $1 read-only in JOIN_READER, for a job's ssh, without blocking. A
# plain `<fifo` blocks until some process holds the write end, and this shell
# closes its end when it aborts the join: a join aborted before its job reached
# that open would hang the job, and with it this run's exit. The job's own
# read-write open is the writer for that one moment, and it closes it at once,
# so the reader still sees the end of the stream when this shell closes its end.
JOIN_READER=""
join_fifo_reader() {
  local rw
  exec {rw}<>"$1"
  exec {JOIN_READER}<"$1"
  exec {rw}>&-
}

# Join one target: its two fifos, its fds, its job. $1 the target, $2 the max
# wait for its pool, $3 the line that says why it is joined.
join_start() {
  local name="$1" d="$JOIN_DIR/$1" lfd rfd
  rm -rf "$d"
  mkdir -m 700 "$d"
  mkfifo -m 600 "$d/lock.in" "$d/run.in"
  exec {lfd}<>"$d/lock.in"
  exec {rfd}<>"$d/run.in"
  JOIN_FDS+=("$lfd" "$rfd")
  JOIN_LOCK_FD[$name]="$lfd"
  JOIN_RUN_FD[$name]="$rfd"
  join_job "$name" "$2" &
  JOIN_PID[$name]=$!
  JOIN_STATE[$name]=lock
  JOINED+=("$name")
  [ -n "$JOIN_T0" ] || JOIN_T0="$SECONDS"
  echo "==> devbox: queuing on $name$3"
}

# Close one fd of a join, once. No redirection on the close: see devbox_on_exit.
join_close_fd() {
  local fd="$1"
  [ -n "$fd" ] || return 0
  exec {fd}>&-
}

# Leave one join: its lane, its place in the queue, or its held grant. The
# abort mark comes first, so a job that holds a lane and has not yet sent `run`
# never sends it.
join_abort() {
  local name="$1" d="$JOIN_DIR/$1" rfd
  [ "${JOIN_STATE[$name]-}" != gone ] || return 0
  : >"$d/abort"
  rfd="${JOIN_RUN_FD[$name]-}"
  if [ -n "$rfd" ]; then
    printf 'abort\n' >&"$rfd"
    join_close_fd "$rfd"
  fi
  join_close_fd "${JOIN_LOCK_FD[$name]-}"
  JOIN_RUN_FD[$name]=""
  JOIN_LOCK_FD[$name]=""
  JOIN_STATE[$name]=gone
}

# Every join ends, and its job with it: the EXIT trap and a ceiling that ran
# out. The winner's lane is released here too, so it is called at exit only
# once the gate is over.
# shellcheck disable=SC2317  # reached through cleanup_probe, from the EXIT trap
join_release_all() {
  local name
  for name in ${JOINED[@]+"${JOINED[@]}"}; do
    join_abort "$name"
  done
  for name in ${JOINED[@]+"${JOINED[@]}"}; do
    wait "${JOIN_PID[$name]}" 2>/dev/null || true  # the job's own status is in its directory
  done
  JOINED=()
  JOIN_FDS=()
  JOIN_T0=""
}

# Why one join ended without a grant, as one phrase. The host's first line
# says why, when it printed one; grep finds none in an empty file, and the
# phrase then goes without it, so its status 1 is no failure.
join_end_reason() {
  local d="$JOIN_DIR/$1" rc line
  if [ -e "$d/end" ]; then
    IFS= read -r line <"$d/end" || true
    if [ "$line" = lock ]; then
      line="$(grep -m1 . "$d/lock.err" || true)"
      printf 'no lane of %s was free%s' "$SLUG" "${line:+ ($line)}"
    else
      printf '%s' "$line"
    fi
    return 0
  fi
  read -r rc <"$d/run.rc" || rc="?"
  line="$(grep -m1 . "$d/run.err" || true)"
  printf 'its run ended with status %s before a grant%s' "$rc" "${line:+ ($line)}"
}

# The joined targets that still wait, joined by $1.
join_live() {
  local sep="$1" name out=""
  for name in ${JOINED[@]+"${JOINED[@]}"}; do
    case "${JOIN_STATE[$name]}" in lock|queued) out="$out${out:+$sep}$name" ;; esac
  done
  printf '%s' "$out"
}

# Wait for the first grant. $1 the ceiling in seconds, 0 for none, counted from
# the first join. GRACE_REST holds the targets that join once GRACE_UNTIL (a
# SECONDS value) has passed, or once the grace target left the run.
#   0  WINNER is set
#   1  the ceiling ran out
#   2  every join ended without a grant
GRACE_REST=()
GRACE_UNTIL=0
GRACE_TARGET=""
join_wait() {
  local ceiling="$1" name d phase targets last="" now
  while :; do
    for name in ${JOINED[@]+"${JOINED[@]}"}; do
      case "${JOIN_STATE[$name]}" in lock|queued) ;; *) continue ;; esac
      d="$JOIN_DIR/$name"
      # No run.err until the join holds a lane and sent its run: grep's
      # "no such file" then means "not held yet", which the test already says.
      if grep -q '^devbox-pool: held ' "$d/run.err" 2>/dev/null; then
        WINNER="$name"
        return 0
      fi
      if [ -e "$d/end" ] || [ -e "$d/run.rc" ]; then
        JOIN_STATE[$name]=ended
        echo "==> devbox: $name left this run: $(join_end_reason "$name")"
        continue
      fi
      [ ! -e "$d/lane" ] || JOIN_STATE[$name]=queued
    done
    if [ "${#GRACE_REST[@]}" -gt 0 ]; then
      if [ "$SECONDS" -ge "$GRACE_UNTIL" ] || [ "${JOIN_STATE[$GRACE_TARGET]-}" = ended ]; then
        echo "==> devbox: no grant on $GRACE_TARGET within the grace, so this run joins the other targets"
        for name in "${GRACE_REST[@]}"; do join_start_target "$name"; done
        GRACE_REST=()
        continue
      fi
    fi
    targets="$(join_live +)"
    [ -n "$targets" ] || return 2
    phase=lock
    for name in ${JOINED[@]+"${JOINED[@]}"}; do
      [ "${JOIN_STATE[$name]}" != queued ] || phase=queued
    done
    if [ "$phase $targets" != "$last" ]; then
      devbox_runfile_phase "$phase" "$targets" "$SLUG"
      last="$phase $targets"
    fi
    now="$SECONDS"
    if [ "$ceiling" -gt 0 ] && [ $((now - JOIN_T0)) -ge "$ceiling" ]; then
      return 1
    fi
    sleep 0.2
  done
}

# ── choose the target ────────────────────────────────────────────────────────
#
# Every deployed target is probed at once, with a 3-second connect timeout and
# a limit on each ssh after it (DEVBOX_PROBE_ANSWER_SECONDS), and
# devbox_select takes the first selection rule that matches. A forced target
# is probed alone, and the unreachable cache is not read for it: a person who
# names a target wants that target asked.
#
# The question is asked while nothing has been spent. A developer who met a long
# queue only at the acquire had already paid for a container, a Postgres role, a
# full rsync and an `npm ci`, and abandoning to a local gate threw all of it
# away. The answer is an ESTIMATE and never a reservation, and the queue moves
# while a run waits. So the probe only says which targets are eligible, and
# the run then waits in the queue of every one of them and takes the first
# grant (the joins further down). The ceiling counts from the first join.
PROBE_DIR="$(mktemp -d)" || { echo "devbox verify: mktemp -d failed; refusing to probe without a directory for the answers" >&2; devbox_die 1; }
# A Hetzner server this run created and never saw ready is deleted here too.
# Every join ends first: its lane lock, its place in a queue, or its held grant.
# shellcheck disable=SC2317  # reached through the EXIT trap below, never by name
cleanup_probe() {
  join_release_all
  devbox_targets_close_all
  rm -rf "$PROBE_DIR"
  if declare -F hetzner_cleanup >/dev/null; then hetzner_cleanup || true; fi
}
# Through devbox_on_exit, because a second `trap ... EXIT` replaces the first,
# and the strict map at the top must still run beside this cleanup.
trap 'devbox_on_exit cleanup_probe' EXIT
SELECT_TARGETS=("${DEVBOX_DEPLOYED[@]}")
SELECT_RENT=(${DEVBOX_RENTED[@]+"${DEVBOX_RENTED[@]}"})
SELECT_AFFINITY="$(devbox_affinity_read)"
use_cache=1
if [ -n "$FORCE_TARGET" ]; then
  SELECT_TARGETS=("$FORCE_TARGET"); SELECT_RENT=(); SELECT_AFFINITY=""; use_cache=0
fi
SELECT_GRACE="$AFFINITY_GRACE"
SELECT_ACTION="$QUEUE_ACTION"
# A run has no local fallback, so rule 5 never applies to it.
[ "$RUN_MODE" = "0" ] || SELECT_ACTION=fail
SELECT_LIB="$DEVBOX_LIB"
SELECT_MIN="$DEVBOX_MIN_TOKENS"
DEVBOX_PROBE_REQUIRES=(${REQUIRES[@]+"${REQUIRES[@]}"})
[ "${#REQUIRES[@]}" -eq 0 ] || echo "==> image requirements: ${REQUIRES[*]}"
choose_target() {
  # The target is named in the run file once the probe asks one target alone.
  local probe_target=-
  [ "${#SELECT_TARGETS[@]}" -ne 1 ] || [ "${#SELECT_RENT[@]}" -ne 0 ] || probe_target="${SELECT_TARGETS[0]}"
  devbox_runfile_phase probe "$probe_target" "$SLUG" "$ROOT" "$RUNFILE_MODE"
  FACTS=""
  if [ "${#SELECT_TARGETS[@]}" -gt 0 ]; then
    FACTS="$(devbox_targets_probe "$GRANT_WANT" "$DEVBOX_MIN_TOKENS" "$PROBE_DIR" "$use_cache" "${SELECT_TARGETS[@]}")" || devbox_die 2
  fi
  # The first contact records a host key, and only the one its pin names
  # (devbox_gate_pin), so the line says which key a later run will hold the
  # host to.
  while read -r f_name f_kind f_key; do
    [ "$f_kind" = newkey ] || continue
    devbox_target_use "$f_name"
    echo "==> recorded the pinned host key of $f_name ($TARGET_ADDR): $f_key"
  done <<<"$FACTS"
  SELECTION="$(printf '%s\n' "$FACTS" | sed '/^$/d' | devbox_select)"
  DECISION="${SELECTION##*$'\n'}"
  read -r d_kind d_name d_rule _ <<<"$DECISION"
}
# The rented Hetzner server becomes a target once it answers, and the choice then
# runs on it alone: rules 1, 2, 3, 5 and 6, as for any forced target. The probe
# proves its handshake, its health, DEVBOX_REQUIRES and its queue, like a deployed
# target's. A rented target is never recorded for affinity.
hetzner_target() {
  devbox_runfile_phase rent hetzner "$SLUG" "$ROOT" "$RUNFILE_MODE"
  hetzner_ready || devbox_die "$?"
  if [ "$HETZNER_ACTION" = up ]; then
    echo "==> devbox: the Hetzner server of this checkout is up; no gate ran"
    devbox_die 0
  fi
  SELECT_TARGETS=(hetzner); SELECT_RENT=(); SELECT_AFFINITY=""; use_cache=0
}

# One line per skipped target, never a silent skip. The same lines
# name each target in the refusal when no target can take the gate.
skip_lines() {
  local prefix="$1" kind name _class text
  while read -r kind name _class text; do
    [ "$kind" = skip ] || continue
    printf '%s%s %s\n' "$prefix" "$name" "$text"
  done <<<"$SELECTION"
}
target_addr() { local var="DEVBOX_TARGET_${1^^}"; printf '%s' "${!var-}"; }
# How the server half of one target is brought up to this client. A rented
# Hetzner server is a snapshot, so its repair is a new snapshot and a new server.
repair_hint() {
  if [ "$1" = hetzner ]; then
    printf "The Hetzner snapshot is older than this client: the operator of the server half rebuilds it, then 'devbox hetzner down' deletes this checkout's server so that the next run creates one from it."
  else
    printf "Run 'devbox server install' for %s (%s)." "$1" "$(target_addr "$1")"
  fi
}

# The refusals a person must act on, with the code each had when a client knew
# one host. They name every target, because each one needs the same repair.
refuse_handshake() {
  local name kind line verdict vrc
  while read -r name kind line; do
    [ "$kind" = probe ] || continue
    devbox_probe_parse "$line" || true
    vrc=0
    verdict="$(devbox_handshake_verdict "$PROBE_PROTOCOL${PROBE_LIB:+ $PROBE_LIB}" "$DEVBOX_LIB")" || vrc=$?
    case "$vrc" in
      # A stale library on THIS laptop, which no `devbox server install` repairs.
      1) echo "devbox verify: $verdict. Reinstall or update the devbox client on this machine." ;;
      # Nothing, or an answer that is not a version at all: a host whose
      # devbox-gate predates the probe verb refuses it as an unknown verb, and
      # an older devbox-runner prints its usage to stderr and exits 2, so both
      # shapes reach this client. An older host has no devbox-gate account, so it
      # fails at the login with exit 3 and never reaches this line.
      3|5) echo "devbox verify: $name: $verdict. $name's devbox-runner is missing, or it predates the handshake or the probe. $(repair_hint "$name")" ;;
      # A server on another protocol. The library's line names both integers.
      0) echo "devbox verify: $name: its probe answer is not a line this client reads. $(repair_hint "$name")" ;;
      *) echo "devbox verify: $name: $verdict. $(devbox_protocol_repair "$(repair_hint "$name")")" ;;
    esac
  done <<<"$FACTS"
}
refuse_requires() {
  local name kind _rc
  while read -r name kind _rc; do
    [ "$kind" = requires ] || continue
    # The verb's exit status is the verdict and its output is the evidence,
    # relayed verbatim rather than parsed: it names the image and each unmet
    # token, and only the server knows which image it runs. Parsing a format the
    # server owns would break this refusal every time that format gained a line,
    # and a refusal that lost its detail is a refusal nobody can act on.
    echo "devbox verify: refusing to run $DEVBOX_PROJECT's gate on $name: its workspace image does not satisfy the DEVBOX_REQUIRES in $DEVBOX_CONFIG."
    if [ -s "$PROBE_DIR/$name.requires" ]; then
      cat "$PROBE_DIR/$name.requires"
    else
      # A verb that fails without a word would otherwise produce a refusal that
      # names no token and no image. Say what was asked instead, so the reader
      # can run the same check by hand.
      echo "devbox-runner check-requires exited $_rc and printed nothing; it was asked about: ${REQUIRES[*]}"
    fi
  done <<<"$FACTS"
  echo "devbox verify: the fix is in the DEPLOYMENT and not in this project. Add the missing feature to the deployment config of each target and redeploy it with the server's deploy.sh."
}
# The strict kind of an 8 (see EXIT_KIND): `queue` when every skipped target
# was skipped for its pool alone, never able to grant, and
# nothing when one was down, degraded or unreachable.
queue_kind() {
  local kind _name class _text n=0
  while read -r kind _name class _text; do
    [ "$kind" = skip ] || continue
    case "$class" in never) n=$((n + 1)) ;; *) return 0 ;; esac
  done <<<"$SELECTION"
  [ "$n" -eq 0 ] || printf queue
}
refuse_none() {
  echo "devbox verify: no target can take this gate:"
  skip_lines "  "
  echo "  the gate did not run, here or there."
}

# ── what crosses with the gate ───────────────────────────────────────────────
#
# Fixed before any target is joined, so a value this run refuses is refused
# before a lane or a grant is held for it.
#
# The hooks cross on stdin; the workspace bash expands each entry after reading
# them. gate-root holds the entry, `eval "$(cat)" && devbox_environment &&
# devbox_setup`, as a fixed string, so nothing on this line reaches a shell as
# code except through the workspace bash that reads stdin.
HOOKS="$(devbox_hooks_script)"
# A run swaps devbox_verify for its own command after the hooks on stdin. The
# mode word says which, and gate-root holds both entries as fixed strings: the
# command itself never enters this argv.
GATE_MODE=verify
GATE_STDIN="$HOOKS"
if [ "$RUN_MODE" = "1" ]; then
  GATE_MODE="command"
  GATE_STDIN="$HOOKS"$'\n'"devbox_environment && $RUN_SCRIPT"
fi
GATE_ENV=()

# ── the switches a project asks to carry over ────────────────────────────────
#
# DEVBOX_FORWARD_ENV is a committed list of NAMES in .devbox/config.env, never
# values. The project says which of its own switches make sense on a devbox; the
# developer's environment says what they are on this run.
#
# Before this, the gate ran with `-e DEVBOX_TOKENS -e PYTEST_WORKERS` and
# nothing else, so `EXAMPLE_SLOW_TIER=1 make verify` set a variable on the LAPTOP that
# never arrived. The run looked ordinary and the tier it asked for stayed off,
# which is worse than a refusal: the only way to use such a switch was to run
# the gate locally, and a local gate is what this tool exists to remove.
#
# NAMES are checked and values are not, and that asymmetry is the point. A name
# becomes the left side of a line in an env file on the host, so it is refused
# unless it is an environment variable name and nothing else; the host checks
# it again. A value never becomes an argument anywhere: it travels the way the
# DSN does, on stdin into a file the gate reads with --env-file, so no shell on
# either host ever parses it.
#
# A value holding a newline is refused rather than escaped. An env file is one
# NAME=value per line, so a newline forges a second assignment, and no project
# switch is worth carrying that.
#
# An unset name is skipped in silence. The list is what a project CAN forward,
# not what this run must have, so a developer who sets none of them pays one
# loop and nothing else. devbox_forward_name in devbox-config holds the rest of
# the rule: a .devbox.env key is refused by name, and only an EXPORTED variable
# crosses, because the loader keeps the gate password as a shell variable.
if [ -n "${DEVBOX_FORWARD_ENV:-}" ]; then
  fwd_names=()
  read -r -a fwd_names <<<"$DEVBOX_FORWARD_ENV" || true
  fwd_crossed=""
  for fwd_name in "${fwd_names[@]}"; do
    devbox_forward_name "$fwd_name" || continue
    case "${!fwd_name}" in
      *$'\n'*)
        echo "devbox verify: refusing to forward $fwd_name: its value holds a newline, and an env file is one NAME=value per line" >&2
        devbox_die 2 ;;
    esac
    GATE_ENV+=("$fwd_name=${!fwd_name}")
    fwd_crossed="$fwd_crossed $fwd_name"
  done
  if [ -n "$fwd_crossed" ]; then
    # Names only. A value may be a switch today and a token tomorrow, and this
    # line is read from a terminal a screen share can see.
    echo "==> forwarding to the gate:$fwd_crossed"
  fi
fi

# ── the ledger: resume a gate that did not return its own code ──────────────
#
# A gate the watchdog stopped at DEVBOX_GATE_MAX_SECONDS kept nothing. MEASURED:
# one project's full gate was stopped at its limit several times in one day,
# each time with its type check, lint and builds passed and only the test suite
# unfinished, and each rerun repeated all of it. A landing that wrapped the gate
# in its own time limit lost the same work when that limit killed the client.
# docs/specs/2026-11-13-resumable-gates-design.md holds the design.
#
# The gate writes a ledger of its finished steps and test files into the
# workspace. This client keeps a marker per worktree, <private dir>/ledgers/
# <lane-1 slug>.open, from `go` until the gate returns its own exit code. A
# marker that remains names a gate that never returned: a watchdog stop (10),
# a memory kill (7), or a client that died or lost its session. Each line of
# the marker is a name, a tab and a value:
#
#   target <name>      the target that ran the gate
#   lane <slug>        the lane it ran in, the workspace that holds the ledger
#   run <run id>       this run's id
#   key <sha256>       the ledger key of section 3.2
#   base <lines>       the lines of the ledger this client wrote at `go`
#   open <unit>        one per unit that was open at the stop this run resumes
#   fetched            once the ledger of that gate is in the local copy
#
# The local copy, <lane-1 slug>.ledger, is the ledger fetched with the `ledger`
# verb, mode 0600. `base` splits a ledger into the records of the earlier runs
# and those of the last one, so a unit open at the last stop is told from one
# that was open at an earlier stop and never reached again.
LEDGER_DIR=""
LEDGER_MARK=""
LEDGER_COPY=""
LEDGER_KEY=""
LEDGER_RESUME=0
LEDGER_FILE="$PROBE_DIR/ledger"
LEDGER_BASE=0
LEDGER_OPEN=""
# The line a resume prints at `go`, before its gate. Not before the joins: a
# run that ends up on a rented RunPod pod, which keeps no ledger, runs in full.
LEDGER_RESUME_LINE=""
LEDGER_MARKED=0
LEDGER_PREV_MARK=""
# A FIFO swapped in for the ledger can stall the read on the host, and the
# fetch stands between a stop and its resume, so it has a limit of its own.
LEDGER_FETCH_SECONDS=30
TAB=$'\t'

# One value of the marker: the rest of the first line named $1.
ledger_mark_get() {
  awk -F'\t' -v k="$1" '$1 == k { sub(/^[^\t]*\t/, ""); print; exit }' "$LEDGER_MARK"
}

# Every unit of the ledger $1, after its first $2 lines, whose last record
# there is the one named $3 (pass, start), one per line: `step<TAB><name>` or
# `file<TAB><runner><TAB><path>`. A unit counts as passed only when its LAST
# record is `pass`, and as open only when its last record is `start`: a later
# `start` or `fail` makes a passed unit not passed again (spec section 3.3).
ledger_units() {
  awk -F'\t' -v base="$2" -v want="$3" '
    NR <= base { next }
    $1 == "step" { id = $1 FS $2; st = $3 }
    $1 == "file" { id = $1 FS $2 FS $3; st = $4 }
    $1 == "step" || $1 == "file" { if (!(id in last)) order[++n] = id; last[id] = st }
    END { for (i = 1; i <= n; i++) if (want == "" || last[order[i]] == want) print order[i] }
  ' "$1"
}

# Discard the marker and the local copy of this worktree.
ledger_forget() {
  [ -z "$LEDGER_MARK" ] || rm -f "$LEDGER_MARK" "$LEDGER_COPY"
}

# A gate that never started after `go` (the pool lost its ticket, or released
# the grant before the gate began) wrote nothing. The marker of the gate this
# run would have resumed goes back, so the next run still resumes that one.
ledger_unmark() {
  [ "$LEDGER_MARKED" = 1 ] || return 0
  LEDGER_MARKED=0
  if [ -n "$LEDGER_PREV_MARK" ]; then
    printf '%s\n' "$LEDGER_PREV_MARK" >"$LEDGER_MARK"
  else
    rm -f "$LEDGER_MARK"
  fi
}

# Fetch the ledger of lane $2 on target $1, which the caller selected with
# devbox_target_use, into the local copy. $3 says what follows a failure, for
# its one line; an empty $3 prints nothing. Returns 1 on any failure.
#
# The `ledger` verb exits 0 with the ledger, 1 when the workspace holds none,
# and 2 for a ledger it refuses (too large, not a regular file, unreadable). A
# host older than the verb refuses it as an unknown verb, also with 2, so that
# case is read from its line, and the repair it names is the host's.
ledger_fetch() {
  local name="$1" lane="$2" then="$3" tmp="$LEDGER_DIR/fetch.$$" err="$LEDGER_DIR/fetch.$$.err" rc=0 line=""
  # Its own refusal names the install; this line names the consequence instead.
  if ! devbox_need_timeout 2>/dev/null; then
    [ -z "$then" ] || echo "devbox verify: this laptop has no 'timeout' command to bound the ledger fetch from $name, so $then" >&2
    return 1
  fi
  # Local, so devbox_gate_open and devbox_gate see the limit, and the caller's
  # value is back when this function returns.
  local GATE_TIME_LIMIT="$LEDGER_FETCH_SECONDS"
  # Both streams are files, never a pipe: a master this verb starts keeps the
  # streams it was started with, and a pipe would then stay open after the
  # verb ended.
  : >"$tmp"
  chmod 0600 "$tmp"
  devbox_gate ledger "$lane" "$DEVBOX_PROJECT" >"$tmp" 2>"$err" || rc=$?
  if _gate_limit_hit "$rc"; then line="no answer within ${LEDGER_FETCH_SECONDS}s"; fi
  # grep finds no line in an empty file, and the reason then goes without one.
  [ -n "${line-}" ] || line="$(grep -m1 . "$err" || true)"
  rm -f "$err"
  if [ "$rc" -eq 0 ]; then
    mv -f "$tmp" "$LEDGER_COPY"
    return 0
  fi
  rm -f "$tmp"
  [ -n "$then" ] || return 1
  case "$line" in
    *"unknown verb 'ledger'"*)
      echo "devbox verify: $name predates the ledger verb, so $then. $(repair_hint "$name")" >&2 ;;
    *)
      if [ "$rc" -eq 1 ]; then
        echo "devbox verify: $name holds no ledger of this worktree's gate (${line:-exit 1}), so $then" >&2
      else
        echo "devbox verify: could not fetch the ledger of this worktree's gate from $name (${line:-exit $rc}), so $then" >&2
      fi ;;
  esac
  return 1
}

# Name each unit that was open at the stop this run resumed (the marker's
# `open` lines) and is open at this stop too (spec section 5, step 7). $1 is
# the marker's `base`.
ledger_hang_check() {
  local unit
  [ -s "$LEDGER_COPY" ] || return 0
  while IFS= read -r unit; do
    [ -n "$unit" ] || continue
    grep -qxF "open$TAB$unit" "$LEDGER_MARK" || continue
    echo "devbox verify: ${unit##*"$TAB"} was running at both stops; it may hang" >&2
  done <<<"$(ledger_units "$LEDGER_COPY" "$1" start)"
}

# The resume count of the local copy, or nothing when it holds no whole number.
ledger_count() {
  local count
  count="$(awk -F'\t' '$1 == "resume" { print $2; exit }' "$LEDGER_COPY")"
  is_uint "$count" || return 1
  printf '%s' "$count"
}

# Before any target is joined: compute the key, and decide from the marker
# whether this run resumes (spec section 5, steps 1 to 5). Sets LEDGER_FILE,
# the ledger the hooks write into the workspace, LEDGER_RESUME, LEDGER_OPEN and
# LEDGER_RESUME_LINE.
ledger_prelude() {
  local -a fwd=()
  local target lane base count passed total
  [ -z "${fwd_crossed:-}" ] || read -r -a fwd <<<"$fwd_crossed"
  if LEDGER_DIR="$(devbox_ledger_dir)"; then
    LEDGER_MARK="$LEDGER_DIR/$HISTORY_SLUG.open"
    LEDGER_COPY="$LEDGER_DIR/$HISTORY_SLUG.ledger"
    ledger_key_of LEDGER_KEY "$PROBE_DIR/none" ${fwd[@]+"${fwd[@]}"} || LEDGER_KEY=""
  else
    LEDGER_DIR=""
  fi
  if [ -z "$LEDGER_KEY" ]; then
    echo "devbox verify: this gate keeps no ledger marker, so a stop cannot resume it" >&2
    printf 'key\t-\nresume\t0\n' >"$LEDGER_FILE"
    LEDGER_BASE=2
    return 0
  fi
  GATE_ENV+=("DEVBOX_LEDGER_KEY=$LEDGER_KEY")
  printf 'key\t%s\nresume\t0\n' "$LEDGER_KEY" >"$LEDGER_FILE"
  LEDGER_BASE=2
  [ -f "$LEDGER_MARK" ] || { rm -f "$LEDGER_COPY"; return 0; }
  if [ "$FRESH" = 1 ]; then
    echo "devbox verify: --fresh, so the unfinished gate of this worktree is discarded and the gate runs in full" >&2
    ledger_forget
    return 0
  fi
  if [ "$(ledger_mark_get key)" != "$LEDGER_KEY" ]; then
    echo "devbox verify: the unfinished gate of this worktree ran on other inputs (its ledger key differs), so its ledger is discarded and the gate runs in full" >&2
    ledger_forget
    return 0
  fi
  target="$(ledger_mark_get target)"
  lane="$(ledger_mark_get lane)"
  base="$(ledger_mark_get base)"
  is_uint "$base" || base=0
  # Once fetched, the ledger of a gate that ended can no longer change, so the
  # local copy is as new as the host's (step 3).
  if ! grep -qx 'fetched' "$LEDGER_MARK" || [ ! -s "$LEDGER_COPY" ]; then
    case " ${DEVBOX_DEPLOYED[*]} " in
      *" ${target:-?} "*) ;;
      *)
        echo "devbox verify: the unfinished gate of this worktree ran on ${target:-no named target}, which $DEVBOX_ENV does not list as a deployed target, so its ledger cannot be fetched and the gate runs in full" >&2
        ledger_forget
        return 0 ;;
    esac
    if ! devbox_target_use "$target" >/dev/null 2>&1 || ! ledger_fetch "$target" "$lane" "the gate runs in full"; then
      ledger_forget
      return 0
    fi
    printf 'fetched\n' >>"$LEDGER_MARK"
    ledger_hang_check "$base"
  fi
  if [ "$(awk -F'\t' 'NR == 1 && $1 == "key" { print $2 }' "$LEDGER_COPY")" != "$LEDGER_KEY" ]; then
    echo "devbox verify: the ledger of the unfinished gate does not carry this run's key, so it is discarded and the gate runs in full" >&2
    ledger_forget
    return 0
  fi
  if ! count="$(ledger_count)"; then
    echo "devbox verify: the ledger of the unfinished gate holds no resume count, so it is discarded and the gate runs in full" >&2
    ledger_forget
    return 0
  fi
  if [ "$count" -ge "$DEVBOX_MAX_RESUMES" ]; then
    echo "devbox verify: the unfinished gate of this worktree resumed $count time(s), and DEVBOX_MAX_RESUMES in $DEVBOX_CONFIG is $DEVBOX_MAX_RESUMES, so its ledger is discarded and the gate runs in full" >&2
    ledger_forget
    return 0
  fi
  awk -F'\t' -v OFS='\t' '$1 == "resume" && !done { $2 = $2 + 1; done = 1 } { print }' "$LEDGER_COPY" >"$LEDGER_FILE"
  LEDGER_BASE="$(wc -l <"$LEDGER_FILE" | tr -d ' ')"
  LEDGER_OPEN="$(ledger_units "$LEDGER_COPY" "$base" start)"
  LEDGER_RESUME=1
  passed="$(ledger_units "$LEDGER_COPY" 0 pass | grep -c . || true)"  # grep -c exits 1 on a count of 0
  total="$(ledger_units "$LEDGER_COPY" 0 "" | grep -c . || true)"  # the same
  LEDGER_RESUME_LINE="devbox: resuming, $passed of $total units passed earlier, resume $((count + 1)) of $DEVBOX_MAX_RESUMES"
}

# At `go`: record this gate in the marker. The marker it replaces is kept in
# memory for ledger_unmark.
ledger_mark() {
  local unit
  [ -z "$LEDGER_RESUME_LINE" ] || echo "$LEDGER_RESUME_LINE"
  [ -n "$LEDGER_KEY" ] || return 0
  LEDGER_PREV_MARK=""
  [ ! -f "$LEDGER_MARK" ] || LEDGER_PREV_MARK="$(cat "$LEDGER_MARK")"
  if ! {
    printf 'target\t%s\nlane\t%s\nrun\t%s\nkey\t%s\nbase\t%s\n' "$TARGET" "$SLUG" "$RUN_ID" "$LEDGER_KEY" "$LEDGER_BASE"
    while IFS= read -r unit; do
      [ -z "$unit" ] || printf 'open\t%s\n' "$unit"
    done <<<"$LEDGER_OPEN"
  } >"$LEDGER_MARK.tmp" || ! chmod 0600 "$LEDGER_MARK.tmp" || ! mv -f "$LEDGER_MARK.tmp" "$LEDGER_MARK"; then
    echo "devbox verify: could not write $LEDGER_MARK, so a stop of this gate cannot resume it" >&2
    return 0
  fi
  LEDGER_MARKED=1
}

# After a stop, exit 10 or 7: fetch the ledger at once, name a unit open
# at two stops in a row, and when the count allows, start the resume in this
# same `devbox verify`, so a landing needs no second call (spec section 5, step
# 6). It returns when no resume follows, and the caller exits with its 10 or
# 7; the marker stays, because the gate did not return its own code.
#
# The resume is this program run again, with the same --target: it joins the
# targets as any run does, so it may land on another target or lane (D6), and
# it reads the marker and the local copy this function leaves. Every join of
# this run ends first, or its lane lock would hold lane 1 against the resume.
ledger_after_stop() {
  local base count rc=0
  local -a again=()
  [ "$LEDGER_MARKED" = 1 ] || return 0
  if ! ledger_fetch "$TARGET" "$SLUG" "the stopped gate cannot resume"; then
    ledger_forget
    return 0
  fi
  printf 'fetched\n' >>"$LEDGER_MARK"
  base="$(ledger_mark_get base)"
  ledger_hang_check "${base:-0}"
  count="$(ledger_count)" || count=""
  if [ -z "$count" ] || [ "$count" -ge "$DEVBOX_MAX_RESUMES" ]; then
    echo "devbox verify: this gate resumed ${count:-an unknown number of} time(s), and DEVBOX_MAX_RESUMES in $DEVBOX_CONFIG is $DEVBOX_MAX_RESUMES, so it does not resume again" >&2
    return 0
  fi
  [ -z "$FORCE_TARGET" ] || again=(--target "$FORCE_TARGET")
  cleanup_probe
  trap devbox_on_exit EXIT
  devbox_runfile_remove
  bash "$_here/devbox-verify" ${again[@]+"${again[@]}"} || rc=$?
  # The resume applied the strict map to its own code, so this run passes it on.
  GATE_OWNS_EXIT=1
  exit "$rc"
}

# After the gate returned its own code: fetch the ledger once and warn when it
# holds no `step` and no `file` record (spec section 7, release 1). The code
# stays the gate's. A fetch that fails says nothing here: the gate is over, and
# the warning is advice about the next stop. Then the marker and the local copy
# go, because a completed run is never resumed (section 2).
ledger_finished() {
  [ "$RUN_MODE" = 0 ] || return 0
  if [ -n "$LEDGER_DIR" ] && ledger_fetch "$TARGET" "$SLUG" ""; then
    if [ -z "$(ledger_units "$LEDGER_COPY" 0 "")" ]; then
      echo "devbox verify: this gate wrote no ledger, so a stop cannot resume it" >&2
    fi
  fi
  ledger_forget
}

if [ "$RUN_MODE" = 0 ]; then
  ledger_prelude
  ledger_hooks="$(devbox_ledger_hooks "$DEVBOX_PROJECT" "$LEDGER_RESUME" "$LEDGER_FILE")" || {
    echo "devbox verify: could not encode the ledger tools for the workspace (base64 failed), so the gate did not run" >&2
    devbox_die 1
  }
  GATE_STDIN="$HOOKS"$'\n'"$ledger_hooks"
fi

# ── did a run's own connection fail? ─────────────────────────────────────────
#
# The run verb opens a NEW connection with a fresh password login (devbox_gate
# gives it no master), after the probe and the lock. When that login is
# refused (the gate password was rotated during the run) or the connect fails
# (sshd MaxStartups, a network drop), ssh exits 255 before anything runs on the
# host. That 255 fell through as the gate's own status: exit 255 with a line
# about the OOM counter, and under strict mode 255 unmapped, where a refused
# password must give 3 (75). ssh's own line in the run's stderr tells it apart
# from a gate that exits 255 itself.
#
# $1 the status, $2 the file that holds the run's stderr, $3 the target. It
# returns when the status is not ssh's own failure.
refuse_ssh_failure() {
  local status="$1" err="$2" target="$3" ssh_line
  [ "$status" -eq 255 ] || return 0
  ssh_line="$(grep -m1 -E "^devbox-gate@.*: Permission denied|Too many authentication failures|REMOTE HOST IDENTIFICATION HAS CHANGED|Host key verification failed" "$err" 2>/dev/null || true)"
  if [ -n "$ssh_line" ]; then
    case "$ssh_line" in
      *"Host key verification failed"*|*"REMOTE HOST IDENTIFICATION HAS CHANGED"*)
        echo "devbox verify: the host key of $target is not its pin at the run step; the gate did not run, and no password was sent ($ssh_line)" >&2 ;;
      *) echo "devbox verify: the gate password was refused by $target at the run step; the gate did not run ($ssh_line)" >&2 ;;
    esac
    devbox_die 3 auth
  fi
  ssh_line="$(grep -m1 -E "^ssh: connect to host |^ssh: Could not resolve hostname |^kex_exchange_identification: |Connection closed by |Connection reset by " "$err" 2>/dev/null || true)"
  if [ -n "$ssh_line" ]; then
    echo "devbox verify: the run step could not reach $target, so the gate's result is unknown ($ssh_line)" >&2
    devbox_die 3
  fi
}

# ── did the pool lose this gate's place in line? ─────────────────────────────
#
# 78 from devbox-pool means its queue ticket was gone and could not be written
# again, so the gate never ran. MEASURED on a live host: runs showed "queued"
# for over an hour while the host's queue was empty. A waiter is granted only
# at the head of the queue, so one without a ticket never is. The pool now
# restores a lost ticket, and when it cannot, it stops with 78 rather than wait
# for a turn that cannot come. A gate that exits 78 of its own prints no such
# line, and its status passes through as any other gate status does.
TICKET_LINE="devbox-pool: lost its queue ticket "
refuse_lost_ticket() {
  local status="$1" err="$2" target="$3" ticket_line
  [ "$status" -eq 78 ] || return 0
  ticket_line="$(grep -m1 -F "$TICKET_LINE" "$err" 2>/dev/null)" || return 0
  {
    echo "devbox verify: the pool on $target lost this gate's queue ticket and could not restore it, so the gate did not run (${ticket_line#devbox-pool: })"
    echo "  this is not a test result. The pool's state directory on $target is not writable or not there: run devbox doctor, and redeploy the host when it names the pool."
  } >&2
  ledger_unmark
  devbox_die 11
}

# ── did the grant run out before the gate started? ──────────────────────────
#
# The sync and the setup run under the grant (D2), so a host releases a grant
# whose gate has not started within DEVBOX_HOLD_PREP_SECONDS: a stuck client
# must not keep tokens other runs wait for. The pool then exits 80 with its
# line. 80 alone is not enough, because a gate may exit 80 of its own, and that
# one keeps its code.
PREP_LINE="devbox-pool: released the grant: no go within "
refuse_prep_limit() {
  local status="$1" err="$2" target="$3" prep_line
  [ "$status" -eq 80 ] || return 0
  prep_line="$(grep -m1 -F "$PREP_LINE" "$err" 2>/dev/null)" || return 0
  {
    echo "devbox verify: the pool on $target released this run's grant before the gate started (${prep_line#devbox-pool: }), so the gate did not run"
    echo "  this is not a test result. The sync and the setup took longer than DEVBOX_HOLD_PREP_SECONDS on $target allows: a cold lane is the usual cause, and the next run there is warm."
  } >&2
  ledger_unmark
  devbox_die 12
}

# ── joining the targets ──────────────────────────────────────────────────────
#
# Each join takes a free lane of this worktree, then a place in that target's
# queue (D3). A run whose lanes are all busy on one target still waits in the
# queue of every other target.
#
# A lane is one workspace of one worktree on one target, and its lock is the
# per-worktree lock this client always took. One workspace serves one (machine,
# project, worktree, lane), deliberately, because that is what keeps
# node_modules and the mypy cache warm between runs. Two runs from the SAME lane
# share one tree, and until the lock existed they mutated it concurrently: the
# token pool serialises the GATE, but the sync and `devbox_setup` ran before any
# token was held. A second run from one checkout reached `devbox_setup` while
# the first was mid-gate, reinstalled the dependencies under it, and the first
# run died, MEASURED. Lanes keep that rule, and give the second run a second
# tree instead of a wait: several runs of one worktree started at once, and all
# but one waited tens of minutes on one host's lock while that host ran at about
# a third of its CPU.
#
# The fifos and the answer files live in the private `mktemp -d` directory of
# the probe. In the shared /tmp the answer file was the fifo's public name plus
# `.out`, opened with `>`, so another local user could plant a symlink there
# and have this client truncate the file it named. macOS /tmp has no
# fs.protected_symlinks. That directory's cleanup is armed the moment it
# exists: a cleanup armed 117 lines after the fifo once left one more fifo
# directory in the temp directory on every abort in between, a refused rsync,
# a docker exec that failed, a Ctrl-C.
declare -A JOIN_FACT=()
JOIN_MAXWAIT=0
# Join one target, with the line that says why and what its probe answered.
join_start_target() {
  local name="$1" why="" verdict secs tokens jobs queued state
  [ -z "$FORCE_TARGET" ] || why=" (--target $FORCE_TARGET)"
  [ "$name" != hetzner ] || why=" (the rented Hetzner server of this checkout)"
  [ -n "$why" ] || [ "$name" != "$SELECT_AFFINITY" ] || why=" (the last run of this worktree was here)"
  read -r verdict secs tokens jobs queued <<<"${JOIN_FACT[$name]-}"
  # The pool's state is printed as it was answered, so the reader sees the
  # numbers the join rested on.
  case "$verdict" in
    now) state="$tokens tokens, $jobs jobs, $queued waiting: this ask fits now" ;;
    wait) state="$tokens tokens, $jobs jobs, $queued waiting: about ${secs}s of queuing" ;;
    # unknown: the pool would not put a number on the wait. The ceiling still
    # holds, and the only thing lost is the chance to skip a target.
    *) if [ "$JOIN_MAXWAIT" -gt 0 ]; then
         state="no usable queue estimate, so this run waits on it under a ${JOIN_MAXWAIT}s ceiling"
       else
         state="no usable queue estimate, so this run waits in its queue"
       fi ;;
  esac
  join_start "$name" "$JOIN_MAXWAIT" "$why: $state"
}

# Join every target named, after the affinity grace when GRACE_TARGET is set.
join_targets() {
  local name
  if [ -z "$JOIN_DIR" ]; then
    JOIN_DIR="$PROBE_DIR/join"
    mkdir -m 700 "$JOIN_DIR"
  fi
  GRACE_REST=()
  if [ -n "$GRACE_TARGET" ]; then
    for name in "$@"; do
      [ "$name" = "$GRACE_TARGET" ] || GRACE_REST+=("$name")
    done
    join_start_target "$GRACE_TARGET"
    # SECONDS counts whole seconds, so one more makes the grace at least its
    # length: a deadline of SECONDS + 2 read at x.9 seconds ended 1.1 seconds on.
    GRACE_UNTIL=$((SECONDS + AFFINITY_GRACE + 1))
    echo "==> devbox: waiting up to ${AFFINITY_GRACE}s on $GRACE_TARGET alone, where this worktree's workspace is warm, before joining ${GRACE_REST[*]}"
    return 0
  fi
  for name in "$@"; do join_start_target "$name"; done
}

# Every join ended with no grant. All of them at the lane lock exits 4, as one
# lock that could not be taken did. Otherwise the first run that ended says
# why, by the rules its status had when this client knew one target.
joins_failed() {
  local name d rc first="" reasons=""
  for name in "${JOINED[@]}"; do
    d="$JOIN_DIR/$name"
    reasons="$reasons"$'\n'"  $name: $(join_end_reason "$name")"
    [ -n "$first" ] || [ ! -e "$d/run.rc" ] || first="$name"
  done
  if [ -z "$first" ]; then
    echo "devbox verify: could not take the lock of a lane of $SLUG on any target within DEVBOX_LOCK_WAIT of ${LOCK_WAIT}s, so the gate did not run:$reasons" >&2
    devbox_die 4
  fi
  d="$JOIN_DIR/$first"
  read -r rc <"$d/run.rc" || rc=1
  refuse_ssh_failure "$rc" "$d/run.err" "$first"
  refuse_lost_ticket "$rc" "$d/run.err" "$first"
  # 75 from devbox-pool means it gave up queuing and ran NOTHING, on the
  # ceiling this client sent or on its own DEVBOX_POOL_DEADLINE. Before the
  # hold mode this client could not tell that 75 from a gate that exits 75
  # itself. Now the gate starts only after `go`, so a 75 before a grant is the
  # pool's: under a ceiling it is the ceiling, and without one the deadline.
  if [ "$rc" -eq 75 ] && [ "$JOIN_CEILING" -gt 0 ]; then
    return 1
  fi
  if [ "$rc" -eq 75 ]; then
    echo "devbox verify: the pool on $first gave up waiting for tokens and ran nothing (devbox-pool exit 75).$reasons" >&2
    devbox_die 75
  fi
  echo "devbox verify: no target granted this gate, so it did not run:$reasons" >&2
  devbox_die 1
}

# Wait on the joins under one ceiling. Returns 0 with WINNER set, or 1 when the
# ceiling ran out; every other end exits.
JOIN_CEILING=0
run_joins() {
  local rc=0
  JOIN_CEILING="$1"
  join_wait "$1" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
  esac
  joins_failed
}

# The ceiling ran out with no grant: every join ends, and rules 4 to 6 apply,
# as they did when the probe found no target under the ceiling.
RENT_RUNPOD=0
queued_past_ceiling=0
queue_ceiling() {
  local -a waited=()
  local name
  for name in "${JOINED[@]}"; do
    case "${JOIN_STATE[$name]}" in lock|queued) waited+=("$name") ;; esac
  done
  [ "${#waited[@]}" -gt 0 ] || waited=("${JOINED[@]}")
  join_release_all
  if [ "${#SELECT_RENT[@]}" -gt 0 ]; then
    echo "==> devbox: renting ${SELECT_RENT[0]}: no target granted this gate within your DEVBOX_MAX_QUEUE_WAIT of ${QUEUE_WAIT}s"
    if [ "${SELECT_RENT[0]}" = hetzner ]; then
      hetzner_target
      choose_target
      decide
    else
      RENT_RUNPOD=1
    fi
    return 0
  fi
  if [ "$QUEUE_ACTION" = local ]; then
    FALLBACK_FROM="${waited[*]}"
    FALLBACK_STAY="so this run keeps waiting on ${waited[*]} instead."
    # Returns only when this machine cannot run the gate. The ceiling is then
    # dropped, so this second wait is bounded by DEVBOX_POOL_DEADLINE like every
    # run before this feature.
    queue_fallback "the queue on ${waited[*]} did not free up within your DEVBOX_MAX_QUEUE_WAIT of ${QUEUE_WAIT}s" || true
    echo "devbox verify: waiting on ${waited[*]} without a ceiling, because this machine cannot run this gate." >&2
    queued_past_ceiling=1
    JOIN_MAXWAIT=0
    GRACE_TARGET=""
    join_targets "${waited[@]}"
    run_joins 0
    return 0
  fi
  {
    echo "devbox verify: gave up waiting for tokens on ${waited[*]} after ${QUEUE_WAIT}s. The gate did not run, here or there."
    echo "  raise DEVBOX_MAX_QUEUE_WAIT in $DEVBOX_ENV, or set DEVBOX_QUEUE_FULL_ACTION=local to run it here when this machine can."
  } >&2
  devbox_die 8 queue
}

# Act on the decision of devbox_select. It returns with WINNER set, or with
# RENT_RUNPOD=1, which the top level acts on, because devbox-runpod is sourced
# there and nowhere else. Every other end exits.
decide() {
  local kind name rest
  local -a names=()
  case "$d_kind" in
    pick|rent|local) skip_lines "==> devbox: " ;;
  esac
  case "$d_kind" in
    pick)
      JOIN_FACT=()
      while read -r kind name rest; do
        [ "$kind" = join ] || continue
        names+=("$name")
        JOIN_FACT[$name]="$rest"
      done <<<"$SELECTION"
      # Rule 1 is the affinity target within the grace. It gets a head start
      # only when there is another target to join after it.
      GRACE_TARGET=""
      if [ "$d_rule" = 1 ] && [ "$AFFINITY_GRACE" -gt 0 ] && [ "${#names[@]}" -gt 1 ]; then
        GRACE_TARGET="$d_name"
      fi
      JOIN_MAXWAIT="$QUEUE_WAIT"
      join_targets "${names[@]}"
      run_joins "$QUEUE_WAIT" || queue_ceiling ;;
    rent)
      RENT_RUNPOD=1 ;;
    local)
      # No target is eligible, so a target over the ceiling is never the
      # reason: devbox_select joins those. Returns only when this machine
      # cannot run the gate, and nothing is left to wait on.
      queue_fallback "no target can take this gate now, and DEVBOX_QUEUE_FULL_ACTION is local" || true
      refuse_none >&2
      devbox_die 8 "$(queue_kind)" ;;
    fail)
      case "$d_rule" in
        auth)
          while read -r f_name f_kind f_rest; do
            case "$f_kind" in
              refused) echo "devbox verify: the gate password was refused by $f_name ($(target_addr "$f_name")). Set the current DEVBOX_GATE_PASSWORD in $DEVBOX_ENV." >&2 ;;
              hostkey) echo "devbox verify: $f_name: $f_rest" >&2 ;;
            esac
          done <<<"$FACTS" ;;
        handshake) refuse_handshake >&2 ;;
        requires) refuse_requires >&2 ;;
        never)
          # A permanent misconfiguration and not a busy afternoon, so it is refused
          # whatever the action says. Routing around it would send every future run
          # to a laptop and leave the targets unused with nobody told why.
          {
            echo "devbox verify: every target can NEVER grant this gate's tokens:"
            skip_lines "  "
            echo "  DEVBOX_MIN_TOKENS is $DEVBOX_MIN_TOKENS in $DEVBOX_CONFIG."
            echo "  lower DEVBOX_MIN_TOKENS there, or raise DEVBOX_TOTAL_TOKENS in the deployment config of each target and redeploy it with the server's deploy.sh."
            echo "  without this check the acquire would have waited out DEVBOX_POOL_DEADLINE, an hour, and then failed."
          } >&2 ;;
        unreachable)
          {
            echo "devbox verify: no target answered:"
            skip_lines "  "
            echo "  use 'devbox verify --local' to run here, or set DEVBOX_RENT to rent a target."
          } >&2 ;;
        *)
          {
            refuse_none
            echo "  raise DEVBOX_MAX_QUEUE_WAIT in $DEVBOX_ENV, set DEVBOX_QUEUE_FULL_ACTION=local to run it here when this machine can, or DEVBOX_RENT=runpod to rent a target."
          } >&2 ;;
      esac
      # A fail decision reads `fail <code> <class>`, so the code is the second word.
      case "$d_rule" in
        auth) devbox_die "$d_name" auth ;;
        never) devbox_die "$d_name" queue ;;
        none) devbox_die "$d_name" "$(queue_kind)" ;;
        *) devbox_die "$d_name" ;;
      esac ;;
    *)
      echo "devbox verify: the target choice ended without a decision: $DECISION" >&2
      devbox_die 1 ;;
  esac
}

[ "$FORCE_TARGET" != hetzner ] || hetzner_target
choose_target
if [ "$d_kind" = rent ] && [ "$d_name" = hetzner ]; then
  skip_lines "==> devbox: "
  echo "==> devbox: renting hetzner: no deployed target can take this gate"
  hetzner_target
  choose_target
fi
decide

if [ "$RENT_RUNPOD" = 1 ]; then
  # The rented target owns its own transport and its own EXIT trap, so every
  # join and the deployed targets' masters are closed first.
  # The strict map stays armed until devbox-runpod arms its own trap, which
  # applies the same map.
  cleanup_probe
  trap devbox_on_exit EXIT
  devbox_runfile_phase rent runpod
  [ "$d_kind" != rent ] || echo "==> devbox: renting runpod: no deployed target can take this gate"
  # shellcheck source=/dev/null
  source "$_here/devbox-runpod"
  devbox_die "$?"
fi

# ── the grant ────────────────────────────────────────────────────────────────
#
# The target is fixed here, at the first grant, and every other join ends on
# the spot. The workspace, the sync and the setup run on the granted target
# while this run holds its tokens (D2): they run under the grant's CPU limit,
# and the gate then starts in the same pool process that holds the grant.
for name in "${JOINED[@]}"; do
  [ "$name" = "$WINNER" ] || join_abort "$name"
done
also=""
for name in "${JOINED[@]}"; do
  [ "$name" != "$WINNER" ] || continue
  case "${JOIN_STATE[$name]}" in ended) ;; *) also="$also${also:+, }$name" ;; esac
done
devbox_target_use "$WINNER"
WIN_DIR="$JOIN_DIR/$WINNER"
GATE_ERR="$WIN_DIR/run.err"
read -r SLUG <"$WIN_DIR/lane"
lane=1
while [ "$lane" -lt "${#LANE_SLUGS[@]}" ] && [ "${LANE_SLUGS[lane - 1]}" != "$SLUG" ]; do lane=$((lane + 1)); done
granted="$(sed -n 's/^devbox-pool: held \([0-9][0-9]*\) .*/\1/p' "$GATE_ERR" | sed -n 1p)"
echo "==> devbox: granted ${granted:-?} tokens on $TARGET lane $lane after $((SECONDS - JOIN_T0))s${also:+ (also queued on $also)}"

# The held run must still hold its grant before each step that spends time on
# it. A grant the host released, or a session that dropped, ends this run with
# the reason, rather than a sync into a workspace no gate will run in.
held_or_die() {
  local rc
  [ -e "$WIN_DIR/run.rc" ] || return 0
  read -r rc <"$WIN_DIR/run.rc" || rc=1
  refuse_prep_limit "$rc" "$GATE_ERR" "$TARGET"
  refuse_ssh_failure "$rc" "$GATE_ERR" "$TARGET"
  echo "devbox verify: the held run on $TARGET ended with status $rc before the gate started, so the gate did not run" >&2
  devbox_die 1
}

# The sync phase of the run file starts here: the workspace and the rsync both
# prepare the tree before the setup.
devbox_runfile_phase sync "$TARGET" "$SLUG"
echo "==> workspace $SLUG on $TARGET"
# ensure-workspace's contract is that stdout carries only the DSN; it enforces
# that on its own side by routing every diagnostic line (container id, ALTER/
# CREATE ROLE, CREATE DATABASE) to stderr. `tail -n1` is defense in depth on
# top of that, not a substitute for it. The shape check below is what actually
# refuses to trust a violation of that contract instead of writing garbage
# into --env-file.
DSN="$(devbox_gate ensure-workspace "$SLUG" "$MACHINE_ID" | tail -n1)"
case "$DSN" in
  postgresql*) ;;
  *) echo "devbox verify: ensure-workspace on $TARGET did not return a DSN as its last output line; refusing to trust it" >&2; devbox_die 1 ;;
esac
# Affinity: this worktree now has a workspace on this target, so the
# next run prefers it, and pays an incremental sync there instead of a full one
# somewhere else. Written once the workspace exists, so a run that fails in the
# gate still records where its warm workspace is. The record names the target,
# not the lane: every lane of a worktree there shares its history.
# A rented target is never recorded: it is gone after its idle time.
if [ "$TARGET" != hetzner ]; then
  devbox_affinity_write "$TARGET" || echo "devbox verify: could not record $TARGET as this worktree's last target; the next run may choose another" >&2
fi
held_or_die

# ── the workspace's OOM counter, before the gate ─────────────────────────────
#
# The workspace runs under a memory cap, and the kernel enforces that cap by
# KILLING a process. pytest dies mid-run, prints no summary, and this script
# returns a bare non-zero status with no cause, and a developer chased wrong
# theories until dmesg named it. The
# container's own cgroup counts every such kill, so the number is asked for
# rather than inferred, and the tail of this file turns it into a sentence.

echo "==> holding the $SLUG lock"
echo "==> sync"
# rsync straight into the workspace volume, NOT into a temp dir followed by
# `docker cp`. docker cp MERGES, so with that shape a file deleted locally
# survives in the workspace and can keep a stale test green. That is the same
# class of fault as the silently-skipped Postgres tests this whole runner
# exists to prevent, so --delete has to act on the real target.
#
# The client only names sync/<slug>/<project>/. gate-root maps that to
# /home/dev/<project>/ in ws-<slug>, where the volume is mounted, and runs the
# rsync receiver there with docker exec. A symlink that workspace code plants
# then resolves inside the container and never on the host.
#
# The two remote steps devbox-sync asks its caller for. `sync-finish` also does
# the `chown -R dev:dev` that followed the sync, before the finish script runs
# as dev in the workspace.
devbox_sync_push() {
  local sub="$1"; shift
  devbox_gate_rsync "$@" "sync/$SLUG/$DEVBOX_PROJECT/${sub:+$sub/}"
}
devbox_sync_finish() {
  devbox_gate sync-finish "$SLUG" "$DEVBOX_PROJECT" ${1:+"$1"}
}
devbox_sync
held_or_die

devbox_runfile_phase setup
echo "==> setup"
devbox_gate setup "$SLUG" "$DEVBOX_PROJECT" <<< "$HOOKS"
held_or_die

# DEVBOX_TOKENS and PYTEST_WORKERS are exported by devbox-pool run itself, so
# only the DSN has to cross from here. It must not cross as `docker exec -e
# VAR=value`: that string sits verbatim in the argv of the ssh-spawned shell,
# of devbox-pool's own process, AND of the final docker exec, for the whole
# multi-minute run of the gate, readable by anyone on the devbox via `ps`.
# Route it through `docker exec --env-file` instead: that flag takes only a
# PATH (never secret), and Docker resolves the file itself rather than handing
# its contents to any process as an argument. Same reasoning devbox-runner
# already applies to the admin and workspace Postgres passwords, just for a
# value that has to cross a host boundary instead of staying local to one exec.
#
# The value travels after `go` on the held run's stdin: a count, then that
# many NAME=value lines, then the gate's own stdin. The pool reads the header,
# writes the lines to a 0600 file of its own under /run, passes that path with
# --env-file, and removes the file when the gate ends. The lines are built with
# `printf`, a shell builtin with no process and no argv of its own, and cross
# ssh's data channel, never its command line, so the DSN (a password included)
# never becomes an argument anywhere on either host. The file is the host's to
# remove: the client once named it, created it over ssh and removed it on exit
# with one more ssh, and a Ctrl-C at the wrong moment left a Postgres password
# in /run on the host.
if [ "${DEVBOX_NEEDS_POSTGRES:-0}" = "1" ]; then
  GATE_ENV=("$DEVBOX_DB_URL_VAR=$DSN" ${GATE_ENV[@]+"${GATE_ENV[@]}"})
fi
GATE_HEADER="${#GATE_ENV[@]}"
if [ "${#GATE_ENV[@]}" -gt 0 ]; then
  GATE_HEADER="$GATE_HEADER"$'\n'"$(printf '%s\n' "${GATE_ENV[@]}")"
fi

# ── the workspace's OOM counter, read as late as possible ───────────────────
#
# The counter is CUMULATIVE for the life of the container, so the two reads
# around it define the interval a kill is charged to. That interval must be the
# gate and nothing else, which is why this read sits here rather than beside
# ensure-workspace where it is cheaper.
#
# Two long stretches would otherwise fall inside it, and both are real. The
# lane lock above waits up to DEVBOX_LOCK_WAIT, one hour by default, and
# ANOTHER run of this same slug holds that lock and uses this same container: its
# kill would be charged here, and a genuinely failing test in this run would be
# reported as a memory kill. That is not hypothetical, and the lock's own comment
# records why: two runs from one checkout happen from two terminals or a
# re-triggered job. devbox_setup is the other stretch, and `npm ci` or a tsc
# build is the memory-heaviest step of many gates; a setup that swallows a killed
# child would poison the reading before a single test ran.
#
# A counter that cannot be read is kept as the empty string and never as 0. A
# zero baseline against a second read that also failed would report a real test
# failure as a memory kill, which is the opposite of this file's job.
OOM_BEFORE="$(devbox_gate oom-count "$SLUG" 2>/dev/null || true)"
is_uint "$OOM_BEFORE" || OOM_BEFORE=""
held_or_die

# ── go ───────────────────────────────────────────────────────────────────────
#
# ONE ssh session holds the grant and runs the gate. devbox-pool run is what
# keeps the two together: the grant is keyed to a PID, so the process that holds
# it must be the process doing the work. Splitting this into an acquire call and
# a separate exec would key the grant to a shell that exits at once, and the
# reaper would give the tokens away mid-run. `go` starts the gate's clock on the
# host (D10): DEVBOX_GATE_MAX_SECONDS and the watchdog's stall rule measure the
# gate, and the preparation has its own limit.
#
# The gate's stderr is copied to GATE_ERR as it streams, because the watchdog's
# reason reaches this laptop as one line of it, and exit 10 names that reason.
# tee passes every byte on at once, so a gate's progress output streams as
# before.
#
# The stdin is written into the fifo this shell holds read-write, so a host
# that ends early can never answer the write with SIGPIPE. A mock ssh that
# exited at once raced a printf into a pipe and returned 141 for a successful
# gate.
#
# The write runs in a background job. The ledger tools, and on a resume the
# ledger, made the stdin larger than a pipe's buffer: MEASURED, a gate that
# ended before it read its stdin left this shell blocked in the write for
# good, because its own read-write end keeps the fifo from ever failing the
# write. The job holds that end until its write is done, then exits, and the
# reader sees the end of the stream. A job still blocked once the run ended is
# killed, since nothing will read the rest.
devbox_runfile_phase gate
[ "$RUN_MODE" = 1 ] || ledger_mark
printf 'go\n%s\n%s\n' "$GATE_HEADER" "$GATE_STDIN" >&"${JOIN_RUN_FD[$WINNER]}" &
go_writer=$!
join_close_fd "${JOIN_RUN_FD[$WINNER]}"
JOIN_RUN_FD[$WINNER]=""
wait "${JOIN_PID[$WINNER]}" || true  # the job's own status is the run's, in run.rc
# The writer may have ended already, and that end is the one asked for.
kill "$go_writer" 2>/dev/null || true
wait "$go_writer" 2>/dev/null || true  # its status is a write the gate did not need
status=1
read -r status <"$WIN_DIR/run.rc" || status=1

refuse_ssh_failure "$status" "$GATE_ERR" "$TARGET"
refuse_prep_limit "$status" "$GATE_ERR" "$TARGET"

# ── did the watchdog stop it? ────────────────────────────────────────────────
#
# 79 from devbox-pool means the watchdog on the target stopped this gate: past
# its DEVBOX_GATE_MAX_SECONDS, or with no CPU used for DEVBOX_GATE_STALL_SECONDS.
# That is not a test result, and an agent that read it as one would
# rerun the same gate into the same stop. So it is exit 10, with the reason the
# pool printed. A gate that exits 79 of its own prints no such line, and its
# status passes through below as any other gate status does.
WATCHDOG_LINE="devbox-pool: the watchdog stopped this gate: "
if [ "$status" -eq 79 ] && stop_reason="$(grep -m1 -F "$WATCHDOG_LINE" "$GATE_ERR" 2>/dev/null)"; then
  {
    echo "devbox verify: the watchdog on $TARGET stopped this gate: ${stop_reason#*"$WATCHDOG_LINE"}"
    echo "  this is not a test result. Do not rerun the gate unchanged: find the test that hangs or spins, or raise DEVBOX_GATE_MAX_SECONDS in $DEVBOX_CONFIG when the gate is really that long."
  } >&2
  ledger_after_stop
  devbox_die 10
fi
refuse_lost_ticket "$status" "$GATE_ERR" "$TARGET"
# A 75 is the gate's own here. The pool exits 75 only while it queues, before
# its `held` line, and joins_failed reads that one. Before the hold mode a gate
# of its own that exited exactly 75 was read as a pool that gave up, a known
# collision that the `go` line removed.

# ── did the gate fail, or was it killed?─────────────────────────────────────
#
# A non-zero status is not proof of a failing test. When memory runs out the
# kernel kills the process, and the partial test summary, or the missing one, is
# the SYMPTOM of that rather than the cause. Read the counter a second time and
# compare: a count that GREW means this run was killed.
#
# What the counter proves, and what it does not. memory.events oom_kill counts
# processes in this cgroup killed by ANY OOM killer, not only by this cgroup
# hitting its own limit. The host running short and the kernel choosing a process
# in here increments the same field. So the message below reports the KILL as
# fact and keeps both causes open, because telling somebody to raise the cap when
# the box is already oversubscribed makes the next kill more likely.
#
# Only on a non-zero status, and only with a baseline to compare against. A
# green gate pays nothing for this, and a red gate has already lost minutes.
#
# Strict mode reads the counter after a green gate too. A kill inside a gate
# that still ran to its end is an event its caller must see, so it is named on
# stderr while the code stays the gate's. A status of 128 or more is a gate
# that was killed and did not run to its end: that one keeps the plain exit 7,
# which the map turns into 71.
oom_keeps_gate_status=0
[ "$STRICT" = 1 ] && [ "$status" -lt 128 ] && oom_keeps_gate_status=1
if [ "$status" -ne 0 ] || [ "$STRICT" = 1 ]; then
  oom_after=""
  if [ -n "$OOM_BEFORE" ]; then
    oom_after="$(devbox_gate oom-count "$SLUG" 2>/dev/null || true)"
  fi
  if ! is_uint "$oom_after"; then
    # Say so, and pass the gate's own status through unchanged. An unreadable
    # counter must never turn a real test failure into a reported OOM.
    [ "$status" -eq 0 ] || echo "devbox verify: could not read the workspace's OOM counter on $TARGET, so this run cannot tell a memory kill from a test failure. The status below is the gate's own." >&2
  elif [ "$oom_after" -gt "$OOM_BEFORE" ]; then
    # The cap is read from the file the fix edits, so the message names a value
    # the reader can go and change. The gate verb reads it out of
    # /etc/devbox/config on the host.
    cap="$(devbox_gate memory-cap 2>/dev/null || true)"
    if [ -n "$cap" ]; then
      cap_text="a $cap cap: DEVBOX_WORKSPACE_MEMORY in /etc/devbox/config on $TARGET"
    else
      # Never a number this laptop invented. A host that records no key runs the
      # workspace under devbox-runner's own default, and only that host knows it.
      cap_text="devbox-runner's default cap, because $TARGET records no DEVBOX_WORKSPACE_MEMORY in /etc/devbox/config"
    fi
    {
      if [ "$oom_keeps_gate_status" = 1 ]; then
        echo "devbox verify: a process in $DEVBOX_PROJECT's gate on $TARGET was OOM-KILLED. The gate ran to its end, so the status below is the gate's own ($status)."
      else
        echo "devbox verify: $DEVBOX_PROJECT's gate on $TARGET was OOM-KILLED. It did not fail."
      fi
      echo "  the cgroup for ws-$SLUG counted $(( oom_after - OOM_BEFORE )) new OOM kill(s) while the gate ran"
      echo "  a partial test summary, or none at all, is the SYMPTOM: the kernel kills the process before it can print one"
      echo "  the counter does not say WHICH killer, so both causes are live:"
      echo "    this workspace crossed its own cap, which is $cap_text"
      echo "      then lower DEVBOX_WANT_TOKENS, now $DEVBOX_WANT_TOKENS, in $DEVBOX_CONFIG: every token is one more worker sharing that cap"
      echo "      or raise DEVBOX_WORKSPACE_MEMORY in the deployment config for $TARGET, then redeploy the host with the server's deploy.sh"
      echo "    or $TARGET ran out of memory host-wide and the kernel chose a process in here"
      echo "      then RAISING the cap makes the next one more likely: cap times DEVBOX_MAX_JOBS is a budget against the box's RAM"
      echo "      check with: free -g on $TARGET, and devbox doctor reports the ratio"
    } >&2
    # 7 and not the gate's own status: this run says nothing about the tests.
    if [ "$oom_keeps_gate_status" != 1 ]; then
      ledger_after_stop
      devbox_die 7
    fi
    echo '::devbox-infra::oom' >&2
  fi
fi
if [ "$STRICT" = 1 ] && [ "$queued_past_ceiling" = 1 ]; then
  echo '::devbox-infra::queue' >&2
fi
ledger_finished
GATE_OWNS_EXIT=1
exit "$status"
