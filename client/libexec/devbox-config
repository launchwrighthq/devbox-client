#!/bin/bash
# Read a project's committed .devbox/config.env and a developer's .devbox.env, both as
# data, and build the hooks a workspace runs.
# shellcheck shell=bash

# The services of DEVBOX_SERVICES, loaded by the first function that needs
# them: the infra tools source this file for devbox_kv_parse alone, and carry
# no devbox-services beside it.
DEVBOX_SERVICES_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/devbox-services"
devbox_services_load() {
  declare -F devbox_services_hook >/dev/null && return 0
  # shellcheck source=client/libexec/devbox-services
  source "$DEVBOX_SERVICES_LIB" || { echo "devbox: could not load $DEVBOX_SERVICES_LIB; reinstall the devbox client" >&2; return 1; }
}

# Parse a file as DATA and never source it: one KEY=value per line, `#`
# comment lines, one pair of matching outer quotes stripped, nothing expanded.
# A sourced profile made every value code, which is why devbox-verify carries a
# guard per value and doctor carried an awk reader that disagreed with `source`
# over quotes.
#
# ONE parser reads both files a client reads, .devbox/config.env and
# .devbox.env, each with its own key list. An older client sourced .devbox.env,
# so a gate password that held `$`, a quote or a backtick broke the run, or ran
# as code on the laptop.
#
#   $1  the file
#   $2  the keys it may set, space padded
#   $3  optional: a regex for further keys it may set (DEVBOX_TARGET_<NAME>)
#   $4  optional: a function that prints the replacement of a removed key and
#       returns 0, or returns 1 for a key it does not know
#
# Each key becomes a shell variable, never exported. DEVBOX_KV_SEEN lists the
# keys the file set, space padded, so a caller can tell a key the file set from
# a value some earlier shell exported.
DEVBOX_KV_SEEN=" "
devbox_kv_parse() {
  local file="$1" keys="$2" extra="${3:-}" removed="${4:-}" line key value n=0 seen=" " repl
  DEVBOX_KV_SEEN=" "
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "$line" in ""|"#"*) continue ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    if [ "$key" = "$line" ] || [[ ! "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]]; then
      echo "devbox: $file:$n is not KEY=value" >&2; return 2
    fi
    case "$keys" in *" $key "*) ;; *)
      if [ -n "$removed" ] && repl="$("$removed" "$key")"; then
        echo "devbox: $file:$n: $key is no longer read. $repl" >&2; return 2
      fi
      if [ -z "$extra" ] || [[ ! "$key" =~ $extra ]]; then
        echo "devbox: $file:$n: unknown key $key" >&2; return 2
      fi ;;
    esac
    case "$seen" in *" $key "*)
      echo "devbox: $file:$n: $key is set twice" >&2; return 2 ;;
    esac
    seen="$seen$key "
    case "$value" in \"*|\'*)
      if [ "${#value}" -lt 2 ] || [ "${value:0:1}" != "${value: -1}" ]; then
        echo "devbox: $file:$n: $key opens a quote it does not close" >&2; return 2
      fi
      value="${value:1:${#value}-2}" ;;
    esac
    printf -v "$key" '%s' "$value"
  done <"$file"
  DEVBOX_KV_SEEN="$seen"
}

# Every key a project may set. A key outside this list is refused, so a typo
# fails the run instead of silently running it with a default.
DEVBOX_CONFIG_KEYS=" DEVBOX_PROJECT DEVBOX_WANT_TOKENS DEVBOX_MIN_TOKENS DEVBOX_REQUIRES \
DEVBOX_FORWARD_ENV DEVBOX_RUNPOD_IMAGE \
DEVBOX_ENVIRONMENT DEVBOX_PROVISION DEVBOX_SETUP DEVBOX_GATE_MAX_SECONDS DEVBOX_LANES \
DEVBOX_MAX_RESUMES DEVBOX_RERUN DEVBOX_SETUP_INPUTS DEVBOX_SETUP_OUTPUTS DEVBOX_SHARED_INPUTS \
DEVBOX_LOCAL_GATE DEVBOX_SERVICES DEVBOX_SERVICE_ENV DEVBOX_WORKER_MEMORY DEVBOX_STEP_MEMORY "

# The replacement of each key that release 4.0 removed from .devbox/config.env
# (docs/specs/2026-11-14-learned-selection-design.md, section 11). Each is
# refused by name with the line that replaces it, never dropped. A gate that
# ran with its database URL unset skipped its database tests and still exited
# 0, MEASURED, and a DEVBOX_NEEDS_POSTGRES dropped in silence starts no
# database. A DEVBOX_VERIFY beside .devbox/steps was a second gate that
# nothing ran. .devbox.env refuses DEVBOX_VERIFY with the same line.
devbox_config_removed_key() {
  case "$1" in
    DEVBOX_VERIFY) echo "Describe the gate in .devbox/steps, one step per line, such as 'verify -- <the command>'." ;;
    DEVBOX_NEEDS_POSTGRES) echo "Write DEVBOX_SERVICES=postgres in .devbox/config.env." ;;
    DEVBOX_DB_URL_VAR) echo "Write DEVBOX_SERVICE_ENV=postgres=<VARIABLE> in .devbox/config.env, or leave it out for DATABASE_URL." ;;
    *) return 1 ;;
  esac
}

# A path of DEVBOX_SETUP_INPUTS, DEVBOX_SETUP_OUTPUTS or DEVBOX_SHARED_INPUTS,
# relative to the checkout root. The laptop hashes each one, and the steps hand
# them to other tools, so a path that leaves the checkout, starts with a dash,
# or holds a glob, a quote or a space is refused here, once, before anything
# reads it. A DEVBOX_SETUP_OUTPUTS path may also start with `~/`: a setup that
# fills a browser or a download cache writes it under the home directory.
# `devbox ci cache` prints each path as written, so no path may hold a
# character that needs a JSON escape.
devbox_config_paths_ok() {
  local key="$1" value="$2" file="$3" path rel home=""
  local -a paths=()
  [ "$key" != DEVBOX_SETUP_OUTPUTS ] || home=" or to '~/'"
  read -r -a paths <<<"$value"
  for path in ${paths[@]+"${paths[@]}"}; do
    rel="$path"
    [ -z "$home" ] || rel="${path#\~/}"
    if [[ ! "$rel" =~ ^[A-Za-z0-9._+@][A-Za-z0-9._+@/-]*$ ]] || [[ "/$rel/" == */../* ]]; then
      echo "devbox: $file: refusing $key '$path': write paths relative to the checkout root$home, separated by spaces, with no '..', no leading '/' or '-', and only letters, digits and . _ + @ / -" >&2
      return 2
    fi
  done
}

# shellcheck disable=SC2034  # DEVBOX_RERUN_CONFIG is read by devbox-verify
devbox_config_parse() {
  local file="$1" image="${DEVBOX_RUNPOD_IMAGE:-}" key rc=0 rerun_file
  local rerun_env="${DEVBOX_RERUN-}" rerun_env_set="${DEVBOX_RERUN+x}"
  devbox_kv_parse "$file" "$DEVBOX_CONFIG_KEYS" "" devbox_config_removed_key || rc=2
  # DEVBOX_RERUN (spec D13): a flag beats the environment, the environment
  # beats this file, and the file beats `changed`. The parser sets each key it
  # reads as a shell variable of the same name, so a file line would replace
  # the value a developer exported, and the caller could no longer tell the
  # two apart. The file's value goes to DEVBOX_RERUN_CONFIG below, and
  # DEVBOX_RERUN is put back as the environment left it, on a refusal too.
  rerun_file="${DEVBOX_RERUN-}"
  if [ -n "$rerun_env_set" ]; then DEVBOX_RERUN="$rerun_env"; else unset DEVBOX_RERUN; fi
  [ "$rc" = 0 ] || return 2
  # The image is a default: a developer's .devbox.env, read first, may pick another.
  [ -z "$image" ] || DEVBOX_RUNPOD_IMAGE="$image"
  DEVBOX_SETUP_DEFAULT=0
  for key in DEVBOX_PROJECT DEVBOX_SETUP; do
    case "$DEVBOX_KV_SEEN" in *" $key "*) continue ;; esac
    # A project with no DEVBOX_SETUP gets the install of its lock files. Every
    # project wrote `uv sync` and `npm ci` beside each lock file in a setup of
    # its own, and one of those scripts carried a symlink repair the client
    # already made. devbox_config_load lists the lock files, from the checkout.
    if [ "$key" = DEVBOX_SETUP ]; then
      DEVBOX_SETUP=devbox_install_locks
      DEVBOX_SETUP_DEFAULT=1
      continue
    fi
    echo "devbox: $file sets no $key" >&2; return 2
  done
  # The gate is .devbox/steps beside this file (client-owns-the-gate spec, D2).
  # Checked here, where verify, run, gc, status and doctor all read the config,
  # so no path takes a project that names no gate as a whole one.
  if [ ! -f "$(dirname "$file")/steps" ]; then
    echo "devbox: $file has no .devbox/steps beside it, so the project names no gate; write one step per line there, such as 'test -- npm test'" >&2
    return 2
  fi
  # DEVBOX_LANES, the workspaces one worktree may hold on each target. MEASURED:
  # several runs of one worktree waited on one host's lock for tens of minutes
  # while that host ran at about a third of its CPU, because one worktree had
  # one workspace per target. Each lane costs the project a container, two
  # volumes and a Postgres role on every target, so the project sets it.
  #
  # Set here when the file does not, and never left to the environment: verify
  # takes this many lane locks and gc keeps this many lanes, so an exported
  # value would make the two disagree on which workspaces are live. The rule is
  # the library's, which every caller of this parser loads first, in a
  # subshell, because the guard exits and this parser returns its refusal.
  case "$DEVBOX_KV_SEEN" in
    *" DEVBOX_LANES "*) (require_lanes "$DEVBOX_LANES" "$file") || return 2 ;;
    *) DEVBOX_LANES=2 ;;
  esac
  # DEVBOX_MAX_RESUMES, how many times devbox verify resumes one ledger of a
  # stopped gate (resumable gates spec, D5). 0 turns resuming off. From the
  # committed file alone, as DEVBOX_LANES is: a resume builds a green from two
  # runs, so the project decides how many, and an exported value must not.
  # Checked here, before anything reaches a host, because verify compares it
  # in bash arithmetic, which evaluates whatever text it is given.
  case "$DEVBOX_KV_SEEN" in
    *" DEVBOX_MAX_RESUMES "*)
      case "$DEVBOX_MAX_RESUMES" in
        [0-9]) ;;
        *) echo "devbox: $file: refusing DEVBOX_MAX_RESUMES '$DEVBOX_MAX_RESUMES': write a whole number from 0 to 9" >&2; return 2 ;;
      esac ;;
    *) DEVBOX_MAX_RESUMES=1 ;;
  esac
  case "$DEVBOX_KV_SEEN" in
    *" DEVBOX_RERUN "*)
      case "$rerun_file" in
        changed|full) DEVBOX_RERUN_CONFIG="$rerun_file" ;;
        *) echo "devbox: $file: refusing DEVBOX_RERUN '$rerun_file': write changed or full" >&2; return 2 ;;
      esac ;;
    *) DEVBOX_RERUN_CONFIG="" ;;
  esac
  # The three path lists and the local gate rule come from the committed file
  # alone, as DEVBOX_LANES does: an exported DEVBOX_SETUP_INPUTS would skip a
  # setup the project's lock files say must run, an exported
  # DEVBOX_SETUP_OUTPUTS would let a CI cache restore a skip record without
  # the outputs the setup makes, and an exported DEVBOX_LOCAL_GATE would run a
  # gate on a laptop the project refused (D11).
  for key in DEVBOX_SETUP_INPUTS DEVBOX_SETUP_OUTPUTS DEVBOX_SHARED_INPUTS; do
    case "$DEVBOX_KV_SEEN" in
      *" $key "*) devbox_config_paths_ok "$key" "${!key}" "$file" || return 2 ;;
      *) printf -v "$key" '%s' "" ;;
    esac
  done
  case "$DEVBOX_KV_SEEN" in
    *" DEVBOX_LOCAL_GATE "*)
      case "$DEVBOX_LOCAL_GATE" in
        always|ci|never) ;;
        *) echo "devbox: $file: refusing DEVBOX_LOCAL_GATE '$DEVBOX_LOCAL_GATE': write always, ci or never" >&2; return 2 ;;
      esac ;;
    *) DEVBOX_LOCAL_GATE=ci ;;
  esac
  devbox_config_services "$file"
}

# The services of D8 (learned-selection spec, section 8). devbox-services
# carries what runs them, and loads only when a gate declares one.
DEVBOX_SERVICE_NAMES="postgres redis rabbitmq minio"

# The names DEVBOX_SERVICE_ENV may set, one per exported variable. minio
# exports four variables, so it has four names: `minio` is its endpoint.
DEVBOX_SERVICE_SLOTS="postgres redis rabbitmq minio minio-bucket minio-access-key minio-secret-key"

# The default variable of a slot (section 8).
devbox_service_default_var() {
  case "$1" in
    postgres) echo DATABASE_URL ;;
    redis) echo REDIS_URL ;;
    rabbitmq) echo AMQP_URL ;;
    minio) echo S3_ENDPOINT_URL ;;
    minio-bucket) echo S3_BUCKET ;;
    minio-access-key) echo AWS_ACCESS_KEY_ID ;;
    minio-secret-key) echo AWS_SECRET_ACCESS_KEY ;;
    *) return 1 ;;
  esac
}

# The variable a slot is exported under: its DEVBOX_SERVICE_ENV pair, else the
# default. devbox_config_parse has checked the pairs.
devbox_service_var() {
  local slot="$1" pair
  for pair in ${DEVBOX_SERVICE_ENV:-}; do
    [ "${pair%%=*}" != "$slot" ] || { printf '%s\n' "${pair#*=}"; return 0; }
  done
  devbox_service_default_var "$slot"
}

# The service a slot belongs to.
devbox_service_of_slot() {
  case "$1" in minio-*) echo minio ;; *) echo "$1" ;; esac
}

# DEVBOX_SERVICES, DEVBOX_SERVICE_ENV and DEVBOX_WORKER_MEMORY (learned-selection
# spec, section 4.1), from the committed file alone, as DEVBOX_LANES is: an
# exported DEVBOX_SERVICES would start a server the project never declared.
#
# Sets DEVBOX_NEEDS_POSTGRES, 1 when DEVBOX_SERVICES names postgres, else 0,
# and DEVBOX_DB_URL_VAR, the name its URL is exported under, which
# devbox-verify and devbox-runpod read to send the DSN. Neither is a key of the
# file since release 4.0 (devbox_config_removed_key), so an exported value of
# either is replaced here.
#
# Sets DEVBOX_WORKER_MEMORY_BYTES and DEVBOX_STEP_MEMORY_BYTES, which the hooks
# export to the workspace as DEVBOX_WORKER_MEMORY and DEVBOX_STEP_MEMORY.
# shellcheck disable=SC2034  # both _BYTES values are read by devbox_hooks_script
devbox_config_services() {
  local file="$1" key s pair slot name seen=" " names=" " n
  for key in DEVBOX_SERVICES DEVBOX_SERVICE_ENV; do
    case "$DEVBOX_KV_SEEN" in *" $key "*) ;; *) printf -v "$key" '%s' "" ;; esac
  done
  for s in $DEVBOX_SERVICES; do
    case " $DEVBOX_SERVICE_NAMES " in *" $s "*) ;; *)
      echo "devbox: $file: refusing DEVBOX_SERVICES '$DEVBOX_SERVICES': '$s' is no service; write some of $DEVBOX_SERVICE_NAMES, separated by spaces" >&2
      return 2 ;;
    esac
    case "$seen" in *" $s "*)
      echo "devbox: $file: DEVBOX_SERVICES names $s twice" >&2; return 2 ;;
    esac
    seen="$seen$s "
  done
  for pair in $DEVBOX_SERVICE_ENV; do
    slot="${pair%%=*}"
    name="${pair#*=}"
    if [ "$slot" = "$pair" ] || [[ " $DEVBOX_SERVICE_SLOTS " != *" $slot "* ]]; then
      echo "devbox: $file: refusing DEVBOX_SERVICE_ENV '$pair': write <name>=<VARIABLE>, where <name> is one of $DEVBOX_SERVICE_SLOTS" >&2
      return 2
    fi
    if [[ ! "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo "devbox: $file: refusing DEVBOX_SERVICE_ENV '$pair': '$name' is not an environment variable name" >&2
      return 2
    fi
    if [[ "$seen" != *" $(devbox_service_of_slot "$slot") "* ]]; then
      echo "devbox: $file: DEVBOX_SERVICE_ENV names $slot, and DEVBOX_SERVICES does not name $(devbox_service_of_slot "$slot")" >&2
      return 2
    fi
    case "$names" in *" $slot="*)
      echo "devbox: $file: DEVBOX_SERVICE_ENV names $slot twice" >&2; return 2 ;;
    esac
    names="$names$slot= "
  done
  # Two slots on one variable: the second export would replace the first URL.
  names=" "
  for slot in $DEVBOX_SERVICE_SLOTS; do
    [[ "$seen" == *" $(devbox_service_of_slot "$slot") "* ]] || continue
    name="$(devbox_service_var "$slot")"
    case "$names" in *" $name "*)
      echo "devbox: $file: two services export $name; give one another name in DEVBOX_SERVICE_ENV" >&2; return 2 ;;
    esac
    names="$names$name "
  done
  if [[ "$seen" == *" postgres "* ]]; then
    DEVBOX_NEEDS_POSTGRES=1
    DEVBOX_DB_URL_VAR="$(devbox_service_var postgres)"
  else
    DEVBOX_NEEDS_POSTGRES=0
    DEVBOX_DB_URL_VAR=""
  fi
  # DEVBOX_WORKER_MEMORY, the memory one test worker needs (section 7), and
  # DEVBOX_STEP_MEMORY, the memory a step without a runner reserves (the
  # step-memory-budget spec, D2). The runner computes with both in bash
  # arithmetic, which evaluates whatever text it is given, so each is checked
  # here and crosses as a byte count.
  case "$DEVBOX_KV_SEEN" in *" DEVBOX_WORKER_MEMORY "*) ;; *) DEVBOX_WORKER_MEMORY=1536M ;; esac
  case "$DEVBOX_KV_SEEN" in *" DEVBOX_STEP_MEMORY "*) ;; *) DEVBOX_STEP_MEMORY=2G ;; esac
  for key in DEVBOX_WORKER_MEMORY DEVBOX_STEP_MEMORY; do
    if ! n="$(devbox_size_bytes "${!key}")"; then
      echo "devbox: $file: refusing $key '${!key}': write a whole number with K, M or G, such as 1536M" >&2
      return 2
    fi
    printf -v "${key}_BYTES" '%s' "$n"
  done
}

# The bytes of a size written as a whole number with K, M or G, such as 1536M,
# or status 1. Nine digits keep 999999999G inside a 64-bit integer.
devbox_size_bytes() {
  [[ "$1" =~ ^([1-9][0-9]{0,8})([KMG]?)$ ]] || return 1
  local n="${BASH_REMATCH[1]}"
  case "${BASH_REMATCH[2]}" in K) n=$((n * 1024)) ;; M) n=$((n * 1048576)) ;; G) n=$((n * 1073741824)) ;; esac
  printf '%s\n' "$n"
}

# Whether a checkout with no .devbox.env may run its gate on this machine
# (spec D11). $1 is 1 when the developer passed --local, else 0. Returns 0 to
# run it, and 1 with the refusal on stderr; the caller exits 2.
#
# A missing .devbox.env ran the whole gate on the laptop with one notice line:
# concurrent gates of several worktrees put more test workers on one laptop
# than it had cores. `ci`, the default since release 4.0, keeps a CI job,
# which has no .devbox.env, and a developer who asks by name. `never` refuses
# both, and `always`, the release 3 default, stays for a project that writes it.
devbox_local_gate_allowed() {
  case "${DEVBOX_LOCAL_GATE:-ci}" in
    always) return 0 ;;
    ci)
      [ -z "${CI:-}" ] && [ "${1:-0}" != 1 ] || return 0
      echo "devbox verify: no .devbox.env, and DEVBOX_LOCAL_GATE=ci refuses a gate on this machine; pass --local, or set CI in a CI job" >&2 ;;
    *)
      echo "devbox verify: no .devbox.env, and DEVBOX_LOCAL_GATE=$DEVBOX_LOCAL_GATE refuses a gate on this machine; write a .devbox.env that names a target" >&2 ;;
  esac
  return 1
}

# Print the lock files the default setup installs, one per line: each uv.lock,
# package-lock.json, pnpm-lock.yaml and yarn.lock that git tracks in the
# checkout in $PWD, outside node_modules/ and .venv/. The setup skip, the plan's
# setup key and `devbox ci cache` know their outputs: .venv/ beside a uv.lock,
# node_modules/ beside the other three. A tracked file is a file the sync sends
# unless an exclude rule holds it back, and the hooks skip a lock file that did
# not arrive.
devbox_lock_files() {
  local out path
  out="$(git ls-files -- ':(glob)**/uv.lock' ':(glob)**/package-lock.json' \
    ':(glob)**/pnpm-lock.yaml' ':(glob)**/yarn.lock')" || {
    echo "devbox: git ls-files failed in $PWD, so the lock files of the setup are unknown" >&2
    return 1
  }
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "/$path" in */node_modules/*|*/.venv/*) continue ;; esac
    printf '%s\n' "$path"
  done <<<"$out"
}

# With no DEVBOX_SETUP in the file $1, the setup is devbox_install_locks, and
# with no DEVBOX_SETUP_INPUTS either, the setup skip keys on the lock files it
# installs, through the same DEVBOX_SETUP_INPUTS path a project would write.
# A pnpm or yarn lock file was refused here until every project with one wrote
# its own install: a default that left those packages out would run the gate
# with no dependencies, the silent skip this repository keeps finding. The
# default installs them now, and a machine with no pnpm or yarn fails the
# setup by name (_devbox_install_lock), so the gate still never runs without
# its dependencies.
#
# DEVBOX_SETUP_LOCKS, the lock files devbox_install_locks installs, is fixed
# here, before a caller such as devbox-probe empties DEVBOX_SETUP_INPUTS to
# turn the skip off: the lock files DEVBOX_SETUP_INPUTS names when it names
# one, else every tracked one. MEASURED: a project may track a lock file its setup
# never installed, such as one of a second app in the same repository.
devbox_config_default_setup() {
  local file="$1" locks path
  local -a inputs=()
  DEVBOX_SETUP_LOCKS=""
  case "$DEVBOX_SETUP" in *devbox_install_locks*) ;; *) return 0 ;; esac
  read -r -a inputs <<<"$DEVBOX_SETUP_INPUTS"
  for path in ${inputs[@]+"${inputs[@]}"}; do
    case "${path##*/}" in
      uv.lock|package-lock.json|pnpm-lock.yaml|yarn.lock) DEVBOX_SETUP_LOCKS+="$path"$'\n' ;;
    esac
  done
  if [ -z "$DEVBOX_SETUP_LOCKS" ]; then
    DEVBOX_SETUP_LOCKS="$(devbox_lock_files)" || return 2
  fi
  [ "$DEVBOX_SETUP_DEFAULT" = 1 ] || return 0
  [ -z "$DEVBOX_SETUP_INPUTS" ] || return 0
  locks="$(printf '%s' "$DEVBOX_SETUP_LOCKS" | tr '\n' ' ')"
  devbox_config_paths_ok DEVBOX_SETUP_INPUTS "$locks" "$file" || return 2
  DEVBOX_SETUP_INPUTS="${locks% }"
}

# Load the config of the checkout in $PWD. Sets DEVBOX_CONFIG, the file to name
# in messages, and DEVBOX_EXCLUDE, the rsync exclude list.
#
# An older client sourced .devbox/profile.sh, with a notice on every run.
# This client reads only .devbox/config.env, and names the old file when it
# finds one, so a checkout that never converted is told what to do.
# devbox-sync, sourced by the caller, reads DEVBOX_EXCLUDE.
# shellcheck disable=SC2034
devbox_config_load() {
  if [ -f .devbox/config.env ]; then
    DEVBOX_CONFIG="$PWD/.devbox/config.env"
    DEVBOX_EXCLUDE=.devbox/exclude
    devbox_config_parse "$DEVBOX_CONFIG" || return
    devbox_config_default_setup "$DEVBOX_CONFIG"
  elif [ -f .devbox/profile.sh ]; then
    echo "devbox: .devbox/profile.sh is an older format this client does not read. Convert it to .devbox/config.env and rename .devbox/rsync-filter to .devbox/exclude." >&2
    return 2
  else
    echo "devbox: no .devbox/config.env in $PWD" >&2
    return 2
  fi
}

# ── the developer's .devbox.env ──────────────────────────────────────────────

# Every key a developer may set in .devbox.env, beside DEVBOX_TARGET_<NAME> and
# DEVBOX_TARGET_<NAME>_HOSTKEY. A target name holds no underscore, so the
# second can never be read as the address of a target named <NAME>_HOSTKEY.
DEVBOX_ENV_KEYS=" DEVBOX_TARGETS DEVBOX_GATE_PASSWORD DEVBOX_RENT RUNPOD_KEY HCLOUD_TOKEN \
DEVBOX_MAX_QUEUE_WAIT DEVBOX_QUEUE_FULL_ACTION DEVBOX_RUNPOD_IMAGE DEVBOX_RUNPOD_CPUS \
DEVBOX_RUNPOD_IDLE_SECONDS DEVBOX_RUNPOD_MAX_HOURLY DEVBOX_RUNPOD_REGIONS \
DEVBOX_HETZNER_SERVER_TYPE DEVBOX_HETZNER_LOCATION DEVBOX_HETZNER_IDLE_SECONDS \
DEVBOX_AFFINITY_GRACE DEVBOX_REJOIN_SECONDS "
DEVBOX_ENV_TARGET_RE='^DEVBOX_TARGET_[A-Z0-9]+(_HOSTKEY)?$'

# A host key pin: the SHA256 fingerprint of an ed25519 host key, exactly as
# `ssh-keygen -lf` prints it. SHA-256 is 32 bytes, which is 43 characters of
# unpadded base64. One rule, read by the parser here and by devbox-transport.
devbox_hostkey_pin_ok() {
  [[ "${1-}" =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]]
}

# The replacement of each removed key. A removed key is refused by name,
# never ignored: an older file that still says DEVBOX_ENABLED=0 would otherwise run
# its gates on a target the developer meant to switch off.
devbox_env_removed_key() {
  case "$1" in
    DEVBOX_HOST) echo "Name each host in DEVBOX_TARGETS, and give each its address in DEVBOX_TARGET_<NAME>, such as DEVBOX_TARGETS=lan1 and DEVBOX_TARGET_LAN1=<its address>." ;;
    DEVBOX_ENABLED) echo "A file that sets DEVBOX_TARGETS or DEVBOX_RENT is on. Remove both keys, or the file, to run the gate here." ;;
    DEVBOX_BACKEND) echo "Write DEVBOX_RENT=runpod to rent when no deployed target can take the gate, or run 'devbox verify --target runpod'." ;;
    DEVBOX_RUNPOD_SECONDS) echo "Write DEVBOX_RUNPOD_IDLE_SECONDS." ;;
    DEVBOX_VERIFY) devbox_config_removed_key "$1" ;;
    *) return 1 ;;
  esac
}

# The .devbox.env a checkout uses, printed as one path, or a non-zero exit when
# it has none. $1 is the checkout root.
#
# `.devbox.env` names one developer's machines, so every project that has one
# gitignores it, and a git worktree holds no gitignored file. Looking in $ROOT
# alone therefore sent every worktree down run_local while the main checkout of
# the same project used the devbox: concurrent gate runs put more test
# workers on one laptop than it had cores, and the load average went far
# above the core count, MEASURED. A linked
# worktree borrows the main checkout's file, beside the git common dir, which
# names the same machines. verify, gc and doctor each carried this lookup, and
# now share this one.
devbox_env_find() {
  local root="$1" env_file git_common
  env_file="$root/.devbox.env"
  if [ ! -f "$env_file" ]; then
    git_common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    [ -n "$git_common" ] && env_file="$(dirname "$git_common")/.devbox.env"
  fi
  [ -f "$env_file" ] || return 1
  printf '%s' "$env_file"
}

# Read a .devbox.env as data, and check what one key says about another.
#
# Every key in the list is unset first, and so is every DEVBOX_TARGET_<NAME>.
# A value exported by some earlier shell must not stand in for a line this
# developer's file is missing: an exported RUNPOD_KEY once rented a pod for a
# file that named none. DEVBOX_STRICT=1 is the one exception, and only for a
# DEVBOX_* key: the caller hands those values over in DEVBOX_ENV_KEEP. No value
# is exported here, so the gate password and the rental keys stay out of every
# child's environment. devbox-transport sets the password in the environment
# of each ssh it starts, and nowhere else.
#
# Sets DEVBOX_DEPLOYED, the deployed targets in DEVBOX_TARGETS order, and
# DEVBOX_RENTED, the rented targets in DEVBOX_RENT order. The addresses are
# checked by devbox-targets, which knows the transport's rule. Each listed
# target needs its pin, DEVBOX_TARGET_<NAME>_HOSTKEY: without one, the first
# contact would record whatever answered, and send it the gate password.
# shellcheck disable=SC2034  # DEVBOX_DEPLOYED and DEVBOX_RENTED are read by the callers
devbox_env_load() {
  local file="$1" key name var pair pin listed=" " rent=" " kept=" "
  local -a names=()
  for key in $DEVBOX_ENV_KEYS $(compgen -v DEVBOX_TARGET_); do
    unset "$key"
  done
  DEVBOX_DEPLOYED=()
  DEVBOX_RENTED=()
  devbox_kv_parse "$file" "$DEVBOX_ENV_KEYS" "$DEVBOX_ENV_TARGET_RE" devbox_env_removed_key || return 2
  # DEVBOX_STRICT=1 lets the environment win. devbox-verify fills
  # DEVBOX_ENV_KEEP with NAME=value for each DEVBOX_* key of this list that the
  # environment set, because a test driver names its target for one call, and
  # an older client let the file replace that host, so the run went to the developer's
  # machine instead. The values land after the parse and before every check
  # below, so a kept value is checked like a line of the file. None is exported:
  # the unset above dropped the export, and printf -v sets a shell variable.
  # shellcheck disable=SC2153  # devbox-verify assigns it; gc and doctor leave it unset
  for pair in ${DEVBOX_ENV_KEEP[@]+"${DEVBOX_ENV_KEEP[@]}"}; do
    key="${pair%%=*}"
    printf -v "$key" '%s' "${pair#*=}"
    kept="$kept$key "
    case "$DEVBOX_KV_SEEN" in *" $key "*) ;; *) DEVBOX_KV_SEEN="$DEVBOX_KV_SEEN$key " ;; esac
  done
  # The interval of the probe a waiting run sends the targets it skipped. It
  # lands in bash arithmetic in devbox-verify, a context that evaluates any text
  # it is given, so it is refused here, by name and file, before a target is asked.
  if [ -n "${DEVBOX_REJOIN_SECONDS+x}" ] && ! is_uint "$DEVBOX_REJOIN_SECONDS"; then
    echo "devbox: $file: DEVBOX_REJOIN_SECONDS is '$DEVBOX_REJOIN_SECONDS'. Write a whole number of seconds, or 0 to turn the probe while waiting off." >&2
    return 2
  fi
  if [ -n "${DEVBOX_TARGETS:-}" ]; then
    IFS=, read -r -a names <<<"$DEVBOX_TARGETS"
    for name in "${names[@]}"; do
      if [[ ! "$name" =~ ^[a-z0-9]+$ ]]; then
        echo "devbox: $file: DEVBOX_TARGETS holds '$name'. A target name is lowercase letters and digits only, and the list is separated by commas with no spaces." >&2
        return 2
      fi
      # A deployed target named like a rented one, or like the laptop, would
      # make `--target runpod` mean two things.
      case "$name" in runpod|hetzner|local)
        echo "devbox: $file: DEVBOX_TARGETS may not name '$name', which names a rented target or the laptop" >&2
        return 2 ;;
      esac
      case "$listed" in *" $name "*)
        echo "devbox: $file: DEVBOX_TARGETS names $name twice" >&2; return 2 ;;
      esac
      listed="$listed$name "
      var="DEVBOX_TARGET_${name^^}"
      case "$DEVBOX_KV_SEEN" in *" $var "*) ;; *)
        echo "devbox: $file: DEVBOX_TARGETS lists $name, and the file sets no $var. Write $var=<address> or <address>:<port>." >&2
        return 2 ;;
      esac
      case "$DEVBOX_KV_SEEN" in *" ${var}_HOSTKEY "*) ;; *)
        echo "devbox: $file: DEVBOX_TARGETS lists $name, and the file sets no ${var}_HOSTKEY, the fingerprint of its ed25519 host key. Copy the ${var}_HOSTKEY line that the operator's deploy prints for $name. Without it, the first contact would send the gate password to whatever answered." >&2
        return 2 ;;
      esac
      pin="${var}_HOSTKEY"
      pin="${!pin}"
      if ! devbox_hostkey_pin_ok "$pin"; then
        echo "devbox: $file: ${var}_HOSTKEY is '$pin', and a pin is SHA256:<43 characters>, as ssh-keygen -lf prints it. Copy the ${var}_HOSTKEY line that the operator's deploy prints for $name." >&2
        return 2
      fi
      DEVBOX_DEPLOYED+=("$name")
    done
  fi
  for key in $DEVBOX_KV_SEEN; do
    [[ "$key" =~ $DEVBOX_ENV_TARGET_RE ]] || continue
    # A target list the environment named replaces the file's list, so an
    # address only the file sets is a target this call does not use.
    case "$kept" in *" DEVBOX_TARGETS "*)
      case "$kept" in *" $key "*) ;; *) continue ;; esac ;;
    esac
    name="${key#DEVBOX_TARGET_}"
    name="${name%_HOSTKEY}"
    name="${name,,}"
    case "$listed" in *" $name "*) ;; *)
      echo "devbox: $file sets $key, and DEVBOX_TARGETS does not list $name. Add $name to DEVBOX_TARGETS, or remove the line." >&2
      return 2 ;;
    esac
  done
  if [ "${#DEVBOX_DEPLOYED[@]}" -gt 0 ] && [ -z "${DEVBOX_GATE_PASSWORD:-}" ]; then
    echo "devbox: $file lists deployed targets and sets no DEVBOX_GATE_PASSWORD. A client reaches every deployed target as the gate account with that password." >&2
    return 2
  fi
  if [ -n "${DEVBOX_RENT:-}" ]; then
    IFS=, read -r -a names <<<"$DEVBOX_RENT"
    for name in "${names[@]}"; do
      # `devbox status` passes keyless-rent as $2: a provider with no key is a
      # line in its view, and a refusal here would hide every
      # target with it. Every caller that rents keeps the refusal.
      case "$name" in
        runpod)
          [ -n "${RUNPOD_KEY:-}" ] || [ "${2-}" = keyless-rent ] || {
            echo "devbox: $file: DEVBOX_RENT names runpod, and RUNPOD_KEY is missing from the file" >&2; return 2; } ;;
        hetzner)
          [ -n "${HCLOUD_TOKEN:-}" ] || [ "${2-}" = keyless-rent ] || {
            echo "devbox: $file: DEVBOX_RENT names hetzner, and HCLOUD_TOKEN is missing from the file" >&2; return 2; } ;;
        *)
          echo "devbox: $file: DEVBOX_RENT holds '$name'. Write runpod or hetzner, separated by commas, with no spaces." >&2
          return 2 ;;
      esac
      case "$rent" in *" $name "*)
        echo "devbox: $file: DEVBOX_RENT names $name twice" >&2; return 2 ;;
      esac
      rent="$rent$name "
      DEVBOX_RENTED+=("$name")
    done
  fi
}

# Fill DEVBOX_ENV_KEEP with NAME=value for each DEVBOX_* key of the .devbox.env
# list, and each DEVBOX_TARGET_<NAME>, that the environment exports. A caller
# runs it under DEVBOX_STRICT=1 alone, before devbox_env_load. devbox-verify
# and devbox-status both apply the strict rule, and two copies of this loop
# would let the two disagree on which target a strict caller named.
# shellcheck disable=SC2034  # read by devbox_env_load
devbox_env_keep_from_environment() {
  local env_name
  DEVBOX_ENV_KEEP=()
  while IFS= read -r env_name; do
    case "$env_name" in DEVBOX_*) ;; *) continue ;; esac
    if [[ "$DEVBOX_ENV_KEYS" == *" $env_name "* ]] || [[ "$env_name" =~ $DEVBOX_ENV_TARGET_RE ]]; then
      DEVBOX_ENV_KEEP+=("$env_name=${!env_name}")
    fi
  done < <(compgen -e)
}

# Decide whether one DEVBOX_FORWARD_ENV name crosses to the gate. Returns 0 to
# forward it, 1 to skip a name this run's environment does not export, and
# exits 2 to refuse it, marked as devbox's own exit for strict mode.
#
# DEVBOX_FORWARD_ENV sits in .devbox/config.env, which any contributor edits.
# Its test was `${!name+x}`, which is true for every SHELL variable, and
# devbox_env_load sets the gate password, the rental keys and every target
# address as shell variables that are never exported. So a committed
# `DEVBOX_FORWARD_ENV=DEVBOX_GATE_PASSWORD RUNPOD_KEY` wrote both secrets into
# the gate's env file on every target, and into the pod's run script. A
# .devbox.env key is refused by name, and any other name crosses only when the
# environment this run started with exports it, which is where a developer's
# switch comes from.
devbox_forward_name() {
  local name="$1"
  require_env_name "$name" "$DEVBOX_CONFIG"
  if [[ "$DEVBOX_ENV_KEYS" == *" $name "* ]] || [[ "$name" =~ $DEVBOX_ENV_TARGET_RE ]]; then
    echo "${DEVBOX_GUARD_WHO:-devbox}: refusing $name in DEVBOX_FORWARD_ENV from $DEVBOX_CONFIG: it is a .devbox.env key, and no .devbox.env value reaches a gate" >&2
    devbox_guard_exit
  fi
  [ -n "${!name+x}" ] || return 1
  [[ "${!name@a}" == *x* ]]
}

# The shell text that defines devbox_environment, devbox_setup, devbox_verify
# and, when set, devbox_provision. It crosses to the workspace on stdin, so no
# command from config.env ever becomes part of an ssh argv. The remote entry
# still ends in `devbox_setup` or `devbox_verify`, a stable name that a caller
# can match.
#
# With DEVBOX_SETUP_INPUTS set, devbox_setup skips the project's setup when
# the key of devbox_setup_key equals the key the last passed setup wrote in
# this workspace, and its outputs exist (spec section 6.6). MEASURED: a
# one-file test run lost its grant twice, because the sync and a full `npm ci`
# of an unchanged lock file outlasted DEVBOX_HOLD_PREP_SECONDS each time. The
# key crosses as a constant in this text: it is a hash, never a secret. The
# setup body keeps its own function, called as a plain command, so set -e
# stops it on a failed line as it did when it was devbox_setup itself; a call
# under `||` or `if` would switch set -e off for the whole body.
#
# The key files live in DEVBOX_SETUP_KEY_DIR, the workspace home volume, which
# a collected workspace loses with its node_modules/. A caller that runs the
# hooks on this machine sets it to a directory of its own before it calls
# devbox_hooks_script; the value is fixed into the text here.
#
# The key file holds the key on its first line, the only line a reader of the
# key takes, and the lines of devbox_setup_key_lines after it, so a setup that
# runs names the input that changed. MEASURED: a seed copied a warm sibling into
# new workspaces, and most of them then ran the whole setup with the same lock
# files as the sibling. The key held one hash, so the gate could not say why.
# Most of those had committed a change to the setup script their
# DEVBOX_SETUP_INPUTS names, which is part of the key by design: a setup
# script that gains an install must run. A workspace that skipped had changed
# no input of its key.
#
# DEVBOX_HOOKS_TARGET is `local` when the hooks run on this machine, as
# `devbox verify --local` runs them, set as a prefix of the call, and unset for
# a workspace. A local setup gets no _devbox_repair_links: that repair is for a
# synced workspace, which received a dangling link, and in a checkout on this
# machine a .venv or node_modules symlink below the root is the developer's
# own. The repair would delete it on every local setup. Unset here, when this
# file is sourced: an exported value would strip the repair from the hooks
# every workspace receives, and bring back the dangling venv that
# devbox_repair_hooks records.
unset DEVBOX_HOOKS_TARGET
DEVBOX_SETUP_KEY_DIR=/home/dev/.devbox/setup
devbox_hooks_script() {
  local key="" lines="" locks repair=""
  if [ -n "${DEVBOX_SETUP_INPUTS:-}" ]; then
    lines="$(devbox_setup_key_lines)" || return 1
    key="$(devbox_setup_key "$lines")" || return 1
  fi
  printf 'devbox_environment() {\n%s\n}\n' "${DEVBOX_ENVIRONMENT:-:}"
  [ -z "${DEVBOX_PROVISION:-}" ] || printf 'devbox_provision() {\n%s\n}\n' "$DEVBOX_PROVISION"
  case "${DEVBOX_SETUP-}" in
    *devbox_install_locks*)
      if [ -z "${DEVBOX_SETUP_LOCKS+x}" ]; then
        echo "devbox: DEVBOX_SETUP calls devbox_install_locks, and no config load listed its lock files" >&2
        return 1
      fi
      devbox_install_hooks "$DEVBOX_SETUP_LOCKS" ;;
  esac
  if [ "${DEVBOX_HOOKS_TARGET-}" != local ]; then
    # Outside a git checkout no lock file is known: a test fixture that calls
    # this function with a setup of its own, which repairs nothing below the
    # root. A setup that installs lock files had its list from
    # devbox_config_load, which refuses a checkout git cannot list.
    locks="$(devbox_lock_files 2>/dev/null)" || locks=""
    repair="$(devbox_repair_hooks "$locks")"
  fi
  [ -z "$repair" ] || printf '%s\n' "$repair"
  if [ -z "$key" ]; then
    # A setup with no inputs removes the key file first. devbox-probe sends
    # its setup with no inputs, to install the lock files of another revision,
    # and the key a keyed setup wrote before stayed beside them. The seed takes
    # any workspace with a key file as a source, so a new workspace whose
    # inputs equal that stale key would skip its setup and run on another
    # revision's node_modules/. Found reading the code for D9 of
    # docs/specs/2026-11-15-gate-fixes-4-0-1-design.md, and reproduced in
    # tests/test-seed.sh before this line was added. With no key file the
    # workspace is no source until a setup with inputs writes one.
    printf 'devbox_setup() {\n'
    [ -z "${DEVBOX_PROJECT:-}" ] ||
      printf 'rm -f -- %q || return\n' "$DEVBOX_SETUP_KEY_DIR/$DEVBOX_PROJECT.key"
    printf '%s%s\n}\n' "${repair:+_devbox_repair_links$'\n'}" "$DEVBOX_SETUP"
  else
    printf '_devbox_setup_body() {\n%s\n}\n' "$DEVBOX_SETUP"
    cat <<'WHY'
# Print why the setup runs, from devbox_setup's locals: no key, an output
# gone, or each line of the key this workspace's key file does not hold.
_devbox_setup_why() {
  local _had _line _kind _path _names="" _n
  local -a _rec=()
  if [ -z "$_devbox_setup_have" ]; then
    echo "this workspace has no key of a setup that passed"
    return 0
  fi
  if [ "$_devbox_setup_want" = "$_devbox_setup_have" ]; then
    read -r -a _rec <<<"$_devbox_setup_gone"
    _n=is
    [ "${#_rec[@]}" -lt 2 ] || _n=are
    echo "the key matches, and ${_rec[*]} $_n missing"
    return 0
  fi
  # A key file that cannot be read now reads as one with no lines: the
  # message below says so, and the setup runs either way.
  mapfile -t -s 1 _rec <"$_devbox_setup_file" 2>/dev/null || _rec=()
  if [ "${#_rec[@]}" -eq 0 ]; then
    echo "the key in this workspace differs, and the client that wrote it kept no inputs to compare"
    return 0
  fi
  _had="$(printf '%s\n' "${_rec[@]}")"
  while IFS= read -r _line; do
    case $'\n'"$_had"$'\n' in *$'\n'"$_line"$'\n'*) continue ;; esac
    read -r _kind _path _ <<<"$_line"
    case "$_kind" in
      setup) _names+=" DEVBOX_SETUP" ;;
      install) _names+=" the client's install of the lock files" ;;
      file|missing) _names+=" $_path" ;;
    esac
  done <<<"$_devbox_setup_lines"
  while read -r _kind _path _; do
    case "$_kind" in file|missing) ;; *) continue ;; esac
    case $'\n'"$_devbox_setup_lines"$'\n' in
      *$'\n'"file $_path "*|*$'\n'"missing $_path"$'\n'*) ;;
      *) _names+=" $_path" ;;
    esac
  done <<<"$_had"
  if [ -z "$_names" ]; then
    echo "the order of DEVBOX_SETUP_INPUTS changed since the setup that wrote this workspace's key"
  else
    echo "${_names# } changed since the setup that wrote this workspace's key"
  fi
}
WHY
    printf 'devbox_setup() {\n'
    printf '  local _devbox_setup_dir=%q _devbox_setup_want=%q _devbox_setup_inputs=%q\n' \
      "$DEVBOX_SETUP_KEY_DIR" "$key" "$DEVBOX_SETUP_INPUTS"
    printf '  local _devbox_setup_file=%q _devbox_setup_have="" _devbox_setup_rc\n' \
      "$DEVBOX_SETUP_KEY_DIR/$DEVBOX_PROJECT.key"
    printf '  local _devbox_setup_lines=%q\n' "$lines"
    printf '  local _devbox_setup_outputs=%q\n' "${DEVBOX_SETUP_OUTPUTS:-}"
    # Before the skip test, which reads .venv/ and node_modules/ as outputs: a
    # symlink there is never one.
    [ -z "$repair" ] || printf '  _devbox_repair_links\n'
    cat <<'SETUP'
  # A key file with no complete line reads as no key, so the setup runs.
  [ ! -r "$_devbox_setup_file" ] || read -r _devbox_setup_have <"$_devbox_setup_file" || _devbox_setup_have=""
  # A collected volume, or a project that removed node_modules/, keeps no
  # outputs, and an equal key must not skip the setup that makes them. Only a
  # lock file the inputs name asks for its output, beside it: a lock file
  # the setup does not install gets no output, and a test of every root lock
  # file ran the whole setup on every gate, MEASURED.
  local _devbox_setup_in _devbox_setup_d _devbox_setup_gone=""
  for _devbox_setup_in in $_devbox_setup_inputs; do
    [ -f "$_devbox_setup_in" ] || continue
    case "$_devbox_setup_in" in */*) _devbox_setup_d="${_devbox_setup_in%/*}" ;; *) _devbox_setup_d=. ;; esac
    case "${_devbox_setup_in##*/}" in
      package-lock.json|pnpm-lock.yaml|yarn.lock) [ -d "$_devbox_setup_d/node_modules" ] || _devbox_setup_gone+=" $_devbox_setup_d/node_modules" ;;
      uv.lock) [ -d "$_devbox_setup_d/.venv" ] || _devbox_setup_gone+=" $_devbox_setup_d/.venv" ;;
    esac
  done
  # DEVBOX_SETUP_OUTPUTS, the outputs a setup writes beside no lock file. A CI
  # cache restores them with the key file, and a key restored without one of
  # them would skip the setup that makes it.
  for _devbox_setup_in in $_devbox_setup_outputs; do
    case "$_devbox_setup_in" in "~/"*) _devbox_setup_in="$HOME/${_devbox_setup_in#\~/}" ;; esac
    [ -e "$_devbox_setup_in" ] || _devbox_setup_gone+=" $_devbox_setup_in"
  done
  if [ "$_devbox_setup_want" = "$_devbox_setup_have" ] && [ -z "$_devbox_setup_gone" ]; then
    echo "==> setup: skipped, $_devbox_setup_inputs unchanged since the last setup here"
    return 0
  fi
  echo "==> setup: runs, $(_devbox_setup_why)"
  # Removed before the setup runs: a setup that fails halfway must not leave
  # the key of the last one that passed.
  rm -f -- "$_devbox_setup_file" || return
  _devbox_setup_body
  _devbox_setup_rc=$?
  [ "$_devbox_setup_rc" -eq 0 ] || return "$_devbox_setup_rc"
  if ! { mkdir -p -- "$_devbox_setup_dir" &&
    printf '%s\n%s\n' "$_devbox_setup_want" "$_devbox_setup_lines" >"$_devbox_setup_file.tmp" &&
    mv -f -- "$_devbox_setup_file.tmp" "$_devbox_setup_file"; }; then
    echo "devbox: the setup passed, and $_devbox_setup_file could not be written, so the next gate here runs the setup again" >&2
  fi
}
SETUP
  fi
  # The step hooks below replace this devbox_verify. The body fails, so a gate
  # whose step hooks did not arrive can never pass by running nothing.
  printf 'devbox_verify() {\necho "devbox: no step plan reached the workspace, so nothing ran" >&2\nreturn 2\n}\n'
  # The step runner and the plan, when devbox-verify planned a gate
  # (devbox_steps_hooks below). Here, and not appended by each caller, because
  # three paths send these hooks: a deployed target and the rented Hetzner
  # server in the gate's stdin, a RunPod pod in its run script, and this
  # machine for --local.
  [ -z "${DEVBOX_STEPS_HOOKS:-}" ] || printf '%s\n' "$DEVBOX_STEPS_HOOKS"
  # The memory one test worker needs, for the runner's worker cap (learned-
  # selection spec, section 7), and the memory a step without a runner
  # reserves (step-memory-budget spec, D2), as byte counts
  # devbox_config_services checked.
  [ -z "${DEVBOX_WORKER_MEMORY_BYTES:-}" ] || printf 'export DEVBOX_WORKER_MEMORY=%s\n' "$DEVBOX_WORKER_MEMORY_BYTES"
  [ -z "${DEVBOX_STEP_MEMORY_BYTES:-}" ] || printf 'export DEVBOX_STEP_MEMORY=%s\n' "$DEVBOX_STEP_MEMORY_BYTES"
  # devbox_services, which the step runner's devbox_verify calls before the
  # first step (D8), on all three remote paths. RUN_ID is devbox-verify's run
  # id, which names the run's vhost and bucket.
  if [ -n "${DEVBOX_SERVICES:-}" ]; then
    devbox_services_load && devbox_services_hook "${RUN_ID:-}" || return 1
  fi
}

# DEVBOX_SETUP on this machine, in the checkout in $PWD after
# devbox_config_load: `devbox setup`, and `devbox verify --local` before its
# steps. $1 names the program in messages. Returns the setup's status.
#
# A gate on this machine ran no setup, so every consumer's CI job repeated its
# install commands in the workflow before `devbox verify --local --step <s>
# --shard <i>/<n>`, a second copy of the setup that drifts from the config.
# One workflow said so in a comment beside its `npm ci`.
#
# The order of a remote gate: the setup phase runs devbox_environment and
# devbox_setup in a bash of their own, and the gate starts the declared
# services only after it. A failed setup returns its own status after its own
# output, with no message of devbox's, as a failed remote setup does. The
# caller exits with it.
#
# The setup key lives in this worktree's own git dir, <git common dir>/
# worktrees/<name>/ for a linked worktree, beside the node_modules/ and .venv/
# it describes. One key in the common dir would let one worktree's setup skip
# another's, whose outputs exist and are stale. The private dir is under
# XDG_RUNTIME_DIR or TMPDIR, which a logout or a reboot clears while the
# outputs stay. `git worktree remove` removes the git dir with the outputs.
# `devbox ci cache` names the same directory, so a CI cache restores the key
# with the outputs.
devbox_setup_local() {
  local who="$1" git_dir setup_hooks
  git_dir="$(git rev-parse --path-format=absolute --git-dir)" || {
    echo "$who: git could not name the git dir of $PWD, so the setup has no key directory and did not run" >&2
    return 1
  }
  setup_hooks="$(DEVBOX_SETUP_KEY_DIR="$git_dir/devbox/setup" DEVBOX_STEPS_HOOKS='' DEVBOX_SERVICES='' DEVBOX_HOOKS_TARGET=local devbox_hooks_script)" || {
    echo "$who: could not build the hooks of the setup, so it did not run" >&2
    return 1
  }
  echo "==> setup"
  bash -c "$setup_hooks"$'\n''devbox_environment && devbox_setup'
}

# The install of one lock file in the workspace, by its name: `uv sync
# --locked --all-packages` beside a uv.lock, `npm ci` beside a package-lock.json,
# the install each project wrote in a setup of its own. --locked, not --frozen:
# a gate must fail on a uv.lock its pyproject.toml has outgrown, and --frozen
# installs the stale lock without a word. --all-packages, because some uv
# projects are workspaces whose members the root sync leaves out. A lock file an exclude rule held
# back did not arrive, and is named, not installed. The workspace bash expands
# this text, never this one.
#
# `pnpm install --frozen-lockfile` beside a pnpm-lock.yaml, and `yarn install`
# beside a yarn.lock: `--immutable` for yarn berry, which a .yarnrc.yml beside
# the lock file marks, and `--frozen-lockfile` for yarn classic, which refuses
# `--immutable`. Each fails on a lock file its package.json has outgrown, as
# --locked does for uv. A machine without the tool fails the setup by name:
# the image carries pnpm only as a feature, and a setup that went on without
# the install would run the gate with no dependencies, the silent skip this
# repository keeps finding.
# shellcheck disable=SC2016
DEVBOX_INSTALL_LOCK_FN='_devbox_install_lock() {
  local _dir="${1%/*}" _tool
  [ "$_dir" != "$1" ] || _dir=.
  if [ ! -f "$1" ]; then
    echo "==> setup: $1 did not sync, so it is not installed"
    return 0
  fi
  case "${1##*/}" in
    uv.lock) _tool=uv ;;
    package-lock.json) _tool=npm ;;
    pnpm-lock.yaml) _tool=pnpm ;;
    yarn.lock) _tool=yarn ;;
  esac
  if ! command -v "$_tool" >/dev/null; then
    echo "devbox: $1 needs $_tool, which this machine does not have" >&2
    return 127
  fi
  case "${1##*/}" in
    uv.lock)
      echo "==> setup: uv sync --locked --all-packages in $_dir/"
      uv sync --locked --all-packages --directory "$_dir" ;;
    package-lock.json)
      echo "==> setup: npm ci in $_dir/"
      npm ci --prefix "$_dir" --no-audit --no-fund ;;
    pnpm-lock.yaml)
      echo "==> setup: pnpm install --frozen-lockfile in $_dir/"
      pnpm install --frozen-lockfile --dir "$_dir" ;;
    yarn.lock)
      if [ -f "$_dir/.yarnrc.yml" ]; then
        echo "==> setup: yarn install --immutable in $_dir/"
        (cd "$_dir" && yarn install --immutable)
      else
        echo "==> setup: yarn install --frozen-lockfile in $_dir/"
        (cd "$_dir" && yarn install --frozen-lockfile)
      fi ;;
  esac
}'

# Print devbox_install_locks for the lock files $1, one per line: the default
# setup, which a project's own DEVBOX_SETUP may also call. Only a setup that
# calls it gets it, so the hooks of every other project stay as they were.
devbox_install_hooks() {
  local lock
  printf '%s\n' "$DEVBOX_INSTALL_LOCK_FN"
  printf 'devbox_install_locks() {\n'
  while IFS= read -r lock; do
    [ -z "$lock" ] || printf '  _devbox_install_lock %q || return\n' "$lock"
  done <<<"$1"
  printf '  :\n}\n'
}

# Print _devbox_repair_links for the lock files $1, one per line, when one sits
# below the checkout root, and nothing otherwise. devbox_setup runs it first.
#
# It removes a `.venv` or `node_modules` symlink in each folder below the root
# that holds a lock file. A worktree whose .venv was a symlink to another
# checkout sent a pointer to a laptop path, and `uv venv --allow-existing`
# adopted the dangling link and left a venv with no pyvenv.cfg. MEASURED. The
# sync filter stops a new symlink at any depth, and exclusion protects an
# older one from --delete. devbox_sync_finish_script removes one at the root,
# but it runs on the host from the host's library, so a folder below the root
# is repaired here, where a new client reaches every host without a deploy.
# A project wrote this loop into its own setup for two virtualenvs below its root.
devbox_repair_hooks() {
  local lock dir dirs=""
  local -A seen=()
  while IFS= read -r lock; do
    dir="${lock%/*}"
    [ "$dir" != "$lock" ] || continue
    [ -z "${seen[$dir]+x}" ] || continue
    seen[$dir]=1
    dirs+=" $(printf '%q' "$dir")"
  done <<<"$1"
  [ -n "$dirs" ] || return 0
  printf '_devbox_repair_links() {\n  local _d _n\n  for _d in%s; do\n' "$dirs"
  printf '    for _n in .venv node_modules; do\n'
  # The workspace bash expands these, never this one.
  # shellcheck disable=SC2016
  printf '      [ ! -L "$_d/$_n" ] || rm -f -- "$_d/$_n" || return\n'
  printf '    done\n  done\n}\n'
}

# Print the lines the setup key hashes: the sha256 of the DEVBOX_SETUP text and
# of each DEVBOX_SETUP_INPUTS file, in the list's order, read on the laptop from
# the checkout in $PWD, before the sync sends the same files. A missing file
# enters the key as `missing <path>`, never as an error: a lock file the
# project deleted changes the key, so the setup runs. Every line is fixed in
# form, and the setup text enters as its own hash, so no setup text can pose
# as a file line.
devbox_setup_key_lines() {
  local path sum text
  local -a paths=()
  sum="$(printf '%s' "${DEVBOX_SETUP-}" | sha256sum)" || return 1
  text="setup ${sum%% *}"$'\n'
  # A setup that calls the client's install also keys on its text, so a client
  # that installs another way runs the setup again. A setup that does not keeps
  # the key it had, and does not run once more for a client upgrade.
  case "${DEVBOX_SETUP-}" in
    *devbox_install_locks*)
      sum="$(printf '%s' "$DEVBOX_INSTALL_LOCK_FN" | sha256sum)" || return 1
      text+="install ${sum%% *}"$'\n' ;;
  esac
  read -r -a paths <<<"${DEVBOX_SETUP_INPUTS:-}"
  for path in ${paths[@]+"${paths[@]}"}; do
    if [ -f "$path" ]; then
      sum="$(sha256sum <"$path")" || { echo "devbox: could not read $path, a DEVBOX_SETUP_INPUTS file" >&2; return 1; }
      text+="file $path ${sum%% *}"$'\n'
    elif [ -e "$path" ]; then
      echo "devbox: DEVBOX_SETUP_INPUTS names $path, which is not a file" >&2
      return 1
    else
      text+="missing $path"$'\n'
    fi
  done
  printf '%s' "$text"
}

# Print the setup key: the sha256 of devbox_setup_key_lines, every line with
# its newline, the same bytes the key hashed before the lines were kept.
# $1, when given, is the output of devbox_setup_key_lines, read once by a
# caller that needs both.
devbox_setup_key() {
  local lines="${1-}" sum
  [ "$#" -gt 0 ] || lines="$(devbox_setup_key_lines)" || return 1
  sum="$(printf '%s\n' "$lines" | sha256sum)" || return 1
  printf '%s\n' "${sum%% *}"
}

# ── the ledger of a resumable gate ───────────────────────────────────────────
#
# A gate the watchdog stopped ran every passed step and test file again on the
# next attempt, so a suite that ran out of time ran out of time again
# (docs/specs/2026-11-13-resumable-gates-design.md). The gate keeps a ledger
# of what finished, and the client resumes it.

# The tools of section 4.1, the files of client/share/ledger/ that the hooks
# write into a workspace. With DEVBOX_QUEUE_FULL_ACTION=local, or --local, the
# gate reads them from this directory itself.
DEVBOX_LEDGER_TOOL_NAMES="devbox-ledger vitest-ledger.mjs ledger-core.mjs devbox-trace-hook.mjs devbox_ledger.py"
DEVBOX_LEDGER_TOOLS_DIR="$(readlink -f "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..")/share/ledger"

# Print the bytes the ledger key hashes, in the order of section 3.2: the
# client version, the files the sync sends, .devbox/config.env, then each
# forwarded name with the sha256 of its value, sorted by name. $1 the VERSION
# file, $2 a directory that does not exist (devbox_sync_manifest's), the rest
# the forwarded names. devbox-sync must be sourced, for the sync's own list.
#
# A forwarded value may be a token, so only its hash enters the key. It reaches
# sha256sum on stdin from printf, a builtin, so no argv and no file ever holds
# it.
devbox_ledger_key_input() {
  local version="$1" dest="$2" sorted="" name sum
  shift 2
  { printf 'version\n' && cat -- "$version"; } || return 1
  printf 'files\n'
  # devbox-verify lists the files once, for the step keys of its plan, and
  # names that listing in DEVBOX_MANIFEST_FILE. A second rsync dry run and a
  # second sha256 of every synced file would double the wait before the queue
  # on a large checkout.
  if [ -n "${DEVBOX_MANIFEST_FILE:-}" ]; then
    cat -- "$DEVBOX_MANIFEST_FILE" || return 1
  else
    devbox_sync_manifest "$dest" || return 1
  fi
  { printf 'config\n' && cat -- "$DEVBOX_CONFIG"; } || return 1
  printf 'forward\n'
  [ "$#" -eq 0 ] || sorted="$(printf '%s\n' "$@" | LC_ALL=C sort)" || return 1
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    sum="$(printf '%s' "${!name-}" | sha256sum)" || return 1
    printf '%s %s\n' "$name" "${sum%% *}"
  done <<<"$sorted"
}

# Print the shell text that writes the tools and the ledger into a workspace
# and exports DEVBOX_LEDGER, DEVBOX_RESUME and DEVBOX_LEDGER_TOOLS (section
# 4.1). It follows the hooks on the gate's stdin, which the workspace bash
# evals as dev, so it runs before devbox_verify and never in a setup or a
# `devbox run`. $1 the project, $2 0 or 1 for DEVBOX_RESUME, $3 a file that
# holds the ledger's text.
#
# Every file crosses as base64 inside single quotes, decoded in the workspace.
# Its own text never becomes part of the script, so no word of a tool, or of a
# ledger a host sent back, can run. base64's alphabet holds no quote.
#
# A write that fails stops the gate before it starts, with a line that says
# so: a resumed gate with no ledger reruns every unit, and a gate whose tool is
# missing fails on "command not found", which reads like a test failure.
devbox_ledger_hooks() {
  local project="$1" resume="$2" ledger="$3" name mode b64 home=/home/dev/.devbox
  printf '_devbox_ledger_home=%s\n' "$home"
  printf '_devbox_ledger_prepare() {\n'
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf '  local d="$_devbox_ledger_home"\n  mkdir -p "$d/ledger" "$d/ledger-tools" || return\n'
  for name in $DEVBOX_LEDGER_TOOL_NAMES; do
    # Said, and the gate still runs: a gate that never calls this tool is
    # whole without it, and one that does fails on it by name.
    if [ ! -f "$DEVBOX_LEDGER_TOOLS_DIR/$name" ]; then
      echo "devbox verify: this client carries no $DEVBOX_LEDGER_TOOLS_DIR/$name, so the workspace gets no $name; reinstall the devbox client" >&2
      continue
    fi
    mode=0644
    [ "$name" != devbox-ledger ] || mode=0755
    b64="$(base64 <"$DEVBOX_LEDGER_TOOLS_DIR/$name" | tr -d '\n')" || return 1
    printf "  printf '%%s' '%s' | base64 -d >\"\$d/ledger-tools/%s.tmp\" && chmod %s \"\$d/ledger-tools/%s.tmp\" && mv -f \"\$d/ledger-tools/%s.tmp\" \"\$d/ledger-tools/%s\" || return\n" \
      "$b64" "$name" "$mode" "$name" "$name" "$name"
  done
  b64="$(base64 <"$ledger" | tr -d '\n')" || return 1
  printf "  printf '%%s' '%s' | base64 -d >\"\$d/ledger/%s.ledger\" || return\n" "$b64" "$project"
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf '  export DEVBOX_LEDGER="$d/ledger/%s.ledger" DEVBOX_RESUME=%s DEVBOX_LEDGER_TOOLS="$d/ledger-tools"\n}\n' "$project" "$resume"
  printf '_devbox_ledger_prepare || { echo "devbox: could not write the ledger or its tools under %s in the workspace, so the gate did not run" >&2; false; }\n' "$home"
}

# ── the step runner of a planned gate ────────────────────────────────────────
#
# Every consumer ran its steps with a runner of its own, in front of the
# client, and two copies of one design already disagreed
# (docs/specs/2026-11-14-client-owns-the-gate-design.md, section 1). The
# client's runner, client/share/steps/devbox-steps, runs them now.
DEVBOX_STEPS_RUNNER="$(readlink -f "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..")/share/steps/devbox-steps"

# Print the shell text that replaces devbox_verify with the runner and its
# plan (section 6.3). devbox_hooks_script appends it from DEVBOX_STEPS_HOOKS.
#   $1  remote: the runner and the plan cross as base64 inside single quotes,
#       as the ledger tools do, and are written under $2 in the workspace;
#       local: the runner is this client's own file and the plan stays where
#       it is, with only the logs under $2
#   $2  the directory of the logs, and in a workspace of the runner and plan
#   $3  the plan file on this machine
#   $4  the run id, the name of this gate's log directory
#
# The function ends in exec, so the workspace's gate process is the runner
# itself: a signal to the gate reaches the runner's own trap, which stops the
# process group of every step it started. A shell in between would die of the
# signal with no trap, and leave the steps running.
#
# Only the logs of this run stay in the directory. Without that, a workspace
# volume would keep the step logs of every gate it ran, and the collector that
# runs when the disk is nearly full evicts whole workspaces.
devbox_steps_hooks() {
  local mode="$1" home="$2" plan="$3" run="$4" b64 runner_b64
  printf '_devbox_steps_home=%q\n' "$home"
  printf 'devbox_verify() {\n'
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf '  local _d="$_devbox_steps_home" _o\n'
  if [ "$mode" = remote ]; then
    runner_b64="$(base64 <"$DEVBOX_STEPS_RUNNER" | tr -d '\n')" || return 1
    b64="$(base64 <"$plan" | tr -d '\n')" || return 1
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '  if ! { mkdir -p "$_d/steps" "$_d/logs" &&\n'
    printf "    printf '%%s' '%s' | base64 -d >\"\$_d/steps/devbox-steps.tmp\" &&\n" "$runner_b64"
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '    mv -f "$_d/steps/devbox-steps.tmp" "$_d/steps/devbox-steps" &&\n'
    printf "    printf '%%s' '%s' | base64 -d >\"\$_d/steps/plan\"; }; then\n" "$b64"
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '    echo "devbox: could not write the step runner or its plan under $_d, so the gate did not run" >&2\n'
    printf '    return 2\n  fi\n'
  else
    # shellcheck disable=SC2016  # expanded by the bash that runs the gate, never here
    printf '  mkdir -p "$_d/logs" || { echo "devbox: could not create $_d/logs, so the gate did not run" >&2; return 2; }\n'
  fi
  # The declared services answer before the first step, and a service that
  # does not fails the gate with its own code, 3 (learned-selection spec, D8).
  # A project with no service gets no devbox_services, and a gate on this
  # machine got them from devbox_services_local_up.
  printf '  if declare -F devbox_services >/dev/null; then devbox_services || return; fi\n'
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf '  for _o in "$_d"/logs/*; do [ "$_o" = "$_d/logs/%s" ] || rm -rf -- "$_o"; done\n' "$run"
  if [ "$mode" = remote ]; then
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '  export DEVBOX_STEPS_PLAN="$_d/steps/plan"'
  else
    printf '  export DEVBOX_STEPS_PLAN=%q' "$plan"
  fi
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf ' DEVBOX_STEPS_LOGS="$_d/logs/%s" DEVBOX_RUN_ID=%q\n' "$run" "$run"
  if [ "$mode" = remote ]; then
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '  exec bash "$_d/steps/devbox-steps"\n}\n'
  else
    printf '  exec bash %q\n}\n' "$DEVBOX_STEPS_RUNNER"
  fi
}
