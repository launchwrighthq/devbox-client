#!/bin/bash
# Read a project's committed .devbox/config.env and a developer's .devbox.env, both as
# data, and build the hooks a workspace runs.
# shellcheck shell=bash

# Parse a file as DATA and never source it: one KEY=value per line, `#`
# comment lines, one pair of matching outer quotes stripped, nothing expanded.
# A sourced profile made every value code, which is why devbox-verify carries a
# guard per value and doctor carried an awk reader that disagreed with `source`
# over quotes.
#
# ONE parser reads both files a client reads, .devbox/config.env and
# .devbox.env, each with its own key list. An older client sourced .devbox.env,
# so a gate password that held `$`, a quote or a backtick broke the run, or ran
# as code on the laptop.
#
#   $1  the file
#   $2  the keys it may set, space padded
#   $3  optional: a regex for further keys it may set (DEVBOX_TARGET_<NAME>)
#   $4  optional: a function that prints the replacement of a removed key and
#       returns 0, or returns 1 for a key it does not know
#
# Each key becomes a shell variable, never exported. DEVBOX_KV_SEEN lists the
# keys the file set, space padded, so a caller can tell a key the file set from
# a value some earlier shell exported.
DEVBOX_KV_SEEN=" "
devbox_kv_parse() {
  local file="$1" keys="$2" extra="${3:-}" removed="${4:-}" line key value n=0 seen=" " repl
  DEVBOX_KV_SEEN=" "
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "$line" in ""|"#"*) continue ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    if [ "$key" = "$line" ] || [[ ! "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]]; then
      echo "devbox: $file:$n is not KEY=value" >&2; return 2
    fi
    case "$keys" in *" $key "*) ;; *)
      if [ -n "$removed" ] && repl="$("$removed" "$key")"; then
        echo "devbox: $file:$n: $key is no longer read. $repl" >&2; return 2
      fi
      if [ -z "$extra" ] || [[ ! "$key" =~ $extra ]]; then
        echo "devbox: $file:$n: unknown key $key" >&2; return 2
      fi ;;
    esac
    case "$seen" in *" $key "*)
      echo "devbox: $file:$n: $key is set twice" >&2; return 2 ;;
    esac
    seen="$seen$key "
    case "$value" in \"*|\'*)
      if [ "${#value}" -lt 2 ] || [ "${value:0:1}" != "${value: -1}" ]; then
        echo "devbox: $file:$n: $key opens a quote it does not close" >&2; return 2
      fi
      value="${value:1:${#value}-2}" ;;
    esac
    printf -v "$key" '%s' "$value"
  done <"$file"
  DEVBOX_KV_SEEN="$seen"
}

# Every key a project may set. A key outside this list is refused, so a typo
# fails the run instead of silently running it with a default.
DEVBOX_CONFIG_KEYS=" DEVBOX_PROJECT DEVBOX_WANT_TOKENS DEVBOX_MIN_TOKENS DEVBOX_REQUIRES \
DEVBOX_FORWARD_ENV DEVBOX_NEEDS_POSTGRES DEVBOX_DB_URL_VAR DEVBOX_RUNPOD_IMAGE \
DEVBOX_ENVIRONMENT DEVBOX_PROVISION DEVBOX_SETUP DEVBOX_VERIFY DEVBOX_GATE_MAX_SECONDS DEVBOX_LANES \
DEVBOX_MAX_RESUMES DEVBOX_RERUN DEVBOX_SETUP_INPUTS DEVBOX_SHARED_INPUTS DEVBOX_LOCAL_GATE "

# A path of DEVBOX_SETUP_INPUTS or DEVBOX_SHARED_INPUTS, relative to the
# checkout root. The laptop hashes each one, and the steps hand them to other
# tools, so a path that leaves the checkout, starts with a dash, or holds a
# glob, a quote or a space is refused here, once, before anything reads it.
devbox_config_paths_ok() {
  local key="$1" value="$2" file="$3" path
  local -a paths=()
  read -r -a paths <<<"$value"
  for path in ${paths[@]+"${paths[@]}"}; do
    if [[ ! "$path" =~ ^[A-Za-z0-9._+@][A-Za-z0-9._+@/-]*$ ]] || [[ "/$path/" == */../* ]]; then
      echo "devbox: $file: refusing $key '$path': write paths relative to the checkout root, separated by spaces, with no '..', no leading '/' or '-', and only letters, digits and . _ + @ / -" >&2
      return 2
    fi
  done
}

# shellcheck disable=SC2034  # DEVBOX_RERUN_CONFIG is read by devbox-verify
devbox_config_parse() {
  local file="$1" image="${DEVBOX_RUNPOD_IMAGE:-}" key rc=0 rerun_file
  local rerun_env="${DEVBOX_RERUN-}" rerun_env_set="${DEVBOX_RERUN+x}"
  devbox_kv_parse "$file" "$DEVBOX_CONFIG_KEYS" || rc=2
  # DEVBOX_RERUN (spec D13): a flag beats the environment, the environment
  # beats this file, and the file beats `changed`. The parser sets each key it
  # reads as a shell variable of the same name, so a file line would replace
  # the value a developer exported, and the caller could no longer tell the
  # two apart. The file's value goes to DEVBOX_RERUN_CONFIG below, and
  # DEVBOX_RERUN is put back as the environment left it, on a refusal too.
  rerun_file="${DEVBOX_RERUN-}"
  if [ -n "$rerun_env_set" ]; then DEVBOX_RERUN="$rerun_env"; else unset DEVBOX_RERUN; fi
  [ "$rc" = 0 ] || return 2
  # The image is a default: a developer's .devbox.env, read first, may pick another.
  [ -z "$image" ] || DEVBOX_RUNPOD_IMAGE="$image"
  for key in DEVBOX_PROJECT DEVBOX_SETUP DEVBOX_VERIFY; do
    case "$DEVBOX_KV_SEEN" in *" $key "*) continue ;; esac
    # A project that describes its gate in .devbox/steps beside this file
    # needs no DEVBOX_VERIFY (client-owns-the-gate spec, D2): a migrated
    # project that had to keep a dead command here would keep a second gate
    # that nothing runs.
    if [ "$key" = DEVBOX_VERIFY ] && [ -f "$(dirname "$file")/steps" ]; then
      DEVBOX_VERIFY=""
      continue
    fi
    echo "devbox: $file sets no $key" >&2; return 2
  done
  # DEVBOX_LANES, the workspaces one worktree may hold on each target. MEASURED:
  # several runs of one worktree waited on one host's lock for tens of minutes
  # while that host ran at about a third of its CPU, because one worktree had
  # one workspace per target. Each lane costs the project a container, two
  # volumes and a Postgres role on every target, so the project sets it.
  #
  # Set here when the file does not, and never left to the environment: verify
  # takes this many lane locks and gc keeps this many lanes, so an exported
  # value would make the two disagree on which workspaces are live. The rule is
  # the library's, which every caller of this parser loads first, in a
  # subshell, because the guard exits and this parser returns its refusal.
  case "$DEVBOX_KV_SEEN" in
    *" DEVBOX_LANES "*) (require_lanes "$DEVBOX_LANES" "$file") || return 2 ;;
    *) DEVBOX_LANES=2 ;;
  esac
  # DEVBOX_MAX_RESUMES, how many times devbox verify resumes one ledger of a
  # stopped gate (resumable gates spec, D5). 0 turns resuming off. From the
  # committed file alone, as DEVBOX_LANES is: a resume builds a green from two
  # runs, so the project decides how many, and an exported value must not.
  # Checked here, before anything reaches a host, because verify compares it
  # in bash arithmetic, which evaluates whatever text it is given.
  case "$DEVBOX_KV_SEEN" in
    *" DEVBOX_MAX_RESUMES "*)
      case "$DEVBOX_MAX_RESUMES" in
        [0-9]) ;;
        *) echo "devbox: $file: refusing DEVBOX_MAX_RESUMES '$DEVBOX_MAX_RESUMES': write a whole number from 0 to 9" >&2; return 2 ;;
      esac ;;
    *) DEVBOX_MAX_RESUMES=1 ;;
  esac
  case "$DEVBOX_KV_SEEN" in
    *" DEVBOX_RERUN "*)
      case "$rerun_file" in
        changed|full) DEVBOX_RERUN_CONFIG="$rerun_file" ;;
        *) echo "devbox: $file: refusing DEVBOX_RERUN '$rerun_file': write changed or full" >&2; return 2 ;;
      esac ;;
    *) DEVBOX_RERUN_CONFIG="" ;;
  esac
  # The two input lists and the local gate rule come from the committed file
  # alone, as DEVBOX_LANES does: an exported DEVBOX_SETUP_INPUTS would skip a
  # setup the project's lock files say must run, and an exported
  # DEVBOX_LOCAL_GATE would run a gate on a laptop the project refused (D11).
  for key in DEVBOX_SETUP_INPUTS DEVBOX_SHARED_INPUTS; do
    case "$DEVBOX_KV_SEEN" in
      *" $key "*) devbox_config_paths_ok "$key" "${!key}" "$file" || return 2 ;;
      *) printf -v "$key" '%s' "" ;;
    esac
  done
  case "$DEVBOX_KV_SEEN" in
    *" DEVBOX_LOCAL_GATE "*)
      case "$DEVBOX_LOCAL_GATE" in
        always|ci|never) ;;
        *) echo "devbox: $file: refusing DEVBOX_LOCAL_GATE '$DEVBOX_LOCAL_GATE': write always, ci or never" >&2; return 2 ;;
      esac ;;
    *) DEVBOX_LOCAL_GATE=always ;;
  esac
}

# Whether a checkout with no .devbox.env may run its gate on this machine
# (spec D11). $1 is 1 when the developer passed --local, else 0. Returns 0 to
# run it, and 1 with the refusal on stderr; the caller exits 2.
#
# A missing .devbox.env ran the whole gate on the laptop with one notice line:
# concurrent gates of several worktrees put more test workers on one laptop
# than it had cores. `ci` keeps a CI job, which has no .devbox.env, and a
# developer who asks by name. `never` refuses both.
devbox_local_gate_allowed() {
  case "${DEVBOX_LOCAL_GATE:-always}" in
    always) return 0 ;;
    ci)
      [ -z "${CI:-}" ] && [ "${1:-0}" != 1 ] || return 0
      echo "devbox verify: no .devbox.env, and DEVBOX_LOCAL_GATE=ci refuses a gate on this machine; pass --local, or set CI in a CI job" >&2 ;;
    *)
      echo "devbox verify: no .devbox.env, and DEVBOX_LOCAL_GATE=$DEVBOX_LOCAL_GATE refuses a gate on this machine; write a .devbox.env that names a target" >&2 ;;
  esac
  return 1
}

# Load the config of the checkout in $PWD. Sets DEVBOX_CONFIG, the file to name
# in messages, and DEVBOX_EXCLUDE, the rsync exclude list.
#
# An older client sourced .devbox/profile.sh, with a notice on every run.
# This client reads only .devbox/config.env, and names the old file when it
# finds one, so a checkout that never converted is told what to do.
# devbox-sync, sourced by the caller, reads DEVBOX_EXCLUDE.
# shellcheck disable=SC2034
devbox_config_load() {
  if [ -f .devbox/config.env ]; then
    DEVBOX_CONFIG="$PWD/.devbox/config.env"
    DEVBOX_EXCLUDE=.devbox/exclude
    devbox_config_parse "$DEVBOX_CONFIG"
  elif [ -f .devbox/profile.sh ]; then
    echo "devbox: .devbox/profile.sh is an older format this client does not read. Convert it to .devbox/config.env and rename .devbox/rsync-filter to .devbox/exclude." >&2
    return 2
  else
    echo "devbox: no .devbox/config.env in $PWD" >&2
    return 2
  fi
}

# ── the developer's .devbox.env ──────────────────────────────────────────────

# Every key a developer may set in .devbox.env, beside DEVBOX_TARGET_<NAME> and
# DEVBOX_TARGET_<NAME>_HOSTKEY. A target name holds no underscore, so the
# second can never be read as the address of a target named <NAME>_HOSTKEY.
DEVBOX_ENV_KEYS=" DEVBOX_TARGETS DEVBOX_GATE_PASSWORD DEVBOX_RENT RUNPOD_KEY HCLOUD_TOKEN \
DEVBOX_MAX_QUEUE_WAIT DEVBOX_QUEUE_FULL_ACTION DEVBOX_RUNPOD_IMAGE DEVBOX_RUNPOD_CPUS \
DEVBOX_RUNPOD_IDLE_SECONDS DEVBOX_RUNPOD_MAX_HOURLY DEVBOX_RUNPOD_REGIONS \
DEVBOX_HETZNER_SERVER_TYPE DEVBOX_HETZNER_LOCATION DEVBOX_HETZNER_IDLE_SECONDS \
DEVBOX_AFFINITY_GRACE "
DEVBOX_ENV_TARGET_RE='^DEVBOX_TARGET_[A-Z0-9]+(_HOSTKEY)?$'

# A host key pin: the SHA256 fingerprint of an ed25519 host key, exactly as
# `ssh-keygen -lf` prints it. SHA-256 is 32 bytes, which is 43 characters of
# unpadded base64. One rule, read by the parser here and by devbox-transport.
devbox_hostkey_pin_ok() {
  [[ "${1-}" =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]]
}

# The replacement of each removed key. A removed key is refused by name,
# never ignored: an older file that still says DEVBOX_ENABLED=0 would otherwise run
# its gates on a target the developer meant to switch off.
devbox_env_removed_key() {
  case "$1" in
    DEVBOX_HOST) echo "Name each host in DEVBOX_TARGETS, and give each its address in DEVBOX_TARGET_<NAME>, such as DEVBOX_TARGETS=lan1 and DEVBOX_TARGET_LAN1=<its address>." ;;
    DEVBOX_ENABLED) echo "A file that sets DEVBOX_TARGETS or DEVBOX_RENT is on. Remove both keys, or the file, to run the gate here." ;;
    DEVBOX_BACKEND) echo "Write DEVBOX_RENT=runpod to rent when no deployed target can take the gate, or run 'devbox verify --target runpod'." ;;
    DEVBOX_RUNPOD_SECONDS) echo "Write DEVBOX_RUNPOD_IDLE_SECONDS." ;;
    *) return 1 ;;
  esac
}

# The .devbox.env a checkout uses, printed as one path, or a non-zero exit when
# it has none. $1 is the checkout root.
#
# `.devbox.env` names one developer's machines, so every project that has one
# gitignores it, and a git worktree holds no gitignored file. Looking in $ROOT
# alone therefore sent every worktree down run_local while the main checkout of
# the same project used the devbox: concurrent gate runs put more test
# workers on one laptop than it had cores, and the load average went far
# above the core count, MEASURED. A linked
# worktree borrows the main checkout's file, beside the git common dir, which
# names the same machines. verify, gc and doctor each carried this lookup, and
# now share this one.
devbox_env_find() {
  local root="$1" env_file git_common
  env_file="$root/.devbox.env"
  if [ ! -f "$env_file" ]; then
    git_common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    [ -n "$git_common" ] && env_file="$(dirname "$git_common")/.devbox.env"
  fi
  [ -f "$env_file" ] || return 1
  printf '%s' "$env_file"
}

# Read a .devbox.env as data, and check what one key says about another.
#
# Every key in the list is unset first, and so is every DEVBOX_TARGET_<NAME>.
# A value exported by some earlier shell must not stand in for a line this
# developer's file is missing: an exported RUNPOD_KEY once rented a pod for a
# file that named none. DEVBOX_STRICT=1 is the one exception, and only for a
# DEVBOX_* key: the caller hands those values over in DEVBOX_ENV_KEEP. No value
# is exported here, so the gate password and the rental keys stay out of every
# child's environment. devbox-transport sets the password in the environment
# of each ssh it starts, and nowhere else.
#
# Sets DEVBOX_DEPLOYED, the deployed targets in DEVBOX_TARGETS order, and
# DEVBOX_RENTED, the rented targets in DEVBOX_RENT order. The addresses are
# checked by devbox-targets, which knows the transport's rule. Each listed
# target needs its pin, DEVBOX_TARGET_<NAME>_HOSTKEY: without one, the first
# contact would record whatever answered, and send it the gate password.
# shellcheck disable=SC2034  # DEVBOX_DEPLOYED and DEVBOX_RENTED are read by the callers
devbox_env_load() {
  local file="$1" key name var pair pin listed=" " rent=" " kept=" "
  local -a names=()
  for key in $DEVBOX_ENV_KEYS $(compgen -v DEVBOX_TARGET_); do
    unset "$key"
  done
  DEVBOX_DEPLOYED=()
  DEVBOX_RENTED=()
  devbox_kv_parse "$file" "$DEVBOX_ENV_KEYS" "$DEVBOX_ENV_TARGET_RE" devbox_env_removed_key || return 2
  # DEVBOX_STRICT=1 lets the environment win. devbox-verify fills
  # DEVBOX_ENV_KEEP with NAME=value for each DEVBOX_* key of this list that the
  # environment set, because a test driver names its target for one call, and
  # an older client let the file replace that host, so the run went to the developer's
  # machine instead. The values land after the parse and before every check
  # below, so a kept value is checked like a line of the file. None is exported:
  # the unset above dropped the export, and printf -v sets a shell variable.
  # shellcheck disable=SC2153  # devbox-verify assigns it; gc and doctor leave it unset
  for pair in ${DEVBOX_ENV_KEEP[@]+"${DEVBOX_ENV_KEEP[@]}"}; do
    key="${pair%%=*}"
    printf -v "$key" '%s' "${pair#*=}"
    kept="$kept$key "
    case "$DEVBOX_KV_SEEN" in *" $key "*) ;; *) DEVBOX_KV_SEEN="$DEVBOX_KV_SEEN$key " ;; esac
  done
  if [ -n "${DEVBOX_TARGETS:-}" ]; then
    IFS=, read -r -a names <<<"$DEVBOX_TARGETS"
    for name in "${names[@]}"; do
      if [[ ! "$name" =~ ^[a-z0-9]+$ ]]; then
        echo "devbox: $file: DEVBOX_TARGETS holds '$name'. A target name is lowercase letters and digits only, and the list is separated by commas with no spaces." >&2
        return 2
      fi
      # A deployed target named like a rented one, or like the laptop, would
      # make `--target runpod` mean two things.
      case "$name" in runpod|hetzner|local)
        echo "devbox: $file: DEVBOX_TARGETS may not name '$name', which names a rented target or the laptop" >&2
        return 2 ;;
      esac
      case "$listed" in *" $name "*)
        echo "devbox: $file: DEVBOX_TARGETS names $name twice" >&2; return 2 ;;
      esac
      listed="$listed$name "
      var="DEVBOX_TARGET_${name^^}"
      case "$DEVBOX_KV_SEEN" in *" $var "*) ;; *)
        echo "devbox: $file: DEVBOX_TARGETS lists $name, and the file sets no $var. Write $var=<address> or <address>:<port>." >&2
        return 2 ;;
      esac
      case "$DEVBOX_KV_SEEN" in *" ${var}_HOSTKEY "*) ;; *)
        echo "devbox: $file: DEVBOX_TARGETS lists $name, and the file sets no ${var}_HOSTKEY, the fingerprint of its ed25519 host key. Copy the ${var}_HOSTKEY line that the operator's deploy prints for $name. Without it, the first contact would send the gate password to whatever answered." >&2
        return 2 ;;
      esac
      pin="${var}_HOSTKEY"
      pin="${!pin}"
      if ! devbox_hostkey_pin_ok "$pin"; then
        echo "devbox: $file: ${var}_HOSTKEY is '$pin', and a pin is SHA256:<43 characters>, as ssh-keygen -lf prints it. Copy the ${var}_HOSTKEY line that the operator's deploy prints for $name." >&2
        return 2
      fi
      DEVBOX_DEPLOYED+=("$name")
    done
  fi
  for key in $DEVBOX_KV_SEEN; do
    [[ "$key" =~ $DEVBOX_ENV_TARGET_RE ]] || continue
    # A target list the environment named replaces the file's list, so an
    # address only the file sets is a target this call does not use.
    case "$kept" in *" DEVBOX_TARGETS "*)
      case "$kept" in *" $key "*) ;; *) continue ;; esac ;;
    esac
    name="${key#DEVBOX_TARGET_}"
    name="${name%_HOSTKEY}"
    name="${name,,}"
    case "$listed" in *" $name "*) ;; *)
      echo "devbox: $file sets $key, and DEVBOX_TARGETS does not list $name. Add $name to DEVBOX_TARGETS, or remove the line." >&2
      return 2 ;;
    esac
  done
  if [ "${#DEVBOX_DEPLOYED[@]}" -gt 0 ] && [ -z "${DEVBOX_GATE_PASSWORD:-}" ]; then
    echo "devbox: $file lists deployed targets and sets no DEVBOX_GATE_PASSWORD. A client reaches every deployed target as the gate account with that password." >&2
    return 2
  fi
  if [ -n "${DEVBOX_RENT:-}" ]; then
    IFS=, read -r -a names <<<"$DEVBOX_RENT"
    for name in "${names[@]}"; do
      # `devbox status` passes keyless-rent as $2: a provider with no key is a
      # line in its view, and a refusal here would hide every
      # target with it. Every caller that rents keeps the refusal.
      case "$name" in
        runpod)
          [ -n "${RUNPOD_KEY:-}" ] || [ "${2-}" = keyless-rent ] || {
            echo "devbox: $file: DEVBOX_RENT names runpod, and RUNPOD_KEY is missing from the file" >&2; return 2; } ;;
        hetzner)
          [ -n "${HCLOUD_TOKEN:-}" ] || [ "${2-}" = keyless-rent ] || {
            echo "devbox: $file: DEVBOX_RENT names hetzner, and HCLOUD_TOKEN is missing from the file" >&2; return 2; } ;;
        *)
          echo "devbox: $file: DEVBOX_RENT holds '$name'. Write runpod or hetzner, separated by commas, with no spaces." >&2
          return 2 ;;
      esac
      case "$rent" in *" $name "*)
        echo "devbox: $file: DEVBOX_RENT names $name twice" >&2; return 2 ;;
      esac
      rent="$rent$name "
      DEVBOX_RENTED+=("$name")
    done
  fi
}

# Fill DEVBOX_ENV_KEEP with NAME=value for each DEVBOX_* key of the .devbox.env
# list, and each DEVBOX_TARGET_<NAME>, that the environment exports. A caller
# runs it under DEVBOX_STRICT=1 alone, before devbox_env_load. devbox-verify
# and devbox-status both apply the strict rule, and two copies of this loop
# would let the two disagree on which target a strict caller named.
# shellcheck disable=SC2034  # read by devbox_env_load
devbox_env_keep_from_environment() {
  local env_name
  DEVBOX_ENV_KEEP=()
  while IFS= read -r env_name; do
    case "$env_name" in DEVBOX_*) ;; *) continue ;; esac
    if [[ "$DEVBOX_ENV_KEYS" == *" $env_name "* ]] || [[ "$env_name" =~ $DEVBOX_ENV_TARGET_RE ]]; then
      DEVBOX_ENV_KEEP+=("$env_name=${!env_name}")
    fi
  done < <(compgen -e)
}

# Decide whether one DEVBOX_FORWARD_ENV name crosses to the gate. Returns 0 to
# forward it, 1 to skip a name this run's environment does not export, and
# exits 2 to refuse it, marked as devbox's own exit for strict mode.
#
# DEVBOX_FORWARD_ENV sits in .devbox/config.env, which any contributor edits.
# Its test was `${!name+x}`, which is true for every SHELL variable, and
# devbox_env_load sets the gate password, the rental keys and every target
# address as shell variables that are never exported. So a committed
# `DEVBOX_FORWARD_ENV=DEVBOX_GATE_PASSWORD RUNPOD_KEY` wrote both secrets into
# the gate's env file on every target, and into the pod's run script. A
# .devbox.env key is refused by name, and any other name crosses only when the
# environment this run started with exports it, which is where a developer's
# switch comes from.
devbox_forward_name() {
  local name="$1"
  require_env_name "$name" "$DEVBOX_CONFIG"
  if [[ "$DEVBOX_ENV_KEYS" == *" $name "* ]] || [[ "$name" =~ $DEVBOX_ENV_TARGET_RE ]]; then
    echo "${DEVBOX_GUARD_WHO:-devbox}: refusing $name in DEVBOX_FORWARD_ENV from $DEVBOX_CONFIG: it is a .devbox.env key, and no .devbox.env value reaches a gate" >&2
    devbox_guard_exit
  fi
  [ -n "${!name+x}" ] || return 1
  [[ "${!name@a}" == *x* ]]
}

# The shell text that defines devbox_environment, devbox_setup, devbox_verify
# and, when set, devbox_provision. It crosses to the workspace on stdin, so no
# command from config.env ever becomes part of an ssh argv. The remote entry
# still ends in `devbox_setup` or `devbox_verify`, a stable name that a caller
# can match.
#
# With DEVBOX_SETUP_INPUTS set, devbox_setup skips the project's setup when
# the key of devbox_setup_key equals the key the last passed setup wrote in
# this workspace, and its outputs exist (spec section 6.6). MEASURED: a
# one-file test run lost its grant twice, because the sync and a full `npm ci`
# of an unchanged lock file outlasted DEVBOX_HOLD_PREP_SECONDS each time. The
# key crosses as a constant in this text: it is a hash, never a secret. The
# setup body keeps its own function, called as a plain command, so set -e
# stops it on a failed line as it did when it was devbox_setup itself; a call
# under `||` or `if` would switch set -e off for the whole body.
#
# The key files live in DEVBOX_SETUP_KEY_DIR, the workspace home volume, which
# a collected workspace loses with its node_modules/. A caller that runs the
# hooks on this machine sets it to a directory of its own before it calls
# devbox_hooks_script; the value is fixed into the text here.
DEVBOX_SETUP_KEY_DIR=/home/dev/.devbox/setup
devbox_hooks_script() {
  local key=""
  if [ -n "${DEVBOX_SETUP_INPUTS:-}" ]; then
    key="$(devbox_setup_key)" || return 1
  fi
  printf 'devbox_environment() {\n%s\n}\n' "${DEVBOX_ENVIRONMENT:-:}"
  [ -z "${DEVBOX_PROVISION:-}" ] || printf 'devbox_provision() {\n%s\n}\n' "$DEVBOX_PROVISION"
  if [ -z "$key" ]; then
    printf 'devbox_setup() {\n%s\n}\n' "$DEVBOX_SETUP"
  else
    printf '_devbox_setup_body() {\n%s\n}\n' "$DEVBOX_SETUP"
    printf 'devbox_setup() {\n'
    printf '  local _devbox_setup_dir=%q _devbox_setup_want=%q _devbox_setup_inputs=%q\n' \
      "$DEVBOX_SETUP_KEY_DIR" "$key" "$DEVBOX_SETUP_INPUTS"
    printf '  local _devbox_setup_file=%q _devbox_setup_have="" _devbox_setup_rc\n' \
      "$DEVBOX_SETUP_KEY_DIR/$DEVBOX_PROJECT.key"
    cat <<'SETUP'
  # A key file with no complete line reads as no key, so the setup runs.
  [ ! -r "$_devbox_setup_file" ] || read -r _devbox_setup_have <"$_devbox_setup_file" || _devbox_setup_have=""
  # A collected volume, or a project that removed node_modules/, keeps no
  # outputs, and an equal key must not skip the setup that makes them. Only a
  # lock file the inputs name asks for its output, beside it: a lock file
  # the setup does not install gets no output, and a test of every root lock
  # file ran the whole setup on every gate, MEASURED.
  local _devbox_setup_in _devbox_setup_d _devbox_setup_out=1
  for _devbox_setup_in in $_devbox_setup_inputs; do
    [ -f "$_devbox_setup_in" ] || continue
    case "$_devbox_setup_in" in */*) _devbox_setup_d="${_devbox_setup_in%/*}" ;; *) _devbox_setup_d=. ;; esac
    case "${_devbox_setup_in##*/}" in
      package-lock.json) [ -d "$_devbox_setup_d/node_modules" ] || _devbox_setup_out=0 ;;
      uv.lock) [ -d "$_devbox_setup_d/.venv" ] || _devbox_setup_out=0 ;;
    esac
  done
  if [ "$_devbox_setup_want" = "$_devbox_setup_have" ] && [ "$_devbox_setup_out" = 1 ]; then
    echo "==> setup: skipped, $_devbox_setup_inputs unchanged since the last setup here"
    return 0
  fi
  # Removed before the setup runs: a setup that fails halfway must not leave
  # the key of the last one that passed.
  rm -f -- "$_devbox_setup_file" || return
  _devbox_setup_body
  _devbox_setup_rc=$?
  [ "$_devbox_setup_rc" -eq 0 ] || return "$_devbox_setup_rc"
  if ! { mkdir -p -- "$_devbox_setup_dir" &&
    printf '%s\n' "$_devbox_setup_want" >"$_devbox_setup_file.tmp" &&
    mv -f -- "$_devbox_setup_file.tmp" "$_devbox_setup_file"; }; then
    echo "devbox: the setup passed, and $_devbox_setup_file could not be written, so the next gate here runs the setup again" >&2
  fi
}
SETUP
  fi
  if [ -n "${DEVBOX_VERIFY:-}" ]; then
    printf 'devbox_verify() {\n%s\n}\n' "$DEVBOX_VERIFY"
  else
    # A project with .devbox/steps sets no DEVBOX_VERIFY, and an empty function
    # body is a syntax error in the workspace bash. The body fails, so a gate
    # whose step hooks did not arrive can never pass by running nothing.
    printf 'devbox_verify() {\necho "devbox: this gate has no DEVBOX_VERIFY and no step plan reached the workspace, so nothing ran" >&2\nreturn 2\n}\n'
  fi
  # The step runner and the plan, when devbox-verify planned a gate
  # (devbox_steps_hooks below). Here, and not appended by each caller, because
  # three paths send these hooks: a deployed target and the rented Hetzner
  # server in the gate's stdin, a RunPod pod in its run script, and this
  # machine for --local.
  [ -z "${DEVBOX_STEPS_HOOKS:-}" ] || printf '%s\n' "$DEVBOX_STEPS_HOOKS"
}

# Print the setup key: the sha256 of the DEVBOX_SETUP text and of each
# DEVBOX_SETUP_INPUTS file, in the list's order, read on the laptop from the
# checkout in $PWD, before the sync sends the same files. A missing file
# enters the key as `missing <path>`, never as an error: a lock file the
# project deleted changes the key, so the setup runs. Every line is fixed in
# form, and the setup text enters as its own hash, so no setup text can pose
# as a file line.
devbox_setup_key() {
  local path sum text
  local -a paths=()
  sum="$(printf '%s' "${DEVBOX_SETUP-}" | sha256sum)" || return 1
  text="setup ${sum%% *}"$'\n'
  read -r -a paths <<<"${DEVBOX_SETUP_INPUTS:-}"
  for path in ${paths[@]+"${paths[@]}"}; do
    if [ -f "$path" ]; then
      sum="$(sha256sum <"$path")" || { echo "devbox: could not read $path, a DEVBOX_SETUP_INPUTS file" >&2; return 1; }
      text+="file $path ${sum%% *}"$'\n'
    elif [ -e "$path" ]; then
      echo "devbox: DEVBOX_SETUP_INPUTS names $path, which is not a file" >&2
      return 1
    else
      text+="missing $path"$'\n'
    fi
  done
  sum="$(printf '%s' "$text" | sha256sum)" || return 1
  printf '%s\n' "${sum%% *}"
}

# ── the ledger of a resumable gate ───────────────────────────────────────────
#
# A gate the watchdog stopped ran every passed step and test file again on the
# next attempt, so a suite that ran out of time ran out of time again
# (docs/specs/2026-11-13-resumable-gates-design.md). The gate keeps a ledger
# of what finished, and the client resumes it.

# The tools of section 4.1, the files of client/share/ledger/ that the hooks
# write into a workspace. With DEVBOX_QUEUE_FULL_ACTION=local, or --local, the
# gate reads them from this directory itself.
DEVBOX_LEDGER_TOOL_NAMES="devbox-ledger vitest-ledger.mjs ledger-core.mjs devbox_ledger.py"
DEVBOX_LEDGER_TOOLS_DIR="$(readlink -f "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..")/share/ledger"

# Print the bytes the ledger key hashes, in the order of section 3.2: the
# client version, the files the sync sends, .devbox/config.env, then each
# forwarded name with the sha256 of its value, sorted by name. $1 the VERSION
# file, $2 a directory that does not exist (devbox_sync_manifest's), the rest
# the forwarded names. devbox-sync must be sourced, for the sync's own list.
#
# A forwarded value may be a token, so only its hash enters the key. It reaches
# sha256sum on stdin from printf, a builtin, so no argv and no file ever holds
# it.
devbox_ledger_key_input() {
  local version="$1" dest="$2" sorted="" name sum
  shift 2
  { printf 'version\n' && cat -- "$version"; } || return 1
  printf 'files\n'
  # devbox-verify lists the files once, for the step keys of its plan, and
  # names that listing in DEVBOX_MANIFEST_FILE. A second rsync dry run and a
  # second sha256 of every synced file would double the wait before the queue
  # on a large checkout.
  if [ -n "${DEVBOX_MANIFEST_FILE:-}" ]; then
    cat -- "$DEVBOX_MANIFEST_FILE" || return 1
  else
    devbox_sync_manifest "$dest" || return 1
  fi
  { printf 'config\n' && cat -- "$DEVBOX_CONFIG"; } || return 1
  printf 'forward\n'
  [ "$#" -eq 0 ] || sorted="$(printf '%s\n' "$@" | LC_ALL=C sort)" || return 1
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    sum="$(printf '%s' "${!name-}" | sha256sum)" || return 1
    printf '%s %s\n' "$name" "${sum%% *}"
  done <<<"$sorted"
}

# Print the shell text that writes the tools and the ledger into a workspace
# and exports DEVBOX_LEDGER, DEVBOX_RESUME and DEVBOX_LEDGER_TOOLS (section
# 4.1). It follows the hooks on the gate's stdin, which the workspace bash
# evals as dev, so it runs before devbox_verify and never in a setup or a
# `devbox run`. $1 the project, $2 0 or 1 for DEVBOX_RESUME, $3 a file that
# holds the ledger's text.
#
# Every file crosses as base64 inside single quotes, decoded in the workspace.
# Its own text never becomes part of the script, so no word of a tool, or of a
# ledger a host sent back, can run. base64's alphabet holds no quote.
#
# A write that fails stops the gate before it starts, with a line that says
# so: a resumed gate with no ledger reruns every unit, and a gate whose tool is
# missing fails on "command not found", which reads like a test failure.
devbox_ledger_hooks() {
  local project="$1" resume="$2" ledger="$3" name mode b64 home=/home/dev/.devbox
  printf '_devbox_ledger_home=%s\n' "$home"
  printf '_devbox_ledger_prepare() {\n'
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf '  local d="$_devbox_ledger_home"\n  mkdir -p "$d/ledger" "$d/ledger-tools" || return\n'
  for name in $DEVBOX_LEDGER_TOOL_NAMES; do
    # Said, and the gate still runs: a gate that never calls this tool is
    # whole without it, and one that does fails on it by name.
    if [ ! -f "$DEVBOX_LEDGER_TOOLS_DIR/$name" ]; then
      echo "devbox verify: this client carries no $DEVBOX_LEDGER_TOOLS_DIR/$name, so the workspace gets no $name; reinstall the devbox client" >&2
      continue
    fi
    mode=0644
    [ "$name" != devbox-ledger ] || mode=0755
    b64="$(base64 <"$DEVBOX_LEDGER_TOOLS_DIR/$name" | tr -d '\n')" || return 1
    printf "  printf '%%s' '%s' | base64 -d >\"\$d/ledger-tools/%s.tmp\" && chmod %s \"\$d/ledger-tools/%s.tmp\" && mv -f \"\$d/ledger-tools/%s.tmp\" \"\$d/ledger-tools/%s\" || return\n" \
      "$b64" "$name" "$mode" "$name" "$name" "$name"
  done
  b64="$(base64 <"$ledger" | tr -d '\n')" || return 1
  printf "  printf '%%s' '%s' | base64 -d >\"\$d/ledger/%s.ledger\" || return\n" "$b64" "$project"
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf '  export DEVBOX_LEDGER="$d/ledger/%s.ledger" DEVBOX_RESUME=%s DEVBOX_LEDGER_TOOLS="$d/ledger-tools"\n}\n' "$project" "$resume"
  printf '_devbox_ledger_prepare || { echo "devbox: could not write the ledger or its tools under %s in the workspace, so the gate did not run" >&2; false; }\n' "$home"
}

# ── the step runner of a planned gate ────────────────────────────────────────
#
# Every consumer ran its steps with a runner of its own, in front of the
# client, and two copies of one design already disagreed
# (docs/specs/2026-11-14-client-owns-the-gate-design.md, section 1). The
# client's runner, client/share/steps/devbox-steps, runs them now.
DEVBOX_STEPS_RUNNER="$(readlink -f "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..")/share/steps/devbox-steps"

# Print the shell text that replaces devbox_verify with the runner and its
# plan (section 6.3). devbox_hooks_script appends it from DEVBOX_STEPS_HOOKS.
#   $1  remote: the runner and the plan cross as base64 inside single quotes,
#       as the ledger tools do, and are written under $2 in the workspace;
#       local: the runner is this client's own file and the plan stays where
#       it is, with only the logs under $2
#   $2  the directory of the logs, and in a workspace of the runner and plan
#   $3  the plan file on this machine
#   $4  the run id, the name of this gate's log directory
#   $5  1 when the runner writes its own `step` ledger lines, 0 for the one
#       step of a DEVBOX_VERIFY gate, which writes its own ledger
#
# The function ends in exec, so the workspace's gate process is the runner
# itself: a signal to the gate reaches the runner's own trap, which stops the
# process group of every step it started. A shell in between would die of the
# signal with no trap, and leave the steps running.
#
# Only the logs of this run stay in the directory. Without that, a workspace
# volume would keep the step logs of every gate it ran, and the collector that
# runs when the disk is nearly full evicts whole workspaces.
devbox_steps_hooks() {
  local mode="$1" home="$2" plan="$3" run="$4" lines="$5" b64 runner_b64
  printf '_devbox_steps_home=%q\n' "$home"
  printf 'devbox_verify() {\n'
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf '  local _d="$_devbox_steps_home" _o\n'
  if [ "$mode" = remote ]; then
    runner_b64="$(base64 <"$DEVBOX_STEPS_RUNNER" | tr -d '\n')" || return 1
    b64="$(base64 <"$plan" | tr -d '\n')" || return 1
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '  if ! { mkdir -p "$_d/steps" "$_d/logs" &&\n'
    printf "    printf '%%s' '%s' | base64 -d >\"\$_d/steps/devbox-steps.tmp\" &&\n" "$runner_b64"
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '    mv -f "$_d/steps/devbox-steps.tmp" "$_d/steps/devbox-steps" &&\n'
    printf "    printf '%%s' '%s' | base64 -d >\"\$_d/steps/plan\"; }; then\n" "$b64"
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '    echo "devbox: could not write the step runner or its plan under $_d, so the gate did not run" >&2\n'
    printf '    return 2\n  fi\n'
  else
    # shellcheck disable=SC2016  # expanded by the bash that runs the gate, never here
    printf '  mkdir -p "$_d/logs" || { echo "devbox: could not create $_d/logs, so the gate did not run" >&2; return 2; }\n'
  fi
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf '  for _o in "$_d"/logs/*; do [ "$_o" = "$_d/logs/%s" ] || rm -rf -- "$_o"; done\n' "$run"
  if [ "$mode" = remote ]; then
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '  export DEVBOX_STEPS_PLAN="$_d/steps/plan"'
  else
    printf '  export DEVBOX_STEPS_PLAN=%q' "$plan"
  fi
  # shellcheck disable=SC2016  # expanded by the workspace bash, never here
  printf ' DEVBOX_STEPS_LOGS="$_d/logs/%s" DEVBOX_RUN_ID=%q DEVBOX_STEPS_STEP_LINES=%q\n' "$run" "$run" "$lines"
  if [ "$mode" = remote ]; then
    # shellcheck disable=SC2016  # expanded by the workspace bash, never here
    printf '  exec bash "$_d/steps/devbox-steps"\n}\n'
  else
    printf '  exec bash %q\n}\n' "$DEVBOX_STEPS_RUNNER"
  fi
}
