#!/bin/bash
# The record of one gate (docs/specs/2026-11-14-client-owns-the-gate-design.md,
# sections 6.7 and 7). Sourced by devbox-verify, devbox-plan and devbox-result,
# after lib/devbox-lib.sh, whose require_run_id checks every run id that becomes
# a file name here.
# shellcheck shell=bash
#
# Each consumer kept its own record cache and printed it as one base64 line,
# which every landing script parsed again. Consumers carried identical copies
# of that code, and the copies of one design already disagreed. The
# record is plain text now, one field per tab, in the style of the ledger:
#
#   run       <run-id>
#   at        <epoch seconds>
#   client    <VERSION>
#   branch    <branch, or - when detached>
#   commit    <sha>
#   target    <target name, or local>
#   scope     full | partial
#   complete  1 | 0
#   reason    <why a complete 0 record does not carry> (4.0.1 records on)
#   step      <name>  <key>  pass | fail | carried  <seconds>  <code>  <mode>
#   file      <step>  <runner>  <path>  pass | fail | open  <seconds or ->
#
# The mode is `full`, `narrowed`, `related` (3.3 records only), `selected` or
# `shard`. `selected` is a run of the test files the map selected, and a
# carried step whose plan said `no test read a changed file`
# (docs/specs/2026-11-14-learned-selection-design.md, D2 and D3). `shard` is
# one shard of `--step <name> --shard <i>/<n>`: it ran a part of the step's
# test files by design, so no carry, narrow or selection ever reads it.
#
# A `file` line is `open` when the ledger holds the file's `start` and no end:
# the gate ended while that file ran. Section 6.4 refuses to narrow such a step,
# because the open file's result is unknown. Its seconds come from the ledger,
# for the shard balance of D10; a 3.3 record has no such field, and reads as a
# file of unknown duration.
#
# Beside each `<run-id>.record` lie `<run-id>.files`, the manifest of the files
# that run hashed, `<run-id>.log`, the gate output the client saved, and, after
# a complete gate whose package.json or pyproject.toml names the devbox client,
# `<run-id>.unpinned`, the lines test selection compares for those files. Only a
# `complete 1` record answers a carry: a cancelled, stopped or killed gate, and
# one whose files changed while it ran, wrote `complete 0`, and a pass in it
# proves nothing about the tree it names.
#
# The `reason` line says which of those it was: `files changed while it ran`,
# `a step did not end`, or the stop, such as `stopped by SIGTERM`. MEASURED: a
# gate whose every step ended, and whose files changed while it ran, printed
# that it did not end every step, because the verdict had one text for every
# `complete 0`. A record older than the line names no reason.

# The 200 newest records of a git common dir stay (section 7).
DEVBOX_RECORD_KEEP=200

# Print <git common dir>/devbox/records. The common dir, so every worktree of
# one repository reads one set: a key holds the exact content of every input,
# so a pass from another worktree or branch carries as well (section 6.2).
devbox_record_dir() {
  local common
  common="$(git rev-parse --path-format=absolute --git-common-dir)" || return 1
  printf '%s/devbox/records\n' "$common"
}

# The header fields every query of the records reads, one pass of awk over
# every record. Each query defines begin(), called at the first line of each
# file, its own line rules, and done(), called after the last line of each
# file. A file with no line at all calls neither.
# shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
_DEVBOX_RECORD_AWK_HEAD='
FNR == 1 { if (NR > 1) done(); run = ""; at = ""; complete = ""; branch = ""; scope = ""; file = FILENAME; begin() }
$1 == "run" { run = $2 }
$1 == "at" { at = $2 }
$1 == "complete" { complete = $2 }
$1 == "branch" { branch = $2 }
$1 == "scope" { scope = $2 }
END { if (NR > 0) done() }
'

# The JSON helpers every record reader that prints JSON shares: `devbox result
# --json` and devbox_record_failures. js() escapes a string by the rules of
# RFC 8259: the backslash, the quote and every control character below 0x20. A
# path may hold any byte but a tab or a newline, which the record itself cannot
# carry. num() prints the digits as written, not v + 0: an awk may print a large
# number in its %.6g form, and an epoch second would arrive as 1.7e+09. A field
# that does not read as an integer is null, so a reader never meets a number
# that is a string on one run and a number on the next. Run awk under LC_ALL=C.
# shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
_DEVBOX_RECORD_AWK_JSON='
BEGIN { for (i = 1; i < 32; i++) ctl[sprintf("%c", i)] = sprintf("\\u%04x", i) }
function js(s,   out, i, c) {
  out = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "\\") out = out "\\\\"
    else if (c == "\"") out = out "\\\""
    else if (c in ctl) out = out ctl[c]
    else out = out c
  }
  return "\"" out "\""
}
function num(v) {
  if (v !~ /^[0-9]+$/) return "null"
  sub(/^0+/, "", v)
  return v == "" ? "0" : v
}
'

# The first line of a sorted stream, read to its end. MEASURED: `sort | head -n 1`
# under pipefail failed at random once a checkout held a few hundred records:
# head exited after one line, sort died writing the rest with "Broken pipe",
# the query returned 1, and `devbox result --json` exited 1 after a complete
# gate with no output of its own. awk reads every line and keeps the first, so
# sort always finishes its write.
_DEVBOX_RECORD_FIRST='NR == 1'

# Run the awk program $1 over every record of this checkout, then print the
# first field of the newest output line. Each output line of the program is
# `<at><TAB><answer>`. Prints nothing when no record matches or none exists.
# Ties on `at` fall back to the answer in reverse byte order, so the answer is
# the same on every call.
_devbox_record_query() {
  local program="$1" dir best
  local -a files
  dir="$(devbox_record_dir)" || return 1
  [ -d "$dir" ] || return 0
  files=("$dir"/*.record)
  [ -e "${files[0]}" ] || return 0
  # awk 'NR == 1' and not head: see _DEVBOX_RECORD_FIRST.
  best="$(awk -F'\t' "$_DEVBOX_RECORD_AWK_HEAD$program" "${files[@]}" \
    | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -k2,2r | awk "$_DEVBOX_RECORD_FIRST")" || return 1
  [ -z "$best" ] || printf '%s\n' "${best#*$'\t'}"
}

# Write the record text file $2 and the manifest file $3 of run $1 into the
# record directory, each by rename, then keep the 200 newest records. $3 may be
# empty: a record without its manifest still carries, and never selects
# (section 7). The manifest lands first, so a record a carry finds always has
# the manifest it was written with.
devbox_record_write() {
  local run="$1" record="$2" manifest="$3" dir
  (require_run_id "$run" "the record of this gate") || return 2
  dir="$(devbox_record_dir)" || return 1
  mkdir -p -- "$dir" || { echo "devbox verify: could not create $dir, so this gate left no record" >&2; return 1; }
  if [ -n "$manifest" ]; then
    { cp -- "$manifest" "$dir/.$run.files.$$" && mv -f -- "$dir/.$run.files.$$" "$dir/$run.files"; } || {
      echo "devbox verify: could not write $dir/$run.files, so this gate left no record" >&2
      return 1
    }
  fi
  { cp -- "$record" "$dir/.$run.record.$$" && mv -f -- "$dir/.$run.record.$$" "$dir/$run.record"; } || {
    echo "devbox verify: could not write $dir/$run.record, so this gate left no record" >&2
    return 1
  }
  devbox_record_prune "$dir"
}

# Remove every record of the directory $1 past the 200 newest by `at`, with its
# manifest, its log and its unpinned lines (devbox_plan_learn). A `.log` with
# no record is a gate that still runs, and stays.
devbox_record_prune() {
  local dir="$1" path
  local -a files old
  files=("$dir"/*.record)
  [ -e "${files[0]}" ] || return 0
  [ "${#files[@]}" -gt "$DEVBOX_RECORD_KEEP" ] || return 0
  mapfile -t old < <(awk -F'\t' "$_DEVBOX_RECORD_AWK_HEAD"'
    function begin() { }
    function done() { print at "\t" file }' "${files[@]}" \
    | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -k2,2r | tail -n +"$((DEVBOX_RECORD_KEEP + 1))" | cut -f2-)
  for path in "${old[@]}"; do
    rm -f -- "$path" "${path%.record}.files" "${path%.record}.log" "${path%.record}.unpinned" || {
      echo "devbox verify: could not remove the old record $path" >&2
      return 1
    }
  done
}

# Print the run id of the newest complete record in which step $1 passed under
# the key $2. A `carried` step passed under that key in an earlier run, so it
# answers too, and keeps a key alive after the run that first passed it is
# pruned. A shard ran a part of the step's files, so it never answers: a full
# gate that carried from one shard's pass would skip every other shard.
devbox_record_find_pass() {
  # shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
  RECORD_STEP="$1" RECORD_KEY="$2" _devbox_record_query '
    function begin() { hit = 0 }
    $1 == "step" && $2 == ENVIRON["RECORD_STEP"] && $3 == ENVIRON["RECORD_KEY"] && ($4 == "pass" || $4 == "carried") && $7 != "shard" { hit = 1 }
    function done() { if (complete == "1" && hit) print at "\t" run }'
}

# Print the branch of the current checkout as a record names it: `-` for a
# detached HEAD, where symbolic-ref exits 1 (section 7). The record, the plan
# and `devbox result` read it here, so a record and the query that looks for
# it never spell one branch two ways.
devbox_record_branch() {
  git symbolic-ref --short -q HEAD || printf -- '-\n'
}

# Print `<run-id> <outcome> <code>` of step $1's newest result in a complete
# record of branch $2, a shard's left out. A detached HEAD, branch `-`, has no
# record of its own, because every detached checkout writes `-`.
#
# A narrow runs only a step's failed files and trusts this result for every
# other file. MEASURED: a resume narrowed by another branch's newer record
# read green without running this branch's own failed files
# (gate-fixes-4.0.1 spec, D1), and a fresh gate narrowed by another branch's
# record has the same hole, so no branch's result answers for another's.
devbox_record_last_of() {
  # shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
  RECORD_STEP="$1" RECORD_BRANCH="$2" _devbox_record_query '
    function begin() { res = "" }
    $1 == "step" && $2 == ENVIRON["RECORD_STEP"] && $7 != "shard" { res = $4 " " $6 }
    function done() {
      if (complete == "1" && res != "" && branch != "-" && branch == ENVIRON["RECORD_BRANCH"]) print at "\t" run " " res
    }'
}

# Print the run id of step $1's newest pass in a complete record, under any key,
# a shard's left out.
devbox_record_last_pass_of() {
  # shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
  RECORD_STEP="$1" _devbox_record_query '
    function begin() { hit = 0 }
    $1 == "step" && $2 == ENVIRON["RECORD_STEP"] && ($4 == "pass" || $4 == "carried") && $7 != "shard" { hit = 1 }
    function done() { if (complete == "1" && hit) print at "\t" run }'
}

# Print `<path>\t<seconds>` for each test file of step $1 that some record
# timed, the newest record's seconds for each, in path order. A record of any
# completeness counts: a duration is a weight for the shard split of D10, never
# a result. A 3.3 record's file lines carry no seconds, and add nothing.
devbox_record_durations() {
  local dir
  local -a files
  dir="$(devbox_record_dir)" || return 1
  [ -d "$dir" ] || return 0
  files=("$dir"/*.record)
  [ -e "${files[0]}" ] || return 0
  # shellcheck disable=SC2016  # an awk program: awk expands its $1, never bash
  RECORD_STEP="$1" awk -F'\t' "$_DEVBOX_RECORD_AWK_HEAD"'
    function begin() { n = 0 }
    $1 == "file" && $2 == ENVIRON["RECORD_STEP"] && $6 ~ /^[0-9]+$/ { n++; p[n] = $4; s[n] = $6 }
    function done() { for (i = 1; i <= n; i++) print p[i] "\t" at "\t" s[i] }' "${files[@]}" \
    | LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2nr \
    | awk -F'\t' '$1 != last { print $1 "\t" $3; last = $1 }'
}

# Print the paths of run $1's file lines for step $2 whose outcome is $3, one
# per line. An empty step names every step.
_devbox_record_files() {
  local run="$1" dir
  (require_run_id "$run" "a record query") || return 2
  dir="$(devbox_record_dir)" || return 1
  [ -r "$dir/$run.record" ] || return 0
  RECORD_STEP="$2" RECORD_OUTCOME="$3" awk -F'\t' '
    $1 == "file" && (ENVIRON["RECORD_STEP"] == "" || $2 == ENVIRON["RECORD_STEP"]) && $5 == ENVIRON["RECORD_OUTCOME"] { print $4 }' \
    "$dir/$run.record"
}

# The failed test files of step $2 in run $1. `devbox result --failed-files`
# with no step passes an empty $2, for the failed files of every step.
devbox_record_failed_files() { _devbox_record_files "$1" "$2" fail; }

# The test files of step $2 in run $1 that were still running when it ended.
devbox_record_open_files() { _devbox_record_files "$1" "$2" open; }

# Print the path of the newest record whose branch is $1, else of the newest
# record. Nothing when the directory holds no record.
devbox_record_newest() {
  local branch="$1" dir best
  local -a files
  dir="$(devbox_record_dir)" || return 1
  [ -d "$dir" ] || return 0
  files=("$dir"/*.record)
  [ -e "${files[0]}" ] || return 0
  best="$(RECORD_BRANCH="$branch" awk -F'\t' "$_DEVBOX_RECORD_AWK_HEAD"'
    function begin() { }
    function done() { print (branch == ENVIRON["RECORD_BRANCH"] ? 1 : 0) "\t" at "\t" file }' "${files[@]}" \
    | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -k2,2nr -k3,3r | awk "$_DEVBOX_RECORD_FIRST")" || return 1
  [ -z "$best" ] || printf '%s\n' "${best#*$'\t'*$'\t'}"
}

# Print the record file $1 for a person: one line per step, `<name> <outcome>
# <seconds>s code <code> <mode>`, then the verdict line of section 3. A failed
# step names its failed test files by count. A partial record never prints
# `green`, and an incomplete one says that it does not carry, and why.
#
# A step that reads `pass` while a test file of it reads `fail` is red too.
# MEASURED: a stopped gate's vitest step failed 2 files, its resume recorded
# the step `pass` beside those two `fail` lines, and the verdict read green.
# The verdict reads the files as well as the step, whatever wrote the record.
devbox_record_summary() {
  awk -F'\t' '
    $1 == "run" { run = $2 }
    $1 == "scope" { scope = $2 }
    $1 == "complete" { complete = $2 }
    $1 == "reason" { reason = $2 }
    $1 == "step" {
      n++; name[n] = $2; outcome[$2] = $4
      printf "%s %s %ss code %s %s\n", $2, $4, $5, $6, $7
      if ($4 == "carried") carried++; else ran++
    }
    $1 == "file" && $5 == "fail" { failed_files[$2]++ }
    END {
      if (complete != "1" && reason != "") { printf "devbox: incomplete (run %s does not carry: %s)\n", run, reason; exit }
      # A gate cancelled before any step ended has no step line either, and
      # its record read "planned no step" for a gate that was running a step.
      if (n == 0 && complete != "1") { printf "devbox: incomplete (run %s ended before any step did, so it does not carry)\n", run; exit }
      if (n == 0) { printf "devbox: empty (run %s planned no step)\n", run; exit }
      red = ""
      for (i = 1; i <= n; i++) {
        s = name[i]
        if (outcome[s] == "fail") {
          part = s " failed"
          if (failed_files[s] > 0) part = part ": " failed_files[s] " files"
        } else if (failed_files[s] > 0) part = s " passed with " failed_files[s] " failed files"
        else continue
        red = red (red == "" ? "" : "; ") part
      }
      counts = n " steps: " (ran + 0) " ran, " (carried + 0) " carried"
      if (complete != "1") printf "devbox: incomplete (run %s does not carry)\n", run
      else if (red != "") printf "devbox: red (%s)\n", red
      else if (scope == "partial") printf "devbox: partial pass (%s; only the named steps ran, so this is not a green gate)\n", counts
      else printf "devbox: green (%s)\n", counts
    }' "$1"
}

# Print the failures line of the record file $1 for a landing script, or
# nothing: `verify: failures {"<step>": {"code": <n>, "attributable": <bool>,
# "failedFiles": ["<path>", ...]}, ...}`, one entry per failed step in record
# order, on one line. devbox verify prints it after a red verdict.
#
# A landing script runs the failed files again on the base branch to tell a
# failure of the branch from one the base already has, so a step is
# attributable only when its failed files name every failure of it. That is the
# rule a narrow trusts (_devbox_plan_narrow, section 6.4): the step failed with
# code 1, the runner's "tests failed" and not a crash, at least one test file
# of it failed, and none was still open when it ended. A step that reads pass
# beside a failed file of its own is red by devbox_record_summary: its code
# here is 1, the code devbox verify exits with, and its files name the failure.
# Any other failed step is `"attributable": false` with no file, so the script
# counts the whole step as unexplained.
#
# A `complete 0` record prints nothing: a cancelled, stopped or killed gate,
# and one whose files changed while it ran, proves nothing about the tree it
# names, and a reader with no line treats the whole gate as unexplained. A
# record with no failed step prints nothing either. The paths are the ledger's,
# relative to the repository root.
devbox_record_failures() {
  LC_ALL=C awk -F'\t' "$_DEVBOX_RECORD_AWK_JSON"'
    $1 == "complete" { complete = $2 }
    $1 == "step" { n++; name[n] = $2; outcome[$2] = $4; code[$2] = num($6) }
    $1 == "file" && $5 == "fail" { files[$2] = files[$2] (nf[$2]++ ? ", " : "") js($4) }
    $1 == "file" && $5 == "open" { open[$2] = 1 }
    END {
      if (complete != "1") exit
      out = ""
      for (i = 1; i <= n; i++) {
        s = name[i]
        failed = (outcome[s] == "fail")
        if (!failed && !(s in files)) continue
        c = code[s]
        if (c == "null" || c == "0") c = "1"
        ok = (s in files) && !(s in open) && (!failed || c == "1")
        out = out (out == "" ? "" : ", ") js(s) ": {\"code\": " c ", \"attributable\": " (ok ? "true" : "false") ", \"failedFiles\": [" (ok ? files[s] : "") "]}"
      }
      if (out != "") print "verify: failures {" out "}"
    }' "$1"
}
