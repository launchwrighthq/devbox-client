#!/bin/bash
# The plan of a gate: each step's key, then carry, narrow, related or run
# (docs/specs/2026-11-14-client-owns-the-gate-design.md, sections 6.2, 6.4 and
# 6.7). Sourced by devbox-verify, after lib/devbox-lib.sh and the parsed steps
# of devbox-steps-file.
# shellcheck shell=bash
#
# Each consumer planned its gate from changed paths with its own global-input
# list, and the copies disagreed. A step's key here is the hash of what it
# reads, so a step whose inputs did not change carries a pass from any complete
# record of the git common dir and runs nothing.
#
# What the caller sets:
#   STEP_NAMES, STEP_INPUTS, STEP_RUNNER, STEP_NARROW, STEP_SELECT, STEP_RERUN,
#   STEP_CMD, STEP_SOURCE, STEP_AFTER   the parsed steps of section 6.7
#   DEVBOX_CONFIG          the path of .devbox/config.env
#   DEVBOX_FORWARD_ENV     the forwarded names, separated by spaces
#   DEVBOX_SHARED_INPUTS   the shared input paths, separated by spaces
#   RERUN_FLAG             `full` or `changed` from --full, --fresh or --changed
#   DEVBOX_RERUN_ENV       DEVBOX_RERUN as the environment held it when the
#                          process started, read before the config parser
#                          sets DEVBOX_RERUN from .devbox/config.env
#   DEVBOX_RERUN_CONFIG    DEVBOX_RERUN as .devbox/config.env sets it

# shellcheck source=client/libexec/devbox-record
declare -F devbox_record_find_pass >/dev/null || source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/devbox-record"

# The client's VERSION, the first part of every key: a new client may run a
# step another way, so its passes start over.
DEVBOX_CLIENT_VERSION_FILE="$(readlink -f "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../..")/VERSION"

# Print `changed` or `full` by D13: the flag, then the environment the run
# started with, then .devbox/config.env, then `changed`. Any other value
# returns 2 with a line that names where it came from, before any target is
# asked.
devbox_rerun_setting() {
  local value=changed origin="the default"
  if [ -n "${RERUN_FLAG:-}" ]; then
    value="$RERUN_FLAG" origin="the command line"
  elif [ -n "${DEVBOX_RERUN_ENV:-}" ]; then
    value="$DEVBOX_RERUN_ENV" origin="the environment"
  elif [ -n "${DEVBOX_RERUN_CONFIG:-}" ]; then
    value="$DEVBOX_RERUN_CONFIG" origin="${DEVBOX_CONFIG:-.devbox/config.env}"
  fi
  case "$value" in
    changed|full) printf '%s\n' "$value" ;;
    *) echo "devbox verify: refusing DEVBOX_RERUN '$value' from $origin: write changed or full" >&2; return 2 ;;
  esac
}

# A test file of the runner $2, for the changed test files that a narrowed
# step adds to its failed files (section 6.4). The client reads no runner
# configuration, so a name rule stands in for it: `test` or `spec` in the path
# covers test_x.py, x_test.py, tests/, x.test.ts and x.spec.ts. The extension
# keeps a changed fixture or snapshot out of the runner's file filters, where
# pytest stops on a path it cannot collect.
devbox_plan_is_test_file() {
  local path="$1" runner="$2"
  case "$path" in *test*|*spec*) ;; *) return 1 ;; esac
  case "$runner" in
    pytest) case "$path" in *.py) return 0 ;; esac ;;
    vitest) case "$path" in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac ;;
  esac
  return 1
}

# The path of one manifest line, as awk reads it: `<sha256>  <path>`, or
# `\<sha256>  <path>` for a name sha256sum escapes, or `link <path> -> <target>`.
_DEVBOX_PLAN_AWK_PATH='
function path_of(l,   p, k) {
  if (substr(l, 1, 5) == "link ") { p = substr(l, 6); k = index(p, " -> "); return k ? substr(p, 1, k - 1) : p }
  if (substr(l, 1, 1) == "\\") return substr(l, 68)
  return substr(l, 67)
}
'

# Print the lines of the manifest $1 whose path matches one of the patterns
# in $2, one per line. A pattern that ends in `/` is that directory and
# everything under it. Any other pattern is a bash pattern in which `*` also
# matches `/`.
_devbox_plan_match() {
  PLAN_PATTERNS="$2" awk "$_DEVBOX_PLAN_AWK_PATH"'
    function q(c) {
      if (c == "\\" || c == "^") return "\\" c
      if (index(".$+(){}|*?[]", c)) return "[" c "]"
      return c
    }
    function glob_re(g,   re, i, j, n, c, cls) {
      re = "^"; n = length(g)
      for (i = 1; i <= n; i++) {
        c = substr(g, i, 1)
        if (c == "*") re = re ".*"
        else if (c == "?") re = re "."
        else if (c == "\\" && i < n) { i++; re = re q(substr(g, i, 1)) }
        else if (c == "[") {
          j = i + 1
          if (substr(g, j, 1) == "!" || substr(g, j, 1) == "^") j++
          if (substr(g, j, 1) == "]") j++
          while (j <= n && substr(g, j, 1) != "]") j++
          if (j > n) { re = re q(c); continue }
          cls = substr(g, i + 1, j - i - 1)
          if (substr(cls, 1, 1) == "!") cls = "^" substr(cls, 2)
          re = re "[" cls "]"; i = j
        }
        else re = re q(c)
      }
      return (substr(g, n, 1) == "/") ? re : re "$"
    }
    BEGIN {
      n = split(ENVIRON["PLAN_PATTERNS"], pats, "\n")
      for (i = 1; i <= n; i++) if (pats[i] != "") res[++m] = glob_re(pats[i])
    }
    { p = path_of($0); for (i = 1; i <= m; i++) if (p ~ res[i]) { print; next } }' "$1"
}

# The manifest lines of step $2's inputs in the manifest $1. Empty inputs are
# every synced file.
_devbox_plan_inputs_of() {
  if [ -z "${STEP_INPUTS[$2]-}" ]; then
    cat -- "$1"
  else
    _devbox_plan_match "$1" "${STEP_INPUTS[$2]}"
  fi
}

# The manifest lines of DEVBOX_SHARED_INPUTS in the manifest $1.
_devbox_plan_shared_of() {
  local -a shared
  read -ra shared <<<"${DEVBOX_SHARED_INPUTS:-}"
  [ "${#shared[@]}" -gt 0 ] || return 0
  _devbox_plan_match "$1" "$(printf '%s\n' "${shared[@]}")"
}

# Compare the manifest lines on stdin of file descriptor $1 (the earlier run)
# with those of $2 (this run). Prints `changed <path>` for a path that is new
# or whose line differs, and `deleted <path>` for a path that is gone.
_devbox_plan_diff() {
  awk "$_DEVBOX_PLAN_AWK_PATH"'
    FILENAME == ARGV[1] { old[path_of($0)] = $0; next }
    { p = path_of($0); seen[p] = 1; if (!(p in old) || old[p] != $0) print "changed " p }
    END { for (p in old) if (!(p in seen)) print "deleted " p }' "$1" "$2"
}

# The forwarded names, each with the sha256 of its value, sorted by name. A
# name crosses to the gate only when the run's environment exports it
# (devbox_forward_name in devbox-config), so a name that is not exported is
# `<name> -`. Only the hash of a value enters a key: a forwarded value may be a
# token, and it reaches sha256sum on stdin from printf, a builtin, so no argv
# and no output ever holds it.
_devbox_plan_forward() {
  local name sum
  local -a names
  read -ra names <<<"${DEVBOX_FORWARD_ENV:-}"
  [ "${#names[@]}" -gt 0 ] || return 0
  while IFS= read -r name; do
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
      echo "devbox verify: refusing '$name' in DEVBOX_FORWARD_ENV: not a variable name" >&2
      return 1
    }
    if [ -n "${!name+x}" ] && [[ "${!name@a}" == *x* ]]; then
      sum="$(printf '%s' "${!name}" | sha256sum)" || return 1
      printf '%s %s\n' "$name" "${sum%% *}"
    else
      printf '%s -\n' "$name"
    fi
  done < <(printf '%s\n' "${names[@]}" | LC_ALL=C sort -u)
}

# Print step $2's key over the manifest $1, in the order of section 6.2. The
# client version, the config and the forwarded hashes come from
# devbox_plan_build, which reads each once.
_devbox_plan_key() {
  local manifest="$1" step="$2" sum
  sum="$(set -o pipefail; {
    printf 'version\n%s\nconfig\n%s\nstep\n%s\nforward\n%s\n' \
      "$_plan_version" "$_plan_config" "${STEP_SOURCE[$step]-}" "$_plan_forward"
    printf 'inputs\n' && _devbox_plan_inputs_of "$manifest" "$step"
    printf 'shared\n' && _devbox_plan_shared_of "$manifest"
  } | sha256sum)" || return 1
  printf '%s\n' "${sum%% *}"
}

# Set _plan_files and _plan_reason when section 6.4 allows step $1 to run its
# failed files only: a narrow=failed step with a runner, whose newest result
# failed with code 1 (the runner's "tests failed", not a crash), with at least
# one failed file and no open one. The files are the failed files that still
# exist, then every test file of the runner that changed since that record.
# That record's manifest is required, because without it the changed test
# files are unknown. Returns 0 to narrow, 1 not to.
_devbox_plan_narrow() {
  local step="$1" manifest="$2" last run outcome code failed f dir changed paths tests="" kept="" nf=0 nt=0
  [ "${STEP_NARROW[$step]-}" = failed ] && [ -n "${STEP_RUNNER[$step]-}" ] || return 1
  last="$(devbox_record_last_of "$step")" || return 1
  [ -n "$last" ] || return 1
  read -r run outcome code <<<"$last"
  [ "$outcome" = fail ] && [ "$code" = 1 ] || return 1
  failed="$(devbox_record_failed_files "$run" "$step")" || return 1
  [ -n "$failed" ] || return 1
  [ -z "$(devbox_record_open_files "$run" "$step")" ] || return 1
  dir="$(devbox_record_dir)" || return 1
  [ -r "$dir/$run.files" ] || return 1
  changed="$(_devbox_plan_diff <(_devbox_plan_inputs_of "$dir/$run.files" "$step") \
    <(_devbox_plan_inputs_of "$manifest" "$step"))" || return 1
  paths="$(awk "$_DEVBOX_PLAN_AWK_PATH"'{ print path_of($0) }' "$manifest")" || return 1
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # A failed file that is gone has nothing to re-run, and vitest given only
    # a filter that matches no file fails with "No test files found".
    grep -Fxq -- "$f" <<<"$paths" || continue
    kept+="$f"$'\n'; nf=$((nf + 1))
  done <<<"$failed"
  while IFS= read -r f; do
    [[ "$f" == "changed "* ]] || continue
    f="${f#changed }"
    devbox_plan_is_test_file "$f" "${STEP_RUNNER[$step]}" || continue
    case $'\n'"$kept" in *$'\n'"$f"$'\n'*) continue ;; esac
    tests+="$f"$'\n'; nt=$((nt + 1))
  done <<<"$changed"
  [ $((nf + nt)) -gt 0 ] || return 1
  _plan_files="$kept$tests"
  _plan_reason="narrowed to $nf failed files"
  [ "$nt" -eq 0 ] || _plan_reason+=" and $nt changed test files"
}

# Set _plan_files and _plan_reason when D14 allows step $1 to run vitest's
# related tests of its changed inputs: select=related, a pass to compare with
# and that pass's manifest, at least one changed input, no deleted input and no
# changed shared input. The key of this run's step over that pass's manifest
# must also be a passed key: then the inputs are the one difference, and a
# change of the config, the client, the step line or a forwarded value runs the
# step in full. Returns 0 to select, 1 not to.
_devbox_plan_related() {
  local step="$1" manifest="$2" run dir changed shared old_key f n=0
  [ "${STEP_SELECT[$step]-}" = related ] || return 1
  run="$(devbox_record_last_pass_of "$step")" || return 1
  [ -n "$run" ] || return 1
  dir="$(devbox_record_dir)" || return 1
  [ -r "$dir/$run.files" ] || return 1
  changed="$(_devbox_plan_diff <(_devbox_plan_inputs_of "$dir/$run.files" "$step") \
    <(_devbox_plan_inputs_of "$manifest" "$step"))" || return 1
  [ -n "$changed" ] || return 1
  ! grep -q '^deleted ' <<<"$changed" || return 1
  shared="$(_devbox_plan_diff <(_devbox_plan_shared_of "$dir/$run.files") <(_devbox_plan_shared_of "$manifest"))" || return 1
  [ -z "$shared" ] || return 1
  old_key="$(_devbox_plan_key "$dir/$run.files" "$step")" || return 1
  [ -n "$(devbox_record_find_pass "$step" "$old_key")" ] || return 1
  _plan_files=""
  while IFS= read -r f; do
    _plan_files+="${f#changed }"$'\n'; n=$((n + 1))
  done <<<"$changed"
  _plan_reason="related to $n changed files"
}

# Set _plan_reason for step $1 that runs in full under DEVBOX_RERUN=changed.
_devbox_plan_run_reason() {
  local step="$1" manifest="$2" last run outcome code dir shared changed
  last="$(devbox_record_last_of "$step")" || return 1
  if [ -n "$last" ]; then
    read -r run outcome code <<<"$last"
    if [ "$outcome" = fail ]; then
      _plan_reason="failed in run $run with code $code"
      return 0
    fi
  fi
  run="$(devbox_record_last_pass_of "$step")" || return 1
  if [ -z "$run" ]; then
    _plan_reason="no earlier pass"
    return 0
  fi
  dir="$(devbox_record_dir)" || return 1
  if [ ! -r "$dir/$run.files" ]; then
    _plan_reason="key changed since run $run"
    return 0
  fi
  shared="$(_devbox_plan_diff <(_devbox_plan_shared_of "$dir/$run.files") <(_devbox_plan_shared_of "$manifest"))" || return 1
  changed="$(_devbox_plan_diff <(_devbox_plan_inputs_of "$dir/$run.files" "$step") \
    <(_devbox_plan_inputs_of "$manifest" "$step"))" || return 1
  if [ -n "$shared" ]; then
    _plan_reason="shared inputs changed: $(grep -c . <<<"$shared") files"
  elif [ -n "$changed" ]; then
    _plan_reason="inputs changed: $(grep -c . <<<"$changed") files"
  else
    _plan_reason="config, client version, step line or forwarded env changed since run $run"
  fi
}

# Print the plan of section 6.7 for the rerun setting $1 (changed or full) over
# the manifest $2 (devbox_sync_manifest's lines): one `step` line per step,
# then the `file` lines. With step names after $2, only those are planned, and
# an `after` name that is not planned is dropped, because that step never runs
# and the runner would wait on it forever.
#
# It also fills PLAN_STEPS, PLAN_ACTION, PLAN_NFILES and PLAN_REASON for
# devbox_plan_print, so call it with its stdout sent to a file, never inside
# $( ), where those variables would end with the subshell.
#
# Returns 2 with a line for a rerun value or a step name it does not know, and
# 1 with a line when a part of a key cannot be read: a key that left out what
# it could not read would carry a pass written under other inputs.
devbox_plan_build() {
  local rerun="$1" manifest="$2" step var action key run after a b64 f
  local _plan_version _plan_config _plan_forward _plan_files _plan_reason
  local -a steps afters step_lines=() file_lines=()
  shift 2
  case "$rerun" in
    changed|full) ;;
    *) echo "devbox verify: refusing DEVBOX_RERUN '$rerun': write changed or full" >&2; return 2 ;;
  esac
  for var in STEP_INPUTS STEP_RUNNER STEP_NARROW STEP_SELECT STEP_RERUN STEP_CMD STEP_SOURCE STEP_AFTER; do
    [[ "$(declare -p "$var" 2>/dev/null)" == "declare -A"* ]] || {
      echo "devbox verify: $var is not loaded, so no plan was made" >&2
      return 1
    }
  done
  if [ "$#" -gt 0 ]; then
    for step in "$@"; do
      [ -n "${STEP_CMD[$step]+x}" ] || { echo "devbox verify: no step named '$step' in this gate" >&2; return 2; }
    done
    steps=("$@")
  else
    steps=("${STEP_NAMES[@]}")
  fi
  [ -r "$manifest" ] || { echo "devbox verify: could not read the file list $manifest, so no plan was made" >&2; return 1; }
  _plan_version="$(cat -- "$DEVBOX_CLIENT_VERSION_FILE")" \
    || { echo "devbox verify: could not read $DEVBOX_CLIENT_VERSION_FILE, so no plan was made" >&2; return 1; }
  _plan_config="$(cat -- "${DEVBOX_CONFIG:?devbox-plan needs DEVBOX_CONFIG}")" \
    || { echo "devbox verify: could not read $DEVBOX_CONFIG, so no plan was made" >&2; return 1; }
  _plan_forward="$(_devbox_plan_forward)" || return 1

  declare -ga PLAN_STEPS=("${steps[@]}")
  declare -gA PLAN_ACTION=() PLAN_NFILES=() PLAN_REASON=()
  for step in "${steps[@]}"; do
    key="$(_devbox_plan_key "$manifest" "$step")" \
      || { echo "devbox verify: could not compute the key of step $step, so no plan was made" >&2; return 1; }
    _plan_files="" _plan_reason=""
    if [ "$rerun" = full ]; then
      action=run _plan_reason="DEVBOX_RERUN=full"
    elif [ "${STEP_RERUN[$step]-}" = always ]; then
      action=run _plan_reason="rerun=always"
    else
      run="$(devbox_record_find_pass "$step" "$key")" \
        || { echo "devbox verify: could not read the records, so no plan was made" >&2; return 1; }
      if [ -n "$run" ]; then
        action=carry _plan_reason="carried from run $run"
      elif _devbox_plan_narrow "$step" "$manifest"; then
        action=narrow
      elif _devbox_plan_related "$step" "$manifest"; then
        action=related
      else
        action=run
        _devbox_plan_run_reason "$step" "$manifest" \
          || { echo "devbox verify: could not read the records, so no plan was made" >&2; return 1; }
      fi
    fi
    after=""
    read -ra afters <<<"${STEP_AFTER[$step]-}"
    for a in "${afters[@]}"; do
      case " ${steps[*]} " in *" $a "*) after+="${after:+,}$a" ;; esac
    done
    b64="$(printf '%s' "${STEP_CMD[$step]}" | base64 | tr -d '\n')" || return 1
    step_lines+=("$(printf 'step\t%s\t%s\t%s\t%s\t%s\t%s' "$step" "$action" "$key" \
      "${STEP_RUNNER[$step]:--}" "${after:--}" "$b64")")
    PLAN_ACTION[$step]="$action" PLAN_REASON[$step]="$_plan_reason" PLAN_NFILES[$step]=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      file_lines+=("$(printf 'file\t%s\t%s' "$step" "$f")")
      PLAN_NFILES[$step]=$((PLAN_NFILES[$step] + 1))
    done <<<"$_plan_files"
  done
  printf '%s\n' "${step_lines[@]}"
  [ "${#file_lines[@]}" -eq 0 ] || printf '%s\n' "${file_lines[@]}"
}

# Print the plan that devbox_plan_build made for a person, for --plan: one line
# per step, `<name>  <action>  <reason>`. The action of a narrow or related step
# carries its file count, as section 3 shows it.
devbox_plan_print() {
  local step action
  for step in "${PLAN_STEPS[@]}"; do
    action="${PLAN_ACTION[$step]}"
    case "$action" in narrow|related) action+=" ${PLAN_NFILES[$step]} files" ;; esac
    printf '%s  %s  %s\n' "$step" "$action" "${PLAN_REASON[$step]}"
  done
}
